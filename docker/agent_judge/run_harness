#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""Dispatch Agent-as-Judge runs to the selected CLI harness."""
import json
import os
import shutil
import subprocess
import sys

OPENCODE_GO_BASE_URL = "https://opencode.ai/zen/go/v1"
OPENCODE_GO_MODEL = "mimo-v2.5-pro"


def _run(args, env=None):
    run_env = env or os.environ.copy()
    if shutil.which(args[0], path=run_env.get("PATH")) is None:
        print(f"{args[0]} CLI is not installed in this Agent-as-Judge image", file=sys.stderr)
        return 127
    return subprocess.run(args, cwd="/workspace", env=run_env).returncode


def _write_codex_config(home, base_url, model):
    os.makedirs(home, exist_ok=True)
    lines = [
        'model_provider = "aj_openai"',
        "",
        "[model_providers.aj_openai]",
        'name = "Agent Judge OpenAI Compatible"',
        "base_url = " + json.dumps(base_url),
        'env_key = "AJ_OPENAI_API_KEY"',
    ]
    if model:
        lines.insert(0, "model = " + json.dumps(model))
    with open(os.path.join(home, "config.toml"), "w", encoding="utf-8") as f:
        f.write("\n".join(lines) + "\n")


def _run_codex(prompt):
    base_url = (os.environ.get("OPENAI_BASE_URL") or "").strip()
    api_key = (os.environ.get("OPENAI_API_KEY") or "").strip()
    model = (os.environ.get("OPENAI_MODEL") or "").strip()
    if not base_url or not api_key:
        print("codex harness requires OPENAI_BASE_URL and OPENAI_API_KEY", file=sys.stderr)
        return 2
    home = "/workspace/.codex"
    _write_codex_config(home, base_url, model)
    env = os.environ.copy()
    env["CODEX_HOME"] = home
    env["AJ_OPENAI_API_KEY"] = api_key
    args = [
        "codex", "exec",
        "--skip-git-repo-check",
        "--dangerously-bypass-approvals-and-sandbox",
        "--cd", "/workspace",
        prompt,
    ]
    return _run(args, env)


def _opencode_config_content(base_url, api_key_env, model_id):
    cfg = {
        "$schema": "https://opencode.ai/config.json",
        "provider": {
            "aj-go": {
                "npm": "@ai-sdk/openai-compatible",
                "name": "OpenCode Go",
                "options": {
                    "baseURL": base_url,
                    "apiKey": "{env:%s}" % api_key_env,
                },
                "models": {
                    model_id: {
                        "name": "OpenCode Go %s" % model_id,
                    },
                },
            },
        },
    }
    return json.dumps(cfg, ensure_ascii=False)


def _run_opencode(prompt):
    api_key = (os.environ.get("OPENCODE_API_KEY") or "").strip()
    if not api_key:
        print("opencode harness requires OPENCODE_API_KEY", file=sys.stderr)
        return 2
    base_url = (os.environ.get("OPENCODE_BASE_URL") or "").strip() or OPENCODE_GO_BASE_URL
    model = (os.environ.get("OPENCODE_MODEL") or "").strip() or OPENCODE_GO_MODEL
    model_id = model.split("/", 1)[1] if model.startswith("opencode-go/") else model
    model_id = model_id.split("/", 1)[1] if model_id.startswith("aj-go/") else model_id
    home = "/tmp/aj_opencode_home"
    env = os.environ.copy()
    env["HOME"] = home
    env["OPENCODE_CONFIG_CONTENT"] = _opencode_config_content(
        base_url, "OPENCODE_API_KEY", model_id,
    )
    env["OPENCODE_API_KEY"] = api_key
    os.makedirs(home, exist_ok=True)
    return _run([
        "opencode", "run",
        "--dangerously-skip-permissions",
        "--model", "aj-go/%s" % model_id,
        prompt,
    ], env)


def _run_claude_code(prompt):
    model = (os.environ.get("ANTHROPIC_MODEL") or "").strip()
    args = ["claude", "-p", prompt, "--dangerously-skip-permissions", "--add-dir", "/workspace"]
    if model:
        args.extend(["--model", model])
    return _run(args)


def main():
    prompt = os.environ.get("AJ_PROMPT") or ""
    harness = (os.environ.get("AJ_HARNESS") or "claude_code").strip().lower().replace("-", "_")
    if harness == "codex":
        return _run_codex(prompt)
    if harness == "opencode":
        return _run_opencode(prompt)
    return _run_claude_code(prompt)


if __name__ == "__main__":
    raise SystemExit(main())
