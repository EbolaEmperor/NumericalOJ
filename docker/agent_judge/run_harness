        web_search_mcp = _web_search_mcp_settings()
    except ValueError as exc:
        print(f"invalid endpoint configuration: {exc}", file=sys.stderr)
        return 2
    skill_files = _validated_skill_files("pi")
    if skill_files is None:
        return 2
    try:
        config_dir = _runtime_path("pi/agent", PI_CONFIG_DIR)
        session_dir = _runtime_path("pi/agent/sessions", PI_SESSION_DIR)
    except ValueError as exc:
        print(f"invalid Agent runtime: {exc}", file=sys.stderr)
        return 2
    relay = None
    provider_base_url = base_url
    if endpoint_thinking_format is not None:
        relay = _EndpointThinkingRelay(
            base_url,
            protocol,
            endpoint_thinking_format,
            thinking_compatibility,
        )
        try:
            provider_base_url = relay.start()
        except Exception as exc:
            print(f"failed to start Pi endpoint relay: {exc}", file=sys.stderr)
            return 2
    try:
        _write_pi_models_config(
            config_dir, provider_base_url, model,
            context_window_tokens=context_window_tokens,
            max_output_tokens=max_output_tokens,
            thinking_compatibility=thinking_compatibility,
            protocol=protocol,
        )
        os.makedirs(session_dir, exist_ok=True)
        env = os.environ.copy()
        env.update({
            "PI_CODING_AGENT_DIR": config_dir,
            "PI_CODING_AGENT_SESSION_DIR": session_dir,
            "PI_OFFLINE": "1",
            "PI_TELEMETRY": "0",
            "PI_SKIP_VERSION_CHECK": "1",
        })
        phase = str(os.environ.get("AJ_PHASE") or "").strip().lower()
        audit_read_only = _audit_read_only_enabled()
        base_args = [
            "pi",
            "--mode", "json",
            "--provider", PI_PROVIDER_NAME,
            "--model", model,
            "--no-approve",
            "--no-extensions",
            "--no-skills",
            "--no-prompt-templates",
            "--no-themes",
            "--no-context-files",
        ]
        if web_search_mcp:
            # Pi 没有原生 MCP 配置；只显式加载镜像内受信任的协议适配扩展，
            # 不扫描工作区或用户目录中的其他 extension。
            base_args.extend(["--extension", PI_WEB_SEARCH_MCP_EXTENSION])
        if skill_files:
            # Pi 在 --no-skills 下仍可以用 --skill 显式加载单个受信任
            # skill，避免扫描镜像内或其他目录的隐式 skill。
            base_args.extend(["--skill", skill_files[0]])
        if audit_read_only:
            # Pi 自身不提供沙箱；质量门禁容器另有只读根文件系统、只读 evidence
            # 挂载与无 capabilities 约束，这里再把内建工具缩到纯读取集合。
            base_args.extend(["--tools", "read,grep,find,ls"])
            resume_session_id = ""
        if thinking_compatibility:
            effort = str(os.environ.get("AJ_EFFORT") or "").strip().lower()
            # Reverse Judge 的收尾轮只负责把已有工作形成交付物；显式关闭
            # thinking。普通 Agent 因输出截断产生的续跑轮在循环内做同样处理。
            if phase == "reverse_finalize":
                base_args.extend(["--thinking", "off"])
            elif effort in PI_THINKING_LEVELS:
                base_args.extend(["--thinking", effort])

        current_prompt = prompt
        current_session_id = resume_session_id
        task_scope = str(os.environ.get("AJ_TASK_SCOPE") or "").strip().lower()
        auto_resume_output_limit = (
            task_scope == PROBLEM_AGENT_TASK_SCOPE
            and not phase
            and not audit_read_only
        )
        continuing_after_output_limit = False
        previous_terminal_state = None
        while True:
            args = list(base_args)
            if continuing_after_output_limit and thinking_compatibility:
                if "--thinking" in args:
                    args[args.index("--thinking") + 1] = "off"
                else:
                    args.extend(["--thinking", "off"])
            if current_session_id:
                args.extend(["--session", current_session_id])
            args.append(current_prompt)
            proc = _run(
                args,
                env=env,
                stdout_session_only=phase in {"reverse_solve", "reverse_finalize"},
            )
            recorded_session_id = _record_session(
                "pi", proc, current_session_id,
            )
            if proc.returncode != 0 or not auto_resume_output_limit:
                return proc.returncode
            if (
                current_session_id
                and recorded_session_id
                and recorded_session_id != current_session_id
            ):
                print("Pi resumed into an unexpected native session", file=sys.stderr)
                return 2
            session_id = current_session_id or recorded_session_id
            terminal_state = _latest_pi_terminal_state(session_dir, session_id)
            if (
                continuing_after_output_limit
                and not _pi_terminal_advanced(
                    previous_terminal_state,
                    terminal_state,
                )
            ):
                print(
                    "Pi output-limit continuation produced no new assistant event",
                    file=sys.stderr,
                )
                return 2
            if not _pi_hit_output_limit(terminal_state):
                return proc.returncode
            if not session_id:
                print("Pi output limit reached without a resumable session", file=sys.stderr)
                return 2
            current_session_id = session_id
            current_prompt = PI_OUTPUT_LIMIT_CONTINUATION_PROMPT
            continuing_after_output_limit = True
            previous_terminal_state = terminal_state
    finally:
        if relay is not None:
            relay.stop()


def _run_claude_code(prompt):
    audit_read_only = _audit_read_only_enabled()
    try:
        resume_session_id = _resume_session_id_from_env("claude_code")
        _protocol, base_url, api_key, model = _endpoint_settings({"anthropic"})
        context_window_tokens, max_output_tokens, thinking_compatibility = (
            _endpoint_model_capabilities()
        )
        endpoint_thinking_format = _endpoint_thinking_format_env()
        web_search_mcp = _web_search_mcp_settings()
    except ValueError as exc:
        print(f"invalid endpoint configuration: {exc}", file=sys.stderr)
        return 2
    skill_files = _validated_skill_files("claude_code")
    if skill_files is None:
        return 2
    try:
        runtime_root = _runtime_root()
    except ValueError as exc:
        print(f"invalid Agent runtime: {exc}", file=sys.stderr)
        return 2
    env = os.environ.copy()
    env["ANTHROPIC_AUTH_TOKEN"] = api_key
    env["ANTHROPIC_API_KEY"] = api_key
    if runtime_root:
        home = os.path.join(runtime_root, "home")
        os.makedirs(home, exist_ok=True)
        env["HOME"] = home
    if web_search_mcp:
        mcp_runtime_root = runtime_root or "/workspace/.aj-mcp-runtime"
        try:
            mcp_config_path = _write_claude_mcp_config(
                mcp_runtime_root,
                web_search_mcp,
            )
        except OSError as exc:
            print(f"failed to write Claude MCP config: {exc}", file=sys.stderr)
            return 2
    else:
        mcp_config_path = ""
    env["CLAUDE_CODE_MAX_CONTEXT_TOKENS"] = str(context_window_tokens)
    env["CLAUDE_CODE_MAX_OUTPUT_TOKENS"] = str(max_output_tokens)
    # Claude Code 自身会把 custom model 的请求静默压到 128K，并在 streaming
    # 降级时再压到 64K。主流式请求由本地 relay 精确改写；不允许静默降级。
    env["CLAUDE_CODE_DISABLE_NONSTREAMING_FALLBACK"] = "1"
    if context_window_tokens >= CLAUDE_AUTO_COMPACT_MIN_TOKENS:
        env["CLAUDE_CODE_AUTO_COMPACT_WINDOW"] = str(context_window_tokens)
        env.pop("DISABLE_COMPACT", None)
    else:
        # 官方 auto-compact 窗口下限为 100K；更小的管理员声明通过
        # MAX_CONTEXT + 关闭 compact 精确生效，不能静默回到模型目录值。
        env["DISABLE_COMPACT"] = "1"
        env.pop("CLAUDE_CODE_AUTO_COMPACT_WINDOW", None)
    if thinking_compatibility:
        env.pop("CLAUDE_CODE_DISABLE_THINKING", None)
        env.pop("DISABLE_INTERLEAVED_THINKING", None)
    else:
        env["CLAUDE_CODE_DISABLE_THINKING"] = "1"
        env["DISABLE_INTERLEAVED_THINKING"] = "1"
    if audit_read_only:
        args = [
            "claude",
            "--bare",
            "--safe-mode",
            "--disable-slash-commands",
            "--no-session-persistence",
            "--tools", "Read,Glob,Grep",
            "--allowed-tools", "Read,Glob,Grep",
            "--add-dir", "/evidence",
            "--output-format", "json",
            "-p",
        ]
        resume_session_id = ""
    else:
        args = [
            "claude",
            "--dangerously-skip-permissions",
            "--add-dir", "/workspace",
            "--output-format", "json",
            "-p",
        ]
    if resume_session_id and not audit_read_only:
        args.extend(["--resume", resume_session_id])
        if (os.environ.get("AJ_FORK_SESSION") or "1").strip().lower() not in {"0", "false", "no", "off"}:
            args.append("--fork-session")
    if mcp_config_path:
        args.extend(["--strict-mcp-config", "--mcp-config", mcp_config_path])
    cli_model = model
    if (
        cli_model
        and context_window_tokens == MAX_CONTEXT_WINDOW_TOKENS
        and not cli_model.endswith("[1m]")
    ):
        # Claude Code 官方 1M 标记适用于任意模型名；它只作用于本地 CLI，
        # localhost relay 会把上游请求中的 model 恢复为管理员配置的原值。
        cli_model += "[1m]"
    if cli_model:
        args.extend(["--model", cli_model])
    # AJ_EFFORT 控制努力级别（low/medium/high/xhigh/max）。Anthropic claude CLI
    # 用此标志联动 thinking token 预算；不设则用 CLI 默认。我们主要在 reverse
    # 阶段把它调到 high/max，避免 AI 在 thinking 中途被 abort 而不输出代码。
    effort = (os.environ.get("AJ_EFFORT") or "").strip().lower()
    if thinking_compatibility and effort in CLAUDE_EFFORT_LEVELS:
        args.extend(["--effort", effort])
    args.append(prompt)
    relay = None
    if endpoint_thinking_format is None:
        relay = _ClaudeEndpointRelay(
            base_url,
            max_output_tokens,
            upstream_model=model,
        )
    else:
        relay = _ClaudeEndpointRelay(
            base_url,
            max_output_tokens,
            endpoint_thinking_format=endpoint_thinking_format,
            thinking_enabled=thinking_compatibility,
            upstream_model=model,
        )
    try:
        env["ANTHROPIC_BASE_URL"] = relay.start()
    except Exception as exc:
        print(f"failed to start Claude endpoint relay: {exc}", file=sys.stderr)
        return 2
    try:
        proc = _run(args, env=env)
        _record_session("claude_code", proc, resume_session_id)
        return proc.returncode
    finally:
        if relay is not None:
            relay.stop()


def main():
    prompt = _prompt_from_env()
    harness = (os.environ.get("AJ_HARNESS") or "claude_code").strip().lower().replace("-", "_")
    if harness == "pi_agent":
        harness = "pi"
    if harness == "codex":
        return _run_codex(prompt)
    if harness == "opencode":
        return _run_opencode(prompt)
    if harness == "pi":
        return _run_pi(prompt)
    return _run_claude_code(prompt)


if __name__ == "__main__":
    raise SystemExit(main())
