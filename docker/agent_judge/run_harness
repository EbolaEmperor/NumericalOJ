def _emit_numoj(payload):
    with _NUMOJ_OUTPUT_LOCK:
        sys.stdout.write(json.dumps(payload, ensure_ascii=False, separators=(",", ":")) + "\n")
        sys.stdout.flush()


def _emit_control(command_id, status, error=""):
    payload = {
        "type": "numoj_control",
        "version": 1,
        "id": str(command_id or ""),
        "status": str(status or ""),
    }
    if error:
        payload["error"] = str(error)
    _emit_numoj(payload)


def _stable_trace_event_id(*values, suffix=""):
    """Return a bounded native identifier suitable for journal deduplication."""

    for value in values:
        text = str(value or "").strip()
        if not text:
            continue
        suffix = str(suffix or "")
        return text[:max(1, _TRACE_EVENT_ID_MAX_CHARS - len(suffix))] + suffix
    return ""


def _emit_trace(
        kind, text, *, title="", meta="", is_error=False, fmt="",
        event_id=""):
    kind = str(kind or "")
    text = str(text or "").strip()
    if not text:
        return
    text_limit = (
        _TRACE_ASSISTANT_MAX_CHARS
        if kind == "assistant" else _TRACE_DETAIL_MAX_CHARS
    )
    if len(text) > text_limit:
        text = text[:max(0, text_limit - 1)] + "…"
    event = {
        "kind": kind,
        "text": text,
    }
    event_id = _stable_trace_event_id(event_id)
    if event_id:
        event["id"] = event_id
    if title:
        event["title"] = str(title)[:_TRACE_METADATA_MAX_CHARS]
    if meta:
        event["meta"] = str(meta)[:_TRACE_METADATA_MAX_CHARS]
    if is_error:
        event["is_error"] = True
    if fmt:
        event["format"] = str(fmt)
    _emit_numoj({"type": "numoj_trace", "version": 1, "event": event})


def _emit_usage(source, usage, record_id=""):
    if not isinstance(usage, dict):
        return
    record_id = str(record_id or "").strip()
    if not record_id:
        # 宿主 journal 要求 usage 有稳定 ID 才能去重。Pi 的失败消息会
        # 附带全零 usage，却未必有 response id；这类记录既不代表一次
        # 可计费响应，也不能安全重放，不应写进 adapter stdout。
        return
    _emit_numoj({
        "type": "numoj_usage",
        "version": 1,
        "source": str(source or ""),
        "id": record_id,
        "usage": usage,
    })


class _NumOJCommandQueue:
    def __init__(self):
        self.items = queue.Queue()
        self.thread = threading.Thread(target=self._read, daemon=True)

    def start(self):
        self.thread.start()

    def _read(self):
        for raw in sys.stdin:
            try:
                command = json.loads(raw)
            except Exception:
                _emit_control("", "rejected", "控制帧不是合法 JSON")
                continue
            if not isinstance(command, dict):
                _emit_control("", "rejected", "控制帧必须是对象")
                continue
            command_id = str(command.get("id") or "").strip()
            command_type = str(command.get("type") or "").strip().lower()
            if not command_id or command_type not in {"steer", "interrupt"}:
                _emit_control(command_id, "rejected", "控制命令缺少 id 或类型无效")
                continue
            if command_type == "steer" and not str(command.get("message") or "").strip():
                _emit_control(command_id, "rejected", "插话消息不能为空")
                continue
            self.items.put(command)

    def drain(self):
        result = []
        while True:
            try:
                result.append(self.items.get_nowait())
            except queue.Empty:
                return result


def _read_numoj_start():
    raw = sys.stdin.readline()
    if not raw:
        _emit_control("__start__", "rejected", "缺少 start 控制帧")
        return None
    try:
        command = json.loads(raw)
    except Exception:
        _emit_control("__start__", "rejected", "start 控制帧不是合法 JSON")
        return None
    if not isinstance(command, dict) or command.get("type") != "start":
        _emit_control(str((command or {}).get("id") or ""), "rejected", "首帧必须是 start")
        return None
    if not str(command.get("message") or "").strip():
        _emit_control(str(command.get("id") or "__start__"), "rejected", "首轮消息不能为空")
        return None
    return command


def _start_json_process(args, env):
    if shutil.which(args[0], path=env.get("PATH")) is None:
        raise RuntimeError(f"{args[0]} CLI is not installed")
    proc = subprocess.Popen(
        args,
        cwd=env.get("AJ_WORKSPACE") or "/workspace",
        env=env,
        stdin=subprocess.PIPE,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        bufsize=1,
    )
    stdout_events = queue.Queue()

    def read_stdout():
        try:
            for line in proc.stdout:
                try:
                    stdout_events.put(json.loads(line))
                except Exception:
                    if line.strip():
                        _emit_trace("tool_result", line, title="Harness 输出", meta=args[0])
        finally:
            stdout_events.put(None)

    def read_stderr():
        for line in proc.stderr:
            sys.stderr.write(line)
            sys.stderr.flush()

    threading.Thread(target=read_stdout, daemon=True).start()
    threading.Thread(target=read_stderr, daemon=True).start()
    return proc, stdout_events


def _write_json(proc, payload):
    proc.stdin.write(json.dumps(payload, ensure_ascii=False, separators=(",", ":")) + "\n")
    proc.stdin.flush()


def _read_first_jsonl_record(path, max_bytes=256 * 1024):
    try:
        with open(path, "rb") as stream:
            raw = stream.readline(max_bytes + 1)
    except OSError:
        return None
    if not raw or len(raw) > max_bytes:
        return None
    try:
        value = json.loads(raw.decode("utf-8", "replace"))
    except (TypeError, ValueError):
        return None
    return value if isinstance(value, dict) else None


def _read_last_jsonl_records(path, max_bytes=1024 * 1024, *, min_offset=0):
    """读取 JSONL 的有限尾部；进行中的最后半行会被自然忽略。"""

    try:
        size = os.path.getsize(path)
        with open(path, "rb") as stream:
            offset = max(0, min_offset, size - max_bytes)
            if offset:
                stream.seek(offset - 1)
                if stream.read(1) != b"\n":
                    stream.readline()
            else:
                stream.seek(0)
            raw_lines = stream.readlines()
    except OSError:
        return []
    records = []
    for raw in raw_lines:
        try:
            value = json.loads(raw.decode("utf-8", "replace"))
        except (TypeError, ValueError):
            continue
        if isinstance(value, dict):
            records.append(value)
    return records


def _claude_subagent_name(transcript_path, agent_id):
    meta_path = os.path.splitext(transcript_path)[0] + ".meta.json"
    try:
        with open(meta_path, encoding="utf-8") as stream:
            metadata = json.load(stream)
    except (OSError, TypeError, ValueError):
        metadata = {}
    if isinstance(metadata, dict):
        description = str(metadata.get("description") or "").strip()
        if description:
            return description[:160]

    first = _read_first_jsonl_record(transcript_path) or {}
    message = first.get("message") if isinstance(first.get("message"), dict) else {}
    content = message.get("content")
    if isinstance(content, list):
        content = "\n".join(
            str(block.get("text") or "")
            for block in content
            if isinstance(block, dict) and block.get("type") == "text"
        )
    for raw_line in str(content or "").splitlines():
        line = re.sub(r"^[#>*\-\s]+", "", raw_line).strip()
        if line:
            return line[:160]
    return f"Subagent {str(agent_id or '')[-8:]}"


def _claude_direct_subagent_completed(transcript_path):
    """直接 Task subagent 的最终一条纯文本 assistant 即为结束。"""

    for record in reversed(_read_last_jsonl_records(transcript_path)):
        if str(record.get("type") or "") != "assistant":
            continue
        message = record.get("message") if isinstance(record.get("message"), dict) else {}
        content = message.get("content")
        if isinstance(content, str):
            return bool(content.strip())
        if not isinstance(content, list) or not content:
            return False
        block_types = {
            str(block.get("type") or "")
            for block in content
            if isinstance(block, dict)
        }
        return bool(block_types) and block_types <= {"text"} and any(
            str(block.get("text") or "").strip()
            for block in content
            if isinstance(block, dict)
        )
    return False


def _claude_subagent_roots(env, session_id):
    normalized_session_id = str(session_id or "").strip()
    if not _CLAUDE_NATIVE_SESSION_ID_RE.fullmatch(normalized_session_id):
        return []
    home_value = str(env.get("HOME") or "").strip()
    if not home_value:
        return []
    home = os.path.abspath(home_value)
    return sorted(glob.glob(os.path.join(
        home,
        ".claude",
        "projects",
        "*",
        normalized_session_id,
        "subagents",
    )))


def _claude_file_version(path):
    try:
        info = os.stat(path)
    except OSError:
        return None
    return (info.st_dev, info.st_ino, info.st_size, info.st_mtime_ns)


def _claude_subagent_baseline(env, session_id):
    """在启动 CLI 前冻结历史文件边界，不能把旧 started 当作存活证明。"""

    baseline = {}
    for root in _claude_subagent_roots(env, session_id):
        for path in glob.glob(os.path.join(root, "**", "*.jsonl"), recursive=True):
            version = _claude_file_version(path)
            if version is not None:
                baseline[path] = version
    return baseline


def _claude_subagent_snapshot(env, session_id, *, baseline=None):
    """仅投影本轮子任务的展示状态；不参与原生会话终止判断。"""

    baseline = baseline or {}
    session_roots = _claude_subagent_roots(env, session_id)
    workflow_status = {}
    workflow_order = []
    for root in sorted(session_roots):
        for journal_path in sorted(glob.glob(os.path.join(
            root, "workflows", "*", "journal.jsonl",
        ))):
            previous = baseline.get(journal_path)
            current = _claude_file_version(journal_path)
            if current is None or current == previous:
                continue
            # 同一文件追加时只看本轮新增记录；替换或截短后从头读取。
            min_offset = (
                previous[2]
                if previous and current[:2] == previous[:2]
                and current[2] > previous[2] else 0
            )
            for record in _read_last_jsonl_records(
                journal_path, max_bytes=4 * 1024 * 1024,
                min_offset=min_offset,
            ):
                agent_id = str(record.get("agentId") or "").strip()
                if not agent_id:
                    continue
                record_type = str(record.get("type") or "").strip().lower()
                if record_type not in {
                    "started", "result", "completed", "failed", "error",
                    "canceled", "cancelled",
                }:
                    continue
                if agent_id not in workflow_status:
                    workflow_order.append(agent_id)
                if record_type == "started":
                    workflow_status[agent_id] = "running"
                elif record_type in {
                    "result", "completed", "failed", "error",
                    "canceled", "cancelled",
                }:
                    workflow_status[agent_id] = "completed"

    transcript_by_id = {}
    for root in sorted(session_roots):
        pattern = os.path.join(root, "**", "agent-*.jsonl")
        for transcript_path in sorted(glob.glob(pattern, recursive=True)):
            if (
                transcript_path in baseline
                and _claude_file_version(transcript_path) == baseline[transcript_path]
            ):
                continue
            filename = os.path.basename(transcript_path)
            agent_id = filename[len("agent-"):-len(".jsonl")]
            if agent_id:
                transcript_by_id.setdefault(agent_id, transcript_path)

    ordered_ids = list(workflow_order)
    ordered_ids.extend(
        agent_id for agent_id in transcript_by_id if agent_id not in workflow_status
    )
    snapshot = []
    for agent_id in ordered_ids:
        transcript_path = transcript_by_id.get(agent_id, "")
        if agent_id in workflow_status:
            status = workflow_status[agent_id]
        else:
            status = (
                "completed"
                if transcript_path
                and _claude_direct_subagent_completed(transcript_path)
                else "running"
            )
        snapshot.append({
            "subagent_id": agent_id[:128],
            "name": (
                _claude_subagent_name(transcript_path, agent_id)
                if transcript_path else f"Subagent {agent_id[-8:]}"
            ),
            "status": status,
        })
    return snapshot


def _emit_claude_subagent_changes(previous, current):
    previous_by_id = {
        str(item.get("subagent_id") or ""): item
        for item in previous or () if isinstance(item, dict)
    }
    for item in current or ():
        if not isinstance(item, dict):
            continue
        agent_id = str(item.get("subagent_id") or "").strip()
        status = str(item.get("status") or "").strip()
        name = str(item.get("name") or "").strip()
        if not agent_id or item == previous_by_id.get(agent_id):
            continue
        name_digest = hashlib.sha256(
            name.encode("utf-8", "replace")
        ).hexdigest()[:12]
        payload = {"schema_version": 1, **item}
        _emit_trace(
            "subagent",
            json.dumps(payload, ensure_ascii=False, separators=(",", ":")),
            title=name,
            meta=_CLAUDE_SUBAGENT_STATUS_META,
            fmt="json",
            event_id=(
                f"claude-subagent:{agent_id}:{status}:{name_digest}"
            ),
        )


def _content_blocks(message):
    if not isinstance(message, dict):
        return []
    content = message.get("content")
    if isinstance(content, str):
        return [{"type": "text", "text": content}]
    return content if isinstance(content, list) else []


def _token_count(value):
    if isinstance(value, bool):
        return 0
    try:
        return max(0, int(value or 0))
    except (TypeError, ValueError):
        return 0


def _joined_text(value):
    if isinstance(value, list):
        return "\n\n".join(str(item) for item in value if str(item or "").strip())
    return str(value or "")


def _provider_error_summary(value):
    """从 CLI 错误中提取适合轨迹和任务状态展示的简短摘要。"""

    text = str(value or "").strip()
    if not text:
        return ""
    match = re.match(
        r"^HTTP\s+(\d{3})\s*:\s*(.*)$",
        text,
        re.IGNORECASE | re.DOTALL,
    )
    if not match:
        return text
    status = match.group(1)
    payload_text = match.group(2).strip()
    try:
        payload = json.loads(payload_text)
    except (TypeError, ValueError):
        return text
    if not isinstance(payload, dict):
        return text
    error = payload.get("error")
    if isinstance(error, dict):
        detail = error.get("message") or error.get("detail")
    elif isinstance(error, str):
        detail = error
    else:
        detail = payload.get("message") or payload.get("detail")
    detail = str(detail or "").strip()
    return f"HTTP {status}：{detail}" if detail else f"HTTP {status}"


def _structured_error_text(value):
    """从各 CLI 的字符串或嵌套错误对象中提取稳定摘要。"""

    if isinstance(value, str):
        return _provider_error_summary(value)
    if not isinstance(value, dict):
        return str(value or "").strip()
    for key in ("message", "detail", "error", "result"):
        candidate = value.get(key)
        if candidate is value:
            continue
        detail = _structured_error_text(candidate)
        if detail:
            return detail
    data = value.get("data")
    if isinstance(data, dict):
        detail = _structured_error_text(data)
        if detail:
            return detail
    return str(value.get("name") or value.get("code") or "").strip()


def _pi_event_failure_detail(event):
    """返回 Pi assistant 失败事件中适合用户查看的错误详情。"""

    if not isinstance(event, dict):
        return ""
    message = event.get("message") if isinstance(event.get("message"), dict) else {}
    if str(message.get("role") or "") != "assistant":
        return ""
    reason = str(message.get("stopReason") or "").strip().lower()
    error_message = str(message.get("errorMessage") or "").strip()
    if reason != "error" and not error_message:
        event_type = str(event.get("type") or "").strip()
        if (
            event_type == "message_end"
            and reason not in {"aborted", "cancelled", "canceled"}
            and not _content_blocks(message)
        ):
            return _EMPTY_ASSISTANT_CONTENT_ERROR
        return ""
    detail = _provider_error_summary(error_message)
    if detail:
        return detail
    raw_reason = str(message.get("rawStopReason") or "").strip()
    return raw_reason or "模型请求异常终止"


def _claude_event_failure_detail(event):
    if not isinstance(event, dict) or event.get("type") != "result":
        return ""
    if not bool(event.get("is_error")):
        return ""
    detail = _structured_error_text(
        event.get("error") or event.get("result") or event.get("message")
    )
    if detail:
        return detail
    subtype = str(event.get("subtype") or "").strip()
    return subtype or "Claude Code 执行失败"


def _stream_terminal_status(source, event):
    """返回上游稳定终态；非终态返回空字符串。"""

    if not isinstance(event, dict):
        return ""
    source = str(source or "").strip().lower()
    typ = str(event.get("type") or event.get("method") or "").strip()
    if source == "claude_code" and typ == "result":
        return "failed" if bool(event.get("is_error")) else "completed"
    if source == "pi" and typ == "agent_settled":
        return "completed"
    return ""


def _pi_event_failure_status(event):
    """记住 Pi 在 agent_settled 前公布的失败或中止原因。"""

    if not isinstance(event, dict):
        return ""
    message = event.get("message") if isinstance(event.get("message"), dict) else {}
    if str(message.get("role") or "") != "assistant":
        return ""
    reason = str(message.get("stopReason") or "").strip().lower()
    if reason in {"aborted", "cancelled", "canceled"}:
        return "interrupted"
    if _pi_event_failure_detail(event):
        return "failed"
    return ""


def _normalize_stream_event(source, event, *, active_turn_id=""):
    """把 Claude Code/Pi 流事件投影到稳定 journal；返回是否到达终态。"""

    if not isinstance(event, dict):
        return False
    source = str(source or "").strip().lower()
    typ = str(event.get("type") or event.get("method") or "").strip()
    if source in {"pi", "claude_code"}:
        message = event.get("message") if isinstance(event.get("message"), dict) else {}
        is_assistant_message = str(message.get("role") or "") == "assistant"
        if source == "claude_code":
            failure_detail = _claude_event_failure_detail(event)
            if failure_detail:
                fallback_id = "claude:error:" + hashlib.sha256(
                    failure_detail.encode("utf-8", "replace")
                ).hexdigest()[:20]
                _emit_trace(
                    "tool_result",
                    failure_detail,
                    title="模型请求失败",
                    meta="claude_code",
                    is_error=True,
                    event_id=_stable_trace_event_id(
                        event.get("id"),
                        event.get("uuid"),
                        event.get("_numoj_usage_record_id"),
                        event.get("session_id"),
                        fallback_id,
                        suffix=":error",
                    ),
                )
        if (
            (typ == "message_end" and is_assistant_message)
            or (typ == "assistant" and (is_assistant_message or source == "claude_code"))
            or (typ == "message" and is_assistant_message)
        ):
            message_id = _stable_trace_event_id(
                message.get("id"), message.get("responseId"),
                event.get("uuid"), event.get("id"),
            )
            if source == "pi":
                failure_detail = _pi_event_failure_detail(event)
                if failure_detail:
                    fallback_id = "pi:error:" + hashlib.sha256(
                        failure_detail.encode("utf-8", "replace")
                    ).hexdigest()[:20]
                    _emit_trace(
                        "tool_result",
                        failure_detail,
                        title="模型请求失败",
                        meta="pi",
                        is_error=True,
                        event_id=_stable_trace_event_id(
                            message_id,
                            message.get("timestamp"),
                            fallback_id,
                            suffix=":error",
                        ),
                    )
            for block_index, block in enumerate(_content_blocks(message)):
                block_type = str(block.get("type") or "")
                block_id = _stable_trace_event_id(
                    block.get("id"),
                    message_id,
                    suffix=f":{block_type or 'block'}:{block_index}",
                )
                if block_type == "text":
                    _emit_trace(
                        "assistant", block.get("text"), meta=source,
                        event_id=block_id,
                    )
                elif block_type in {"thinking", "reasoning"}:
                    _emit_trace(
                        "thinking",
                        block.get("thinking") or block.get("text"),
                        meta=source,
                        event_id=block_id,
                    )
                elif block_type == "tool_use":
                    _emit_trace(
                        "tool",
                        json.dumps(block.get("input") or {}, ensure_ascii=False),
                        title=f"调用 {block.get('name') or '工具'}",
                        meta=block.get("name"),
                        fmt="json",
                        event_id=_stable_trace_event_id(
                            block.get("id"), block_id, suffix=":call",
                        ),
                    )
            usage = message.get("usage") if isinstance(message.get("usage"), dict) else None
            if usage and source == "pi":
                _emit_usage(source, {
                    "input_uncached_tokens": _token_count(usage.get("input_tokens") or usage.get("input")),
                    "input_cached_tokens": _token_count(usage.get("cache_read_input_tokens") or usage.get("cacheRead")),
                    "input_cache_write_tokens": _token_count(usage.get("cache_creation_input_tokens") or usage.get("cacheWrite")),
                    "output_tokens": _token_count(usage.get("output_tokens") or usage.get("output")),
                    "reasoning_output_tokens": _token_count(usage.get("reasoning")),
                }, str(
                    message.get("id") or message.get("responseId")
                    or event.get("uuid") or event.get("id") or ""
                ))
            elif usage and source == "claude_code":
                # Claude 的一个 CLI turn 可能包含多个 assistant/tool 模型
                # 回合。每条 assistant message 的 usage 才是增量；result 上
                # 的 usage 可能是整轮聚合，不能与这些记录重复相加。
                _emit_usage(source, {
                    "input_uncached_tokens": _token_count(
                        usage.get("input_tokens") or usage.get("input")
                    ),
                    "input_cached_tokens": _token_count(
                        usage.get("cache_read_input_tokens")
                        or usage.get("cacheRead")
                    ),
                    "input_cache_write_tokens": _token_count(
                        usage.get("cache_creation_input_tokens")
                        or usage.get("cacheWrite")
                    ),
                    "output_tokens": _token_count(
                        usage.get("output_tokens") or usage.get("output")
                    ),
                    "reasoning_output_tokens": _token_count(
                        usage.get("reasoning")
                    ),
                }, str(
                    message.get("id") or event.get("uuid")
                    or event.get("id") or ""
                ))
        elif typ in {"tool_execution_start", "tool_use"}:
            _emit_trace(
                "tool",
                json.dumps(
                    event.get("args") or event.get("input") or {},
                    ensure_ascii=False,
                ),
                title=f"调用 {event.get('toolName') or event.get('name') or '工具'}",
                meta=event.get("toolName") or event.get("name"),
                fmt="json",
                event_id=_stable_trace_event_id(
                    event.get("toolCallId"), event.get("tool_use_id"),
                    event.get("id"), suffix=":call",
                ),
            )
        elif typ in {"tool_execution_end", "tool_result"}:
            _emit_trace(
                "tool_result",
                event.get("result") or event.get("content") or event.get("output"),
                title="工具结果",
                meta=event.get("toolName") or event.get("name"),
                is_error=bool(event.get("isError")),
                event_id=_stable_trace_event_id(
                    event.get("toolCallId"), event.get("tool_use_id"),
                    event.get("id"), suffix=":result",
                ),
            )
        elif source == "claude_code" and typ == "user":
            # Claude 把工具结果包装在 user role 事件中；它不是 NumOJ 用户
            # 消息 replay，但仍属于工作详情的稳定工具轨迹。
            for block in _content_blocks(message):
                if not isinstance(block, dict) or block.get("type") != "tool_result":
                    continue
                content = block.get("content")
                if not isinstance(content, str):
                    content = json.dumps(content or {}, ensure_ascii=False)
                _emit_trace(
                    "tool_result",
                    content,
                    title="工具结果",
                    meta=block.get("tool_use_id") or "claude_code",
                    is_error=bool(block.get("is_error")),
                    fmt="json" if not isinstance(block.get("content"), str) else "",
                    event_id=_stable_trace_event_id(
                        block.get("tool_use_id"), event.get("uuid"),
                        event.get("id"), suffix=":result",
                    ),
                )
        if source == "pi" and typ == "agent_settled":
            return True
        if source == "claude_code" and typ == "result":
            usage = event.get("usage") if isinstance(event.get("usage"), dict) else None
            if usage and bool(event.get("_numoj_emit_result_usage", True)):
                _emit_usage("claude_code", {
                    "input_uncached_tokens": _token_count(usage.get("input_tokens")),
                    "input_cached_tokens": _token_count(usage.get("cache_read_input_tokens")),
                    "input_cache_write_tokens": _token_count(usage.get("cache_creation_input_tokens")),
                    "output_tokens": _token_count(usage.get("output_tokens")),
                    "reasoning_output_tokens": 0,
                }, str(
                    event.get("id")
                    or event.get("uuid")
                    or event.get("_numoj_usage_record_id")
                    or event.get("session_id")
                    or ""
                ))
            return True
        return False

    return False


def _web_search_mcp_settings():
    url = (os.environ.get("AJ_WEB_SEARCH_MCP_URL") or "").strip()
    authorization = (
        os.environ.get("AJ_WEB_SEARCH_MCP_AUTHORIZATION") or ""
    ).strip()
    if not url and not authorization:
        return None
    if not url or not authorization:
        raise ValueError("Web Search MCP URL and Authorization must be configured together")
    try:
        parsed = urllib.parse.urlsplit(url)
    except ValueError as exc:
        raise ValueError("Web Search MCP URL is invalid") from exc
    if parsed.scheme not in {"http", "https"} or not parsed.netloc:
        raise ValueError("Web Search MCP URL must be an absolute HTTP URL")
    try:
        timeout_seconds = int(
            os.environ.get("AJ_WEB_SEARCH_MCP_TIMEOUT_SECONDS") or 90
        )
    except ValueError as exc:
        raise ValueError("Web Search MCP timeout is invalid") from exc
    timeout_seconds = max(10, min(240, timeout_seconds))
    return {
        "url": url,
        "timeout_seconds": timeout_seconds,
        "timeout_ms": timeout_seconds * 1000,
    }


def _write_claude_mcp_config(runtime_root, settings):
    config_dir = os.path.join(runtime_root, "mcp")
    os.makedirs(config_dir, exist_ok=True)
    config_path = os.path.join(config_dir, "claude-web-search.json")
    config = {
        "mcpServers": {
            WEB_SEARCH_MCP_NAME: {
                "type": "http",
                "url": settings["url"],
                "headers": {
                    "Authorization": "${AJ_WEB_SEARCH_MCP_AUTHORIZATION}",
                },
                "timeout": settings["timeout_ms"],
            },
        },
    }
    with open(config_path, "w", encoding="utf-8") as f:
        json.dump(config, f, ensure_ascii=False)
    return config_path


def _pi_session_header_line(text):
    for raw_line in str(text or "").splitlines(keepends=True):
        try:
            event = json.loads(raw_line.strip())
        except Exception:
            continue
        if not isinstance(event, dict) or event.get("type") != "session":
            continue
        session_id = str(event.get("id") or "").strip()
        if not UUID_RE.fullmatch(session_id):
            continue
        return raw_line if raw_line.endswith(("\n", "\r")) else raw_line + "\n"
    return ""


def _prompt_from_env():
    prompt_file = (os.environ.get("AJ_PROMPT_FILE") or "").strip()
    if prompt_file:
        try:
            with open(prompt_file, "r", encoding="utf-8") as f:
                return f.read()
        except Exception as exc:
            print(f"failed to read AJ_PROMPT_FILE: {exc}", file=sys.stderr)
            return ""
    if _bool_env("AJ_PROMPT_STDIN", False):
        return sys.stdin.read()
    return os.environ.get("AJ_PROMPT") or ""


def _runtime_root():
    raw = (os.environ.get("AJ_RUNTIME_ROOT") or "").strip()
    if not raw:
        return ""
    if not os.path.isabs(raw):
        raise ValueError("AJ_RUNTIME_ROOT must be an absolute path")
    root = os.path.normpath(raw)
    workspace_raw = (os.environ.get("AJ_WORKSPACE") or "").strip()
    if workspace_raw:
        if not os.path.isabs(workspace_raw):
            raise ValueError("AJ_WORKSPACE must be an absolute path")
        workspace = os.path.normpath(workspace_raw)
        if root != workspace and not root.startswith(workspace + os.sep):
            raise ValueError("AJ_RUNTIME_ROOT must stay inside AJ_WORKSPACE")
    return root


def _runtime_path(relative_path, legacy_path):
    root = _runtime_root()
    return os.path.join(root, relative_path) if root else legacy_path


def _enabled_skill_files(harness):
    if not _bool_env("AJ_ENABLE_SKILLS", False):
        return ()
    runtime_root = _runtime_root()
    if not runtime_root:
        raise ValueError("AJ_ENABLE_SKILLS requires AJ_RUNTIME_ROOT")
    relative_roots = {
        "claude_code": os.path.join("home", ".claude", "skills"),
        "pi": os.path.join("pi", "skills"),
    }
    skill_root = os.path.join(runtime_root, relative_roots[harness])
    try:
        names = sorted(os.listdir(skill_root))
    except OSError as exc:
        raise ValueError(f"materialized skill directory is unavailable: {exc}") from exc
    skill_files = []
    canonical_root = os.path.realpath(skill_root)
    for name in names:
        if name in {"", ".", ".."}:
            continue
        skill_dir = os.path.join(skill_root, name)
        skill_file = os.path.join(skill_dir, "SKILL.md")
        if os.path.islink(skill_dir) or os.path.islink(skill_file):
            raise ValueError("materialized skill cannot be a symlink")
        if not os.path.isdir(skill_dir) or not os.path.isfile(skill_file):
            continue
        canonical_file = os.path.realpath(skill_file)
        if not canonical_file.startswith(canonical_root + os.sep):
            raise ValueError("materialized skill escapes its runtime directory")
        skill_files.append(skill_file)
    if len(skill_files) != 1:
        raise ValueError("exactly one materialized skill is required")
    return tuple(skill_files)


def _validated_skill_files(harness):
    try:
        return _enabled_skill_files(harness)
    except ValueError as exc:
        print(f"invalid Agent skill runtime: {exc}", file=sys.stderr)
        return None


def _run(args, env=None, input_text=None, stdout_session_only=False):
    run_env = env or os.environ.copy()
    if shutil.which(args[0], path=run_env.get("PATH")) is None:
        print(f"{args[0]} CLI is not installed in this Agent-as-Judge image", file=sys.stderr)
        return subprocess.CompletedProcess(args, 127, "", "")
    proc = subprocess.Popen(
        args, cwd=run_env.get("AJ_WORKSPACE") or "/workspace", env=run_env,
        stdin=subprocess.PIPE if input_text is not None else None,
        stdout=subprocess.PIPE, stderr=subprocess.PIPE,
        text=True, bufsize=1,
    )
    try:
        capture_limit = max(1024, int(run_env.get("AJ_CAPTURE_MAX_CHARS") or 8 * 1024 * 1024))
    except Exception:
        capture_limit = 8 * 1024 * 1024
    stdout_chunks = deque()
    stderr_chunks = deque()
    captured_sizes = {"stdout": 0, "stderr": 0}
    discovered_session = {"id": ""}
    forwarded_session = {"done": False}

    def _remember(chunks, key, chunk):
        chunks.append(chunk)
        captured_sizes[key] += len(chunk)
        while chunks and captured_sizes[key] > capture_limit:
            overflow = captured_sizes[key] - capture_limit
            if len(chunks[0]) <= overflow:
                captured_sizes[key] -= len(chunks.popleft())
            else:
                chunks[0] = chunks[0][overflow:]
                captured_sizes[key] -= overflow

    def _relay(source, target, chunks, key):
        try:
            for chunk in iter(lambda: source.readline(65536), ""):
                session_header = ""
                if key == "stdout":
                    session_header = _pi_session_header_line(chunk)
                    if not discovered_session["id"]:
                        discovered_session["id"] = (
                            _extract_session_id(session_header or chunk) or ""
                        )
                        if discovered_session["id"]:
                            _record_live_session(
                                discovered_session["id"],
                                env=run_env,
                            )
                _remember(chunks, key, chunk)
                if key == "stdout" and stdout_session_only:
                    if not session_header or forwarded_session["done"]:
                        continue
                    forwarded_session["done"] = True
                    target.write(session_header)
                else:
                    target.write(chunk)
                target.flush()
        finally:
            source.close()

    stdout_thread = threading.Thread(
        target=_relay, args=(proc.stdout, sys.stdout, stdout_chunks, "stdout"), daemon=True,
    )
    stderr_thread = threading.Thread(
        target=_relay, args=(proc.stderr, sys.stderr, stderr_chunks, "stderr"), daemon=True,
    )
    stdout_thread.start()
    stderr_thread.start()
    if input_text is not None:
        try:
            proc.stdin.write(input_text)
            proc.stdin.flush()
        except BrokenPipeError:
            pass
        finally:
            try:
                proc.stdin.close()
            except BrokenPipeError:
                pass
    returncode = proc.wait()
    stdout_thread.join()
    stderr_thread.join()
    completed = subprocess.CompletedProcess(
        args, returncode, "".join(stdout_chunks), "".join(stderr_chunks),
    )
    completed.aj_session_id = discovered_session["id"]
    return completed


def _session_id_from_text(value, harness=None):
    raw = str(value or "")
    match = UUID_RE.search(raw)
    if match:
        return match.group(0)
    return None


def _walk_json_session_id(obj, harness=None):
    if isinstance(obj, dict):
        if (
            str(obj.get("type") or "").strip().lower() == "session"
            and isinstance(obj.get("id"), str)
        ):
            found = _session_id_from_text(obj["id"], harness)
            if found:
                return found
        for key, value in obj.items():
            if key in SESSION_KEYS and isinstance(value, str):
                found = _session_id_from_text(value, harness)
                if found:
                    return found
        for value in obj.values():
            found = _walk_json_session_id(value, harness)
            if found:
                return found
    elif isinstance(obj, list):
        for item in obj:
            found = _walk_json_session_id(item, harness)
            if found:
                return found
    return None


def _extract_session_id(text, harness=None):
    text = text or ""
    candidates = []
    stripped = text.strip()
    if stripped:
        candidates.append(stripped)
        candidates.extend(line.strip() for line in stripped.splitlines() if line.strip())
    for candidate in candidates:
        try:
            found = _walk_json_session_id(json.loads(candidate), harness)
            if found:
                return found
        except Exception:
            pass
    labeled = re.search(
        r"(?:session[_ -]?id|thread[_ -]?id|conversation[_ -]?id)[^0-9a-fA-F]{0,16}("
        + UUID_RE.pattern[2:-2] + r")",
        text,
        re.I,
    )
    if labeled:
        return labeled.group(1)
    return None


def _normalize_session_id(value, harness):
    normalized = str(value or "").strip()
    if not normalized:
        return ""
    if not UUID_RE.fullmatch(normalized):
        raise ValueError("native session id must be a UUID")
    return normalized.lower()


def _resume_session_id_from_env(harness):
    return _normalize_session_id(os.environ.get("AJ_RESUME_SESSION_ID"), harness)


def _write_session_event(state_path, event):
    payload = json.dumps(event, ensure_ascii=False).encode("utf-8")

    destination_mode = None
    try:
        destination_stat = os.stat(state_path, follow_symlinks=False)
    except FileNotFoundError:
        pass
    else:
        if stat.S_ISREG(destination_stat.st_mode):
            destination_mode = stat.S_IMODE(destination_stat.st_mode)

    def write_all(fd, data):
        offset = 0
        while offset < len(data):
            offset += os.write(fd, data[offset:])

    temporary_path = (
        f"{state_path}.tmp.{os.getpid()}.{os.urandom(8).hex()}"
    )
    flags = (
        os.O_WRONLY | os.O_CREAT | os.O_EXCL
        | getattr(os, "O_CLOEXEC", 0)
        | getattr(os, "O_NOFOLLOW", 0)
    )
    fd = os.open(temporary_path, flags, 0o600)
    try:
        write_all(fd, payload)
        # bind mount 两端可能使用不同 UID；调用方预先放开的状态文件在
        # 原子替换后仍须保持原权限。首次创建则继续使用私有的 0600。
        if destination_mode is not None:
            os.fchmod(fd, destination_mode)
    finally:
        os.close(fd)
    try:
        os.replace(temporary_path, state_path)
    finally:
        try:
            os.unlink(temporary_path)
        except FileNotFoundError:
            pass

    history_flags = (
        os.O_WRONLY | os.O_CREAT | os.O_APPEND
        | getattr(os, "O_CLOEXEC", 0)
        | getattr(os, "O_NOFOLLOW", 0)
    )
    history_fd = os.open(state_path + "l", history_flags, 0o600)
    try:
        history_stat = os.fstat(history_fd)
        if not stat.S_ISREG(history_stat.st_mode):
            raise OSError("session history is not a regular file")
        write_all(history_fd, payload + b"\n")
    finally:
        os.close(history_fd)


def _record_live_session(session_id, *, env=None):
    """CLI 一公布原生 ID 就落盘，让外部停止仍可恢复已建立的会话。"""

    runtime_env = env or os.environ
    harness = (runtime_env.get("AJ_HARNESS") or "").strip().lower().replace("-", "_")
    if harness == "pi_agent":
        harness = "pi"
    try:
        normalized_session_id = _normalize_session_id(session_id, harness)
        resume_session_id = _normalize_session_id(
            runtime_env.get("AJ_RESUME_SESSION_ID"),
            harness,
        )
        if not normalized_session_id:
            return
        state_path = (
            runtime_env.get("AJ_SESSION_STATE")
            or "/workspace/.aj_session_state.json"
        )
        event = {
            "harness": harness,
            "phase": runtime_env.get("AJ_PHASE") or "",
            "session_id": normalized_session_id,
            "resume_session_id": resume_session_id or "",
            "returncode": None,
            "running": True,
        }
        if runtime_env.get("AJ_CONTROL_PROTOCOL") == NUMOJ_CONTROL_PROTOCOL:
            event["interactive_supported"] = (
                str(runtime_env.get("AJ_INTERACTIVE_SUPPORTED") or "1") == "1"
            )
            reason = str(runtime_env.get("AJ_INTERACTIVE_UNSUPPORTED_REASON") or "").strip()
            if reason:
                event["interactive_unsupported_reason"] = reason
        _write_session_event(state_path, event)
    except Exception as exc:
        # 状态旁路不能阻塞 stdout drain；正常结束时 _record_session 会重试。
        print(f"failed to persist live AJ session state: {exc}", file=sys.stderr)


def _record_session(harness, proc, resume_session_id=None):
    text = (getattr(proc, "stdout", "") or "") + "\n" + (getattr(proc, "stderr", "") or "")
    try:
        session_id = _normalize_session_id(
            _extract_session_id(text, harness)
            or getattr(proc, "aj_session_id", "")
            or (resume_session_id or ""),
            harness,
        )
        resume_session_id = _normalize_session_id(resume_session_id, harness)
    except ValueError as exc:
        print(f"failed to record AJ session state: {exc}", file=sys.stderr)
        return ""
    if not session_id:
        return ""
    state_path = os.environ.get("AJ_SESSION_STATE") or "/workspace/.aj_session_state.json"
    event = {
        "harness": harness,
        "phase": os.environ.get("AJ_PHASE") or "",
        "session_id": session_id,
        "resume_session_id": resume_session_id or "",
        "returncode": int(getattr(proc, "returncode", 0) or 0),
    }
    if os.environ.get("AJ_CONTROL_PROTOCOL") == NUMOJ_CONTROL_PROTOCOL:
        event["interactive_supported"] = (
            str(os.environ.get("AJ_INTERACTIVE_SUPPORTED") or "1") == "1"
        )
        reason = str(os.environ.get("AJ_INTERACTIVE_UNSUPPORTED_REASON") or "").strip()
        if reason:
            event["interactive_unsupported_reason"] = reason
    try:
        _write_session_event(state_path, event)
    except Exception as exc:
        print(f"failed to write AJ session state: {exc}", file=sys.stderr)
    return session_id


def _rewrite_claude_request_body(
        path, raw_body, max_output_tokens, endpoint_thinking_format=None,
        thinking_enabled=True, upstream_model=None):
    """只改写 Claude Code 主流式 messages 请求，不抬高内部小请求额度。"""
    try:
        payload = json.loads(raw_body.decode("utf-8"))
    except Exception:
        return raw_body
    if not isinstance(payload, dict):
        return raw_body
    normalized_path = str(path or "").split("?", 1)[0].rstrip("/")
    if normalized_path.endswith("/messages") and payload.get("stream") is True:
        payload["max_tokens"] = int(max_output_tokens)
    if normalized_path.endswith("/messages"):
        if upstream_model:
            payload["model"] = str(upstream_model)
        _apply_endpoint_thinking_fields(
            payload,
            protocol="anthropic",
            thinking_format=endpoint_thinking_format,
            thinking_enabled=thinking_enabled,
        )
    return json.dumps(payload, ensure_ascii=False, separators=(",", ":")).encode("utf-8")


def _apply_endpoint_thinking_fields(
        payload, *, protocol, thinking_format, thinking_enabled):
    """按独立端点冻结的格式改写请求；NULL 时完全保持旧请求行为。"""
    if thinking_format is None:
        return
    if thinking_format not in ENDPOINT_THINKING_FORMATS:
        raise ValueError("unsupported endpoint thinking format")
    payload.pop("enable_thinking", None)
    payload.pop("thinking", None)
    if thinking_format == "none" or not thinking_enabled:
        return
    if thinking_format == "enable_thinking":
        if protocol != "openai":
            raise ValueError("enable_thinking is only valid for OpenAI-compatible endpoints")
        payload["enable_thinking"] = True
        return
    if protocol == "anthropic":
        payload["thinking"] = {"type": "adaptive"}
        return
    # 旧副本可能把 thinking_type 与 OpenAI 协议组合；按当前通用协议契约
    # 收敛成 enable_thinking，而不是继续发送厂商私有的 thinking.type。
    payload["enable_thinking"] = True


def _open_endpoint_request(opener, request):
    task_scope = str(os.environ.get("AJ_TASK_SCOPE") or "").strip().lower()
    if task_scope == PROBLEM_AGENT_TASK_SCOPE:
        return opener.open(request)
    return opener.open(request, timeout=300)


def _relay_upstream_url(base_url, request_target):
    """将 relay 请求路径追加到端点，同时保留两侧 query。"""

    base = urllib.parse.urlsplit(str(base_url or "").strip())
    target = urllib.parse.urlsplit(str(request_target or ""))
    base_path = (base.path or "").rstrip("/")
    target_path = "/" + str(target.path or "").lstrip("/")
    if target_path.startswith("/v1/") and base_path.lower().endswith("/v1"):
        target_path = target_path[len("/v1"):]
    query = "&".join(
        part for part in (base.query, target.query) if str(part or "")
    )
    return urllib.parse.urlunsplit((
        base.scheme,
        base.netloc,
        base_path + target_path,
        query,
        "",
    ))


class _EndpointRelay:
    """把 harness 的短期凭据请求转发到管理员配置的上游端点。"""

    _MAX_REQUEST_BYTES = 64 * 1024 * 1024

    class _RejectRedirects(urllib.request.HTTPRedirectHandler):
        """端点凭证只允许发送给管理员配置的原始 origin。"""

        def redirect_request(self, req, fp, code, msg, headers, newurl):
            return None

    def __init__(
            self, base_url, max_output_tokens=DEFAULT_MAX_OUTPUT_TOKENS,
            thinking_compatibility=True, upstream_model=None,
            endpoint_thinking_format=None):
        self.base_url = str(base_url or "").strip()
        self.max_output_tokens = int(max_output_tokens)
        self.thinking_compatibility = bool(thinking_compatibility)
        self.upstream_model = str(upstream_model or "").strip()
        self.endpoint_thinking_format = endpoint_thinking_format
        self.server = None
        self.thread = None

    def _rewrite_request_body(self, _path, body):
        return body

    def start(self):
        relay = self

        class Handler(http.server.BaseHTTPRequestHandler):
            protocol_version = "HTTP/1.0"

            def log_message(self, _format, *_args):
                return

            def do_GET(self):
                self._forward()

            def do_POST(self):
                self._forward()

            def _send_json_error(self, status, message):
                error = json.dumps(
                    {"error": str(message or "upstream request failed")},
                    ensure_ascii=False,
                ).encode("utf-8")
                self.send_response(int(status))
                self.send_header("Content-Type", "application/json")
                self.send_header("Content-Length", str(len(error)))
                self.end_headers()
                self.wfile.write(error)

            def _forward(self):
                try:
                    content_length = int(self.headers.get("Content-Length") or 0)
                except (TypeError, ValueError):
                    content_length = 0
                if content_length < 0 or content_length > relay._MAX_REQUEST_BYTES:
                    self.send_error(413)
                    return
                body = self.rfile.read(content_length) if content_length else b""
                if body:
                    body = relay._rewrite_request_body(self.path, body)
                headers = {
                    key: value
                    for key, value in self.headers.items()
                    if key.lower() not in {
                        "connection", "content-length", "host", "transfer-encoding",
                    }
                }
                request = urllib.request.Request(
                    _relay_upstream_url(relay.base_url, self.path),
                    data=body if self.command != "GET" else None,
                    headers=headers,
                    method=self.command,
                )
                try:
                    opener = urllib.request.build_opener(relay._RejectRedirects())
                    response = _open_endpoint_request(opener, request)
                except urllib.error.HTTPError as exc:
                    if 300 <= int(exc.code) < 400:
                        exc.close()
                        self._send_json_error(502, "upstream redirects are refused")
                        return
                    response = exc
                except Exception as exc:
                    self._send_json_error(502, str(exc))
                    return
                with response:
                    self.send_response(int(response.status))
                    for key, value in response.headers.items():
                        if key.lower() not in {
                            "connection", "content-length", "transfer-encoding",
                        }:
                            self.send_header(key, value)
                    self.end_headers()
                    while True:
                        chunk = response.read(64 * 1024)
                        if not chunk:
                            break
                        self.wfile.write(chunk)
                        self.wfile.flush()

        self.server = http.server.ThreadingHTTPServer(("127.0.0.1", 0), Handler)
        self.server.daemon_threads = True
        self.thread = threading.Thread(target=self.server.serve_forever, daemon=True)
        self.thread.start()
        return f"http://127.0.0.1:{self.server.server_port}"

    def stop(self):
        if self.server is not None:
            self.server.shutdown()
            self.server.server_close()
        if self.thread is not None:
            self.thread.join(timeout=2)


class _ClaudeEndpointRelay(_EndpointRelay):
    """让 Claude Code 的主流式请求精确使用管理员声明的输出上限。"""

    def __init__(
            self, base_url, max_output_tokens, endpoint_thinking_format=None,
            thinking_enabled=True, upstream_model=None):
        super().__init__(
            base_url,
            max_output_tokens=max_output_tokens,
            thinking_compatibility=thinking_enabled,
            upstream_model=upstream_model,
            endpoint_thinking_format=endpoint_thinking_format,
        )

    def _rewrite_request_body(self, path, body):
        return _rewrite_claude_request_body(
            path, body, self.max_output_tokens,
            self.endpoint_thinking_format,
            self.thinking_compatibility,
            self.upstream_model,
        )


class _EndpointThinkingRelay(_EndpointRelay):
    """为任意 harness 注入统一端点契约中的协议级思考字段。"""

    def __init__(self, base_url, protocol, endpoint_thinking_format, thinking_enabled):
        super().__init__(
            base_url,
            max_output_tokens=DEFAULT_MAX_OUTPUT_TOKENS,
            thinking_compatibility=thinking_enabled,
            endpoint_thinking_format=endpoint_thinking_format,
        )
        self.protocol = protocol

    def _rewrite_request_body(self, path, body):
        try:
            payload = json.loads(body.decode("utf-8"))
        except Exception:
            return body
        if not isinstance(payload, dict):
            return body
        normalized_path = str(path or "").split("?", 1)[0].rstrip("/")
        expected_suffix = "/messages" if self.protocol == "anthropic" else "/chat/completions"
        if not normalized_path.endswith(expected_suffix):
            return body
        _apply_endpoint_thinking_fields(
            payload,
            protocol=self.protocol,
            thinking_format=self.endpoint_thinking_format,
            thinking_enabled=self.thinking_compatibility,
        )
        return json.dumps(payload, ensure_ascii=False, separators=(",", ":")).encode("utf-8")


def _audit_read_only_enabled():
    return (os.environ.get("AJ_AUDIT_READ_ONLY") or "").strip().lower() in {
        "1", "true", "yes", "on",
    }


def _endpoint_settings(allowed_protocols):
    """读取 Claude Code/Pi 共用的唯一端点接口。"""

    protocol = (os.environ.get("AJ_ENDPOINT_PROTOCOL") or "").strip().lower()
    base_url = (os.environ.get("AJ_ENDPOINT_BASE_URL") or "").strip()
    api_key = (os.environ.get("AJ_ENDPOINT_API_KEY") or "").strip()
    model = (os.environ.get("AJ_ENDPOINT_MODEL") or "").strip()
    if protocol not in allowed_protocols:
        raise ValueError("endpoint protocol is not supported by the selected harness")
    if not base_url or not api_key or not model:
        raise ValueError("endpoint Base URL, API Key, and model are required")
    return protocol, base_url, api_key, model


def _positive_int_env(name, default):
    raw = str(os.environ.get(name) or "").strip()
    if not raw:
        return default
    try:
        value = int(raw)
    except (TypeError, ValueError):
        raise ValueError(f"{name} must be a positive integer")
    if value <= 0:
        raise ValueError(f"{name} must be a positive integer")
    return value


def _bool_env(name, default):
    raw = str(os.environ.get(name) or "").strip().lower()
    if not raw:
        return bool(default)
    if raw in {"1", "true", "yes", "on"}:
        return True
    if raw in {"0", "false", "no", "off"}:
        return False
    raise ValueError(f"{name} must be a boolean")


def _endpoint_thinking_format_env():
    raw = str(os.environ.get("AJ_ENDPOINT_THINKING_FORMAT") or "").strip().lower()
    if not raw:
        return None
    if raw not in ENDPOINT_THINKING_FORMATS:
        raise ValueError("AJ_ENDPOINT_THINKING_FORMAT has an unsupported value")
    return raw


def _endpoint_model_capabilities():
    context_window_tokens = _positive_int_env(
        "AJ_ENDPOINT_CONTEXT_WINDOW_TOKENS", DEFAULT_CONTEXT_WINDOW_TOKENS,
    )
    max_output_tokens = _positive_int_env(
        "AJ_ENDPOINT_MAX_OUTPUT_TOKENS", DEFAULT_MAX_OUTPUT_TOKENS,
    )
    if max_output_tokens > context_window_tokens:
        raise ValueError(
            "AJ_ENDPOINT_MAX_OUTPUT_TOKENS cannot exceed "
            "AJ_ENDPOINT_CONTEXT_WINDOW_TOKENS"
        )
    return (
        context_window_tokens,
        max_output_tokens,
        _bool_env("AJ_ENDPOINT_THINKING_ENABLED", DEFAULT_THINKING_COMPATIBILITY),
    )


def _write_pi_models_config(
        config_dir, base_url, model, context_window_tokens=None,
        max_output_tokens=None, thinking_compatibility=None,
        protocol="openai"):
    os.makedirs(config_dir, exist_ok=True)
    if context_window_tokens is None:
        context_window_tokens = DEFAULT_CONTEXT_WINDOW_TOKENS
    if max_output_tokens is None:
        max_output_tokens = DEFAULT_MAX_OUTPUT_TOKENS
    if thinking_compatibility is None:
        thinking_compatibility = DEFAULT_THINKING_COMPATIBILITY
    model_config = {
        "id": model,
        "name": model,
        "contextWindow": int(context_window_tokens),
        "maxTokens": int(max_output_tokens),
    }
    if thinking_compatibility:
        model_config.update({
            "reasoning": True,
            "input": ["text"],
        })
    protocol = str(protocol or "openai").strip().lower()
    if protocol not in {"openai", "anthropic"}:
        raise ValueError("unsupported Pi endpoint protocol")
    provider = {
        "baseUrl": base_url,
        "api": (
            "anthropic-messages" if protocol == "anthropic"
            else "openai-completions"
        ),
        "apiKey": "$AJ_ENDPOINT_API_KEY",
        "models": [model_config],
    }
    if protocol == "openai":
        provider.update({
            "authHeader": True,
            "compat": {
                "supportsStore": False,
                "supportsDeveloperRole": False,
                "maxTokensField": "max_tokens",
            },
        })
    config = {
        "providers": {
            PI_PROVIDER_NAME: provider,
        },
    }
    with open(os.path.join(config_dir, "models.json"), "w", encoding="utf-8") as f:
        json.dump(config, f, ensure_ascii=False)


def _run_pi_interactive(base_args, env, prompt, commands, resume_session_id):
    args = list(base_args)
    mode_index = args.index("--mode") + 1
    args[mode_index] = "rpc"
    if resume_session_id:
        args.extend(["--session", resume_session_id])
    proc, events = _start_json_process(args, env)
    pending = {
        "__numoj-state__": "get_state",
        "__start__": "prompt",
    }
    session_id = resume_session_id
    failure_status = ""
    failure_detail = ""
    settled = False
    try:
        # Pi 的普通事件不携带 session ID。RPC get_state 是固定版本公开的
        # 唯一稳定来源，必须在首条 prompt 前读取并立即落盘，才能在外部
        # stop 或宿主崩溃后继续同一个原生会话。
        _write_json(proc, {"type": "get_state", "id": "__numoj-state__"})
        _write_json(proc, {"type": "prompt", "id": "__start__", "message": prompt})
        done = False
        while not done:
            for command in commands.drain():
                command_id = str(command.get("id") or "")
                upstream_type = "prompt" if command.get("type") == "steer" else "abort"
                payload = {"type": upstream_type, "id": command_id}
                if upstream_type == "prompt":
                    payload["message"] = str(command.get("message") or "")
                    payload["streamingBehavior"] = "steer"
                try:
                    _write_json(proc, payload)
                    pending[command_id] = upstream_type
                except (BrokenPipeError, OSError) as exc:
                    _emit_control(command_id, "unknown", str(exc))
            try:
                event = events.get(timeout=0.1)
            except queue.Empty:
                if proc.poll() is not None:
                    raise RuntimeError("Pi RPC 意外退出")
                continue
            if event is None:
                raise RuntimeError("Pi RPC 意外退出")
            discovered_session_id = _walk_json_session_id(event, "pi")
            if discovered_session_id and discovered_session_id != session_id:
                session_id = discovered_session_id
                _record_live_session(session_id, env=env)
            if event.get("type") == "response":
                response_id = str(event.get("id") or "")
                if not response_id:
                    command_name = str(event.get("command") or "")
                    candidates = [
                        command_id for command_id, name in pending.items()
                        if name == command_name
                    ]
                    response_id = candidates[0] if len(candidates) == 1 else ""
                if response_id == "__numoj-state__":
                    pending.pop(response_id, None)
                    if not bool(event.get("success")):
                        raise RuntimeError(
                            str(event.get("error") or "Pi get_state 失败")
                        )
                    data = event.get("data") if isinstance(event.get("data"), dict) else {}
                    discovered = str(data.get("sessionId") or "").strip()
                    if not discovered:
                        raise RuntimeError("Pi get_state 没有返回 session id")
                    if discovered != session_id:
                        session_id = discovered
                        _record_live_session(session_id, env=env)
                    continue
                if response_id in pending:
                    pending_name = pending.pop(response_id, None)
                    success = bool(event.get("success"))
                    _emit_control(
                        response_id,
                        "accepted" if success else "rejected",
                        str(event.get("error") or event.get("message") or "") if not success else "",
                    )
                    if response_id == "__start__" and not success:
                        raise RuntimeError(
                            str(event.get("error") or "Pi 首轮消息被拒绝")
                        )
                    if pending_name == "prompt" and response_id != "__start__":
                        if success:
                            # prompt(streamingBehavior=steer) 在活动时排入安全
                            # 边界、空闲时直接启动；此前看到的 settled 属于旧 run。
                            settled = False
                        elif settled and not any(
                            name in {"prompt", "abort"}
                            for name in pending.values()
                        ):
                            done = True
                    elif pending_name == "abort" and settled:
                        # Pi abort 会先发 agent_settled，再返回 success response。
                        done = not any(
                            name in {"prompt", "abort"}
                            for name in pending.values()
                        )
                    continue
            event_failure_status = _pi_event_failure_status(event)
            failure_status = event_failure_status or failure_status
            event_failure_detail = _pi_event_failure_detail(event)
            failure_detail = event_failure_detail or failure_detail
            terminal = _normalize_stream_event("pi", event)
            if terminal:
                settled = True
                active_pending = any(
                    name in {"prompt", "abort"}
                    for name in pending.values()
                )
                if not active_pending:
                    done = True
        returncode = (
            2 if failure_status == "failed"
            else 130 if failure_status == "interrupted"
            else 0
        )
        if returncode == 2 and failure_detail:
            print(f"模型请求失败：{failure_detail}", file=sys.stderr)
    except Exception as exc:
        if "__start__" in pending:
            _emit_control("__start__", "rejected", str(exc))
            pending.pop("__start__", None)
        print(f"Pi interactive adapter failed: {exc}", file=sys.stderr)
        returncode = 2
    finally:
        for command_id in pending:
            if command_id == "__numoj-state__":
                continue
            _emit_control(command_id, "unknown", "Pi 已结束但未返回控制回执")
        try:
            proc.stdin.close()
        except Exception:
            pass
        try:
            proc.terminate()
            proc.wait(timeout=5)
        except Exception:
            try:
                proc.kill()
            except Exception:
                pass
    completed = subprocess.CompletedProcess(args, returncode, "", "")
    completed.aj_session_id = session_id
    return completed


def _run_pi(prompt, commands=None):
    try:
        resume_session_id = _resume_session_id_from_env("pi")
        protocol, base_url, api_key, model = _endpoint_settings(
            {"openai", "anthropic"},
        )
        context_window_tokens, max_output_tokens, thinking_compatibility = (
            _endpoint_model_capabilities()
        )
        endpoint_thinking_format = _endpoint_thinking_format_env()
        web_search_mcp = _web_search_mcp_settings()
    except ValueError as exc:
        print(f"invalid endpoint configuration: {exc}", file=sys.stderr)
        return 2
    skill_files = _validated_skill_files("pi")
    if skill_files is None:
        return 2
    try:
        config_dir = _runtime_path("pi/agent", PI_CONFIG_DIR)
        session_dir = _runtime_path("pi/agent/sessions", PI_SESSION_DIR)
    except ValueError as exc:
        print(f"invalid Agent runtime: {exc}", file=sys.stderr)
        return 2
    relay = None
    provider_base_url = base_url
    if endpoint_thinking_format is not None:
        relay = _EndpointThinkingRelay(
            base_url,
            protocol,
            endpoint_thinking_format,
            thinking_compatibility,
        )
        try:
            provider_base_url = relay.start()
        except Exception as exc:
            print(f"failed to start Pi endpoint relay: {exc}", file=sys.stderr)
            return 2
    try:
        _write_pi_models_config(
            config_dir, provider_base_url, model,
            context_window_tokens=context_window_tokens,
            max_output_tokens=max_output_tokens,
            thinking_compatibility=thinking_compatibility,
            protocol=protocol,
        )
        os.makedirs(session_dir, exist_ok=True)
        env = os.environ.copy()
        env.update({
            "PI_CODING_AGENT_DIR": config_dir,
            "PI_CODING_AGENT_SESSION_DIR": session_dir,
            "PI_OFFLINE": "1",
            "PI_TELEMETRY": "0",
            "PI_SKIP_VERSION_CHECK": "1",
        })
        phase = str(os.environ.get("AJ_PHASE") or "").strip().lower()
        audit_read_only = _audit_read_only_enabled()
        base_args = [
            "pi",
            "--mode", "json",
            "--provider", PI_PROVIDER_NAME,
            "--model", model,
            "--no-approve",
            "--no-extensions",
            "--no-skills",
            "--no-prompt-templates",
            "--no-themes",
        ]
        if web_search_mcp:
            # Pi 没有原生 MCP 配置；只显式加载镜像内受信任的协议适配扩展，
            # 不扫描工作区或用户目录中的其他 extension。
            base_args.extend(["--extension", PI_WEB_SEARCH_MCP_EXTENSION])
        if skill_files:
            # Pi 在 --no-skills 下仍可以用 --skill 显式加载单个受信任
            # skill，避免扫描镜像内或其他目录的隐式 skill。
            base_args.extend(["--skill", skill_files[0]])
        if audit_read_only:
            # Pi 自身不提供沙箱；质量门禁容器另有只读根文件系统、只读 evidence
            # 挂载与无 capabilities 约束，这里再把内建工具缩到纯读取集合。
            base_args.extend(["--tools", "read,grep,find,ls"])
            resume_session_id = ""
        if thinking_compatibility:
            effort = str(os.environ.get("AJ_EFFORT") or "").strip().lower()
            # Reverse Judge 的收尾轮只负责把已有工作形成交付物，显式关闭
            # thinking；普通 Agent 完全遵循本轮原生 CLI 的终止结果。
            if phase == "reverse_finalize":
                base_args.extend(["--thinking", "off"])
            elif effort in PI_THINKING_LEVELS:
                base_args.extend(["--thinking", effort])

        if commands is not None:
            if audit_read_only:
                _emit_control("__start__", "rejected", "只读审计模式不支持交互控制")
                return 2
            proc = _run_pi_interactive(
                base_args, env, prompt, commands, resume_session_id,
            )
            _record_session("pi", proc, resume_session_id)
            return proc.returncode

        args = list(base_args)
        if resume_session_id:
            args.extend(["--session", resume_session_id])
        args.append(prompt)
        proc = _run(
            args,
            env=env,
            stdout_session_only=phase in {"reverse_solve", "reverse_finalize"},
        )
        _record_session("pi", proc, resume_session_id)
        return proc.returncode
    finally:
        if relay is not None:
            relay.stop()


def _stable_control_uuid(command_id, task_id=""):
    digest = hashlib.sha256(
        f"{str(task_id or '').strip()}:{str(command_id or '')}".encode(
            "utf-8", "replace",
        )
    ).hexdigest()[:32]
    return f"{digest[:8]}-{digest[8:12]}-{digest[12:16]}-{digest[16:20]}-{digest[20:]}"


def _claude_user_frame(message, command_id, task_id=""):
    return {
        "type": "user",
        "uuid": _stable_control_uuid(command_id, task_id),
        "message": {
            "role": "user",
            "content": [{"type": "text", "text": str(message or "")}],
        },
        "parent_tool_use_id": None,
        # SDK 协议层的通道 ID，与需要落盘的 Claude 原生
        # session_id 无关；顶层单会话始终使用 default。
        "session_id": "default",
    }


def _claude_replayed_user_uuid(event):
    if (
        not isinstance(event, dict)
        or event.get("type") != "user"
        or not bool(event.get("isReplay"))
    ):
        return ""
    return str(event.get("uuid") or "").strip()


def _run_claude_interactive(args, env, prompt, commands, resume_session_id):
    stream_args = list(args)
    output_index = stream_args.index("--output-format") + 1
    stream_args[output_index] = "stream-json"
    stream_args.extend([
        "--input-format", "stream-json",
        "--replay-user-messages",
        "--verbose",
    ])
    subagent_baseline = _claude_subagent_baseline(env, resume_session_id)
    # 2.1.205 默认在等待后台任务时也会报告前台 idle；让 CLI 自身将后台
    # 循环计入 running，再订阅其原生轮次结束通知，保留双向控制通道。
    process_env = dict(
        env,
        CLAUDE_CODE_EMIT_SESSION_STATE_EVENTS="1",
        CLAUDE_CODE_BG_TASKS_REPORT_RUNNING="1",
    )
    proc, events = _start_json_process(stream_args, process_env)
    task_id = str(env.get("AJ_TASK_ID") or "").strip()
    start_uuid = _stable_control_uuid("__start__", task_id)
    waiting_user_acks = {start_uuid: "__start__"}
    pending_interrupts = {}
    result_waiting_for_replay = False
    interrupt_accepted = False
    result_sequence = 0
    assistant_usage_since_result = False
    terminal_waiting_for_control = False
    terminal_failed_while_waiting = False
    control_drain_deadline = None
    failure_detail = ""
    session_id = resume_session_id or ""
    subagents = []
    last_subagent_scan_at = 0.0

    def refresh_subagents(*, force=False):
        nonlocal subagents, last_subagent_scan_at
        now = time.monotonic()
        if (
            not force
            and now - last_subagent_scan_at
            < _CLAUDE_SUBAGENT_SCAN_INTERVAL_SECONDS
        ):
            return
        last_subagent_scan_at = now
        current = _claude_subagent_snapshot(
            env, session_id, baseline=subagent_baseline,
        )
        _emit_claude_subagent_changes(subagents, current)
        subagents = current

    try:
        _write_json(proc, _claude_user_frame(prompt, "__start__", task_id))
        done = False
        terminal_status = ""
        while not done:
            refresh_subagents()
            if (
                control_drain_deadline is not None
                and time.monotonic() >= control_drain_deadline
            ):
                done = True
                continue
            pending_commands = (
                [] if terminal_waiting_for_control else commands.drain()
            )
            for command in pending_commands:
                command_id = str(command.get("id") or "")
                try:
                    if command.get("type") == "steer":
                        frame_uuid = _stable_control_uuid(command_id, task_id)
                        _write_json(
                            proc,
                            _claude_user_frame(
                                command.get("message"), command_id, task_id,
                            ),
                        )
                        waiting_user_acks[frame_uuid] = command_id
                    else:
                        request_id = "numoj-" + command_id
                        _write_json(proc, {
                            "type": "control_request",
                            "request_id": request_id,
                            "request": {"subtype": "interrupt"},
                        })
                        pending_interrupts[request_id] = command_id
                except (BrokenPipeError, OSError) as exc:
                    _emit_control(command_id, "unknown", str(exc))
            try:
                timeout = 0.1
                if control_drain_deadline is not None:
                    timeout = max(
                        0.001,
                        min(timeout, control_drain_deadline - time.monotonic()),
                    )
                event = events.get(timeout=timeout)
            except queue.Empty:
                if control_drain_deadline is not None:
                    continue
                if proc.poll() is not None:
                    raise RuntimeError("Claude Code stream-json 意外退出")
                continue
            if event is None:
                if terminal_waiting_for_control or terminal_status == "failed":
                    done = True
                    continue
                raise RuntimeError("Claude Code stream-json 意外退出（未收到原生 idle）")
            observed_session_id = _walk_json_session_id(event, "claude_code")
            if observed_session_id:
                session_id = observed_session_id
                _record_live_session(session_id, env=env)
            event_type = str(event.get("type") or "")
            message = (
                event.get("message")
                if isinstance(event.get("message"), dict) else {}
            )
            if (
                event_type == "assistant"
                and isinstance(message.get("usage"), dict)
            ):
                assistant_usage_since_result = True
            if event_type == "result":
                result_sequence += 1
                event = dict(event)
                native_result_id = str(
                    event.get("id") or event.get("uuid") or ""
                ).strip()
                event["_numoj_usage_record_id"] = (
                    native_result_id
                    or f"{session_id or resume_session_id or 'claude'}:result:{result_sequence}"
                )
                event["_numoj_emit_result_usage"] = not assistant_usage_since_result
            event_failure_detail = _claude_event_failure_detail(event)
            failure_detail = event_failure_detail or failure_detail
            replayed_uuid = _claude_replayed_user_uuid(event)
            if replayed_uuid and replayed_uuid in waiting_user_acks:
                command_id = waiting_user_acks.pop(replayed_uuid)
                _emit_control(command_id, "accepted")
                if command_id != "__start__":
                    if terminal_failed_while_waiting:
                        pass
                    elif result_waiting_for_replay:
                        result_waiting_for_replay = False
                        terminal_waiting_for_control = False
                        control_drain_deadline = None
            elif (
                event_type == "system"
                and start_uuid in waiting_user_acks
            ):
                # init 只会在 CLI 已解析首条 streaming input 后出现。
                command_id = waiting_user_acks.pop(start_uuid)
                _emit_control(command_id, "accepted")
            elif event_type == "control_response":
                response = event.get("response") if isinstance(event.get("response"), dict) else event
                request_id = str(response.get("request_id") or event.get("request_id") or "")
                command_id = pending_interrupts.pop(request_id, "")
                if command_id:
                    subtype = str(response.get("subtype") or "").lower()
                    rejected = subtype in {"error", "failure", "rejected"}
                    if not rejected:
                        interrupt_accepted = True
                        terminal_status = "interrupted"
                    _emit_control(
                        command_id,
                        "rejected" if rejected else "accepted",
                        str(response.get("error") or "") if rejected else "",
                    )
            pending_followup_ack = any(
                command_id != "__start__"
                for command_id in waiting_user_acks.values()
            )
            if (
                terminal_waiting_for_control
                and not pending_followup_ack
                and not pending_interrupts
                and not result_waiting_for_replay
            ):
                done = True
                continue
            current_terminal = _stream_terminal_status("claude_code", event)
            if current_terminal and interrupt_accepted:
                current_terminal = "interrupted"
            terminal_status = current_terminal or terminal_status
            normalized_done = _normalize_stream_event("claude_code", event)
            if normalized_done:
                assistant_usage_since_result = False
                terminal_failed_while_waiting = current_terminal == "failed"
                refresh_subagents(force=True)
            native_idle = (
                event_type == "system"
                and event.get("subtype") == "session_state_changed"
                and event.get("state") == "idle"
            )
            # result 可能只结束父模型的一次调用；原生 idle 才表示后台循环也已
            # 退出。启动阶段的 idle 没有对应 result，不能吞掉首条用户消息。
            if native_idle and result_sequence:
                pending_followup_ack = any(
                    command_id != "__start__"
                    for command_id in waiting_user_acks.values()
                )
                if terminal_failed_while_waiting:
                    if pending_followup_ack or pending_interrupts:
                        terminal_waiting_for_control = True
                        control_drain_deadline = (
                            time.monotonic() + CONTROL_ACK_DRAIN_SECONDS
                        )
                    else:
                        done = True
                elif pending_followup_ack:
                    result_waiting_for_replay = True
                    terminal_waiting_for_control = True
                    control_drain_deadline = (
                        time.monotonic() + CONTROL_ACK_DRAIN_SECONDS
                    )
                elif pending_interrupts:
                    terminal_waiting_for_control = True
                    control_drain_deadline = (
                        time.monotonic() + CONTROL_ACK_DRAIN_SECONDS
                    )
                else:
                    done = True
        returncode = (
            2 if terminal_status == "failed"
            else 130 if terminal_status == "interrupted"
            else 0
        )
        if returncode == 2:
            print(
                f"模型请求失败：{failure_detail or 'Claude Code 执行失败'}",
                file=sys.stderr,
            )
    except Exception as exc:
        if start_uuid in waiting_user_acks:
            waiting_user_acks.pop(start_uuid, None)
            _emit_control("__start__", "rejected", str(exc))
        print(f"Claude interactive adapter failed: {exc}", file=sys.stderr)
        returncode = 2
    finally:
        for command_id in waiting_user_acks.values():
            _emit_control(command_id, "unknown", "Claude Code 已结束但未回放用户消息")
        for command_id in pending_interrupts.values():
            _emit_control(command_id, "unknown", "Claude Code 已结束但未返回 interrupt 回执")
        try:
            proc.stdin.close()
        except Exception:
            pass
        try:
            proc.wait(timeout=5)
        except Exception:
            try:
                proc.kill()
            except Exception:
                pass
    completed = subprocess.CompletedProcess(stream_args, returncode, "", "")
    completed.aj_session_id = locals().get("session_id", "") or resume_session_id
    return completed


def _run_claude_code(prompt, commands=None):
    audit_read_only = _audit_read_only_enabled()
    try:
        resume_session_id = _resume_session_id_from_env("claude_code")
        _protocol, base_url, api_key, model = _endpoint_settings({"anthropic"})
        context_window_tokens, max_output_tokens, thinking_compatibility = (
            _endpoint_model_capabilities()
        )
        endpoint_thinking_format = _endpoint_thinking_format_env()
        web_search_mcp = _web_search_mcp_settings()
    except ValueError as exc:
        print(f"invalid endpoint configuration: {exc}", file=sys.stderr)
        return 2
    skill_files = _validated_skill_files("claude_code")
    if skill_files is None:
        return 2
    try:
        runtime_root = _runtime_root()
    except ValueError as exc:
        print(f"invalid Agent runtime: {exc}", file=sys.stderr)
        return 2
    env = os.environ.copy()
    env["ANTHROPIC_AUTH_TOKEN"] = api_key
    env["ANTHROPIC_API_KEY"] = api_key
    if runtime_root:
        home = os.path.join(runtime_root, "home")
        os.makedirs(home, exist_ok=True)
        env["HOME"] = home
    if web_search_mcp:
        mcp_runtime_root = runtime_root or "/workspace/.aj-mcp-runtime"
        try:
            mcp_config_path = _write_claude_mcp_config(
                mcp_runtime_root,
                web_search_mcp,
            )
        except OSError as exc:
            print(f"failed to write Claude MCP config: {exc}", file=sys.stderr)
            return 2
    else:
        mcp_config_path = ""
    env["CLAUDE_CODE_MAX_CONTEXT_TOKENS"] = str(context_window_tokens)
    env["CLAUDE_CODE_MAX_OUTPUT_TOKENS"] = str(max_output_tokens)
    # Claude Code 自身会把 custom model 的请求静默压到 128K，并在 streaming
    # 降级时再压到 64K。主流式请求由本地 relay 精确改写；不允许静默降级。
    env["CLAUDE_CODE_DISABLE_NONSTREAMING_FALLBACK"] = "1"
    if context_window_tokens >= CLAUDE_AUTO_COMPACT_MIN_TOKENS:
        env["CLAUDE_CODE_AUTO_COMPACT_WINDOW"] = str(context_window_tokens)
        env.pop("DISABLE_COMPACT", None)
    else:
        # 官方 auto-compact 窗口下限为 100K；更小的管理员声明通过
        # MAX_CONTEXT + 关闭 compact 精确生效，不能静默回到模型目录值。
        env["DISABLE_COMPACT"] = "1"
        env.pop("CLAUDE_CODE_AUTO_COMPACT_WINDOW", None)
    if thinking_compatibility:
        env.pop("CLAUDE_CODE_DISABLE_THINKING", None)
        env.pop("DISABLE_INTERLEAVED_THINKING", None)
    else:
        env["CLAUDE_CODE_DISABLE_THINKING"] = "1"
        env["DISABLE_INTERLEAVED_THINKING"] = "1"
    if audit_read_only:
        args = [
            "claude",
            "--bare",
            "--safe-mode",
            "--disable-slash-commands",
            "--no-session-persistence",
            "--tools", "Read,Glob,Grep",
            "--allowed-tools", "Read,Glob,Grep",
            "--add-dir", "/evidence",
            "--output-format", "json",
            "-p",
        ]
        resume_session_id = ""
    else:
        args = [
            "claude",
            "--dangerously-skip-permissions",
            "--add-dir", "/workspace",
            "--output-format", "json",
            "-p",
        ]
    if resume_session_id and not audit_read_only:
        args.extend(["--resume", resume_session_id])
        if (os.environ.get("AJ_FORK_SESSION") or "1").strip().lower() not in {"0", "false", "no", "off"}:
            args.append("--fork-session")
    if mcp_config_path:
        args.extend(["--strict-mcp-config", "--mcp-config", mcp_config_path])
    cli_model = model
    if (
        cli_model
        and context_window_tokens == CLAUDE_ONE_MILLION_CONTEXT_WINDOW_TOKENS
        and not cli_model.endswith("[1m]")
    ):
        # Claude Code 官方 1M 标记适用于任意模型名；它只作用于本地 CLI，
        # localhost relay 会把上游请求中的 model 恢复为管理员配置的原值。
        cli_model += "[1m]"
    if cli_model:
        args.extend(["--model", cli_model])
    # AJ_EFFORT 控制努力级别（low/medium/high/xhigh/max）。Anthropic claude CLI
    # 用此标志联动 thinking token 预算；不设则用 CLI 默认。我们主要在 reverse
    # 阶段把它调到 high/max，避免 AI 在 thinking 中途被 abort 而不输出代码。
    effort = (os.environ.get("AJ_EFFORT") or "").strip().lower()
    if thinking_compatibility and effort in CLAUDE_EFFORT_LEVELS:
        args.extend(["--effort", effort])
    if commands is None:
        args.append(prompt)
    relay = None
    if endpoint_thinking_format is None:
        relay = _ClaudeEndpointRelay(
            base_url,
            max_output_tokens,
            upstream_model=model,
        )
    else:
        relay = _ClaudeEndpointRelay(
            base_url,
            max_output_tokens,
            endpoint_thinking_format=endpoint_thinking_format,
            thinking_enabled=thinking_compatibility,
            upstream_model=model,
        )
    try:
        env["ANTHROPIC_BASE_URL"] = relay.start()
    except Exception as exc:
        print(f"failed to start Claude endpoint relay: {exc}", file=sys.stderr)
        return 2
    try:
        if commands is not None:
            if audit_read_only:
                _emit_control("__start__", "rejected", "只读审计模式不支持交互控制")
                return 2
            proc = _run_claude_interactive(
                args, env, prompt, commands, resume_session_id,
            )
            _record_session("claude_code", proc, resume_session_id)
            return proc.returncode
        proc = _run(args, env=env)
        _record_session("claude_code", proc, resume_session_id)
        return proc.returncode
    finally:
        if relay is not None:
            relay.stop()


def main():
    harness = (os.environ.get("AJ_HARNESS") or "claude_code").strip().lower().replace("-", "_")
    if harness == "pi_agent":
        harness = "pi"
    commands = None
    if (os.environ.get("AJ_CONTROL_PROTOCOL") or "").strip() == NUMOJ_CONTROL_PROTOCOL:
        start = _read_numoj_start()
        if start is None:
            return 2
        prompt = str(start.get("message") or "")
        task_id = str(start.get("target_task_id") or "").strip()
        if task_id:
            os.environ["AJ_TASK_ID"] = task_id
        commands = _NumOJCommandQueue()
        commands.start()
        os.environ["AJ_INTERACTIVE_SUPPORTED"] = "1"
        os.environ.pop("AJ_INTERACTIVE_UNSUPPORTED_REASON", None)
    else:
        prompt = _prompt_from_env()
    if harness not in {"claude_code", "pi"}:
        print(f"unsupported Agent harness: {harness}", file=sys.stderr)
        return 2
    if commands is None:
        if harness == "pi":
            return _run_pi(prompt)
        return _run_claude_code(prompt)
    if harness == "pi":
        return _run_pi(prompt, commands)
    return _run_claude_code(prompt, commands)


if __name__ == "__main__":
    raise SystemExit(main())
