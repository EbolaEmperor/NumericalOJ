        }
    return json.dumps(cfg, ensure_ascii=False)


def _free_loopback_port():
    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as listener:
        listener.bind(("127.0.0.1", 0))
        return int(listener.getsockname()[1])


def _http_request(base_url, path, *, method="GET", payload=None, timeout=30):
    data = None
    headers = {"x-opencode-directory": "/workspace"}
    if payload is not None:
        data = json.dumps(payload, ensure_ascii=False).encode("utf-8")
        headers["content-type"] = "application/json"
    request = urllib.request.Request(
        base_url + path,
        data=data,
        headers=headers,
        method=method,
    )
    with urllib.request.urlopen(request, timeout=timeout) as response:
        raw = response.read()
        if not raw:
            return None
        return json.loads(raw.decode("utf-8"))


def _wait_opencode_server(base_url, proc):
    deadline = time.monotonic() + 20
    while time.monotonic() < deadline:
        if proc.poll() is not None:
            raise RuntimeError("OpenCode serve 启动失败")
        try:
            _http_request(base_url, "/session?limit=1", timeout=1)
            return
        except Exception:
            time.sleep(0.1)
    raise RuntimeError("OpenCode serve 就绪超时")


def _opencode_message_id(command_id, task_id=""):
    # V1 loop 仍通过 ``lastUser.id < lastAssistant.id`` 判断当前回复是否已
    # 完成，因此不能直接把无序 UUID/hash 放在 ID 的时间前缀。固定一个
    # 小于原生递增 ID 的 12 位前缀，再用 task/control digest 保证幂等与
    # 唯一；后续 assistant ID 必然排在它之后，不会无限追加模型 step。
    identity = f"{str(task_id or '').strip()}:{str(command_id or '')}"
    digest = hashlib.sha256(identity.encode("utf-8", "replace")).hexdigest()
    return "msg_000000000001" + digest[:14]


def _run_opencode_legacy_interactive(args, env, commands, resume_session_id):
    proc, events = _start_json_process(args, env)
    _emit_control("__start__", "accepted")
    session_id = resume_session_id
    try:
        while proc.poll() is None:
            for command in commands.drain():
                command_id = str(command.get("id") or "")
                if command.get("type") == "interrupt":
                    proc.terminate()
                    _emit_control(command_id, "accepted")
                else:
                    _emit_control(
                        command_id,
                        "rejected",
                        "这个旧 OpenCode 会话不能使用中途插话，请等待本轮结束后续聊",
                    )
            try:
                event = events.get(timeout=0.1)
            except queue.Empty:
                continue
            if event is None:
                break
            discovered = _walk_json_session_id(event, "opencode")
            if discovered:
                session_id = discovered
                _record_live_session(discovered, env=env)
            _normalize_stream_event("opencode", event)
        returncode = int(proc.wait())
    except Exception as exc:
        print(f"OpenCode legacy adapter failed: {exc}", file=sys.stderr)
        returncode = 2
    completed = subprocess.CompletedProcess(args, returncode, "", "")
    completed.aj_session_id = session_id
    return completed


def _run_opencode_interactive(
        prompt, commands, env, resume_session_id, model_id, legacy_args):
    is_new_session = not bool(str(resume_session_id or "").strip())
    port = _free_loopback_port()
    base_url = f"http://127.0.0.1:{port}"
    server = subprocess.Popen(
        ["opencode", "serve", "--hostname", "127.0.0.1", "--port", str(port)],
        cwd="/workspace",
        env=env,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        bufsize=1,
    )

    def relay_server_output(stream):
        for line in stream:
            sys.stderr.write(line)
            sys.stderr.flush()

    threading.Thread(target=relay_server_output, args=(server.stdout,), daemon=True).start()
    threading.Thread(target=relay_server_output, args=(server.stderr,), daemon=True).start()
    session_id = resume_session_id
    try:
        _wait_opencode_server(base_url, server)
        if session_id:
            try:
                _http_request(base_url, "/session/" + urllib.parse.quote(session_id, safe=""))
            except urllib.error.HTTPError as exc:
                if exc.code == 404:
                    # 极早期或损坏的会话可能无法由 serve 读取。保留旧的
                    # 一次性 resume，但明确拒绝 steer，不能伪造成功。
                    reason = "这个旧 OpenCode 会话不能使用中途插话"
                    env["AJ_INTERACTIVE_SUPPORTED"] = "0"
                    env["AJ_INTERACTIVE_UNSUPPORTED_REASON"] = reason
                    os.environ["AJ_INTERACTIVE_SUPPORTED"] = "0"
                    os.environ["AJ_INTERACTIVE_UNSUPPORTED_REASON"] = reason
                    _record_live_session(resume_session_id, env=env)
                    try:
                        server.terminate()
                        server.wait(timeout=5)
                    except Exception:
                        server.kill()
                    return _run_opencode_legacy_interactive(
                        legacy_args, env, commands, resume_session_id,
                    )
                raise
        else:
            # OpenCode 1.18.3 的实验 v2 runner 不会加载
            # OPENCODE_CONFIG_CONTENT 中的自定义 provider，虽然 prompt 会被
            # durable journal 接收，随后却必然报 ModelUnavailableError。
            # 稳定 V1 Session API 使用同一原生 session 存储，能够正确读取
            # 管理员配置的 endpoint，并在 busy 时把新 user message 留给
            # 当前 loop 的下一安全边界处理。
            created = _http_request(base_url, "/session", method="POST", payload={
                "model": {"providerID": OPENCODE_PROVIDER_ID, "id": model_id},
                "permission": [
                    {"permission": "*", "pattern": "*", "action": "allow"},
                    {"permission": "question", "pattern": "*", "action": "deny"},
                    {"permission": "plan_enter", "pattern": "*", "action": "deny"},
                    {"permission": "plan_exit", "pattern": "*", "action": "deny"},
                ],
            })
            session_id = str((created or {}).get("id") or "")
            if not session_id:
                raise RuntimeError("OpenCode 没有返回 session id")
        _record_live_session(session_id, env=env)
        quoted_session = urllib.parse.quote(session_id, safe="")
        events = queue.Queue()
        event_connected = threading.Event()
        stop_sse = threading.Event()
        received_event_seq = {"value": 0}

        def read_sse():
            request = urllib.request.Request(
                base_url + "/event",
                headers={"accept": "text/event-stream", "x-opencode-directory": "/workspace"},
            )
            failure_started_at = None
            connection_attempt = 0
            while not stop_sse.is_set():
                try:
                    with urllib.request.urlopen(request, timeout=None) as response:
                        connection_attempt += 1
                        failure_started_at = None
                        events.put({
                            "_numoj_sse_connected": connection_attempt,
                        })
                        for raw in response:
                            if stop_sse.is_set():
                                break
                            if not raw.startswith(b"data:"):
                                continue
                            try:
                                event = json.loads(raw[5:].strip().decode("utf-8"))
                                if (
                                    isinstance(event, dict)
                                    and event.get("type") == "server.connected"
                                ):
                                    event_connected.set()
                                received_event_seq["value"] += 1
                                if isinstance(event, dict):
                                    event = dict(event)
                                    event["_numoj_received_seq"] = received_event_seq["value"]
                                events.put(event)
                            except Exception:
                                continue
                except Exception as exc:
                    if stop_sse.is_set():
                        break
                    if server.poll() is not None:
                        events.put({"_numoj_sse_error": str(exc)})
                        break
                    now = time.monotonic()
                    if failure_started_at is None:
                        failure_started_at = now
                    if (
                        now - failure_started_at
                        >= OPENCODE_SSE_RECONNECT_FAILURE_SECONDS
                    ):
                        events.put({
                            "_numoj_sse_error": (
                                "OpenCode 事件流持续重连失败：" + str(exc)
                            ),
                        })
                        break
                # OpenCode/Bun 会在 SSE 一段时间无事件时正常关闭连接。
                # 立即重连并继续消费后续事件；server 退出仍由主循环判定。
                if stop_sse.wait(0.1):
                    break
            events.put(None)

        latest_prompt_baseline_ids = set()
        latest_prompt_user_id = ""
        latest_prompt_accepted_at = 0.0
        previous_prompt_tracking = None

        def message_snapshot():
            raw = _http_request(
                base_url,
                f"/session/{quoted_session}/message",
                timeout=5,
            )
            if isinstance(raw, list):
                items = raw
            elif isinstance(raw, dict):
                items = None
                for key in ("messages", "data", "items"):
                    if isinstance(raw.get(key), list):
                        items = raw[key]
                        break
                if items is None:
                    items = [raw] if ("info" in raw or "role" in raw) else []
            else:
                items = []
            result = []
            for item in items:
                if not isinstance(item, dict):
                    continue
                info = item.get("info") if isinstance(item.get("info"), dict) else None
                if info is None:
                    info = (
                        item.get("message")
                        if isinstance(item.get("message"), dict) else item
                    )
                parts = item.get("parts") if isinstance(item.get("parts"), list) else []
                result.append((info, parts))
            return result

        def send_prompt(
                command_id, message, *, deterministic_id=False,
                require_confirmation=False):
            nonlocal completion_must_follow_seq, failed
            nonlocal latest_prompt_accepted_at
            nonlocal latest_prompt_baseline_ids, latest_prompt_user_id
            nonlocal previous_prompt_tracking
            nonlocal saw_assistant_after_latest_prompt, session_error_seen
            try:
                before = message_snapshot()
            except Exception:
                if require_confirmation:
                    raise
                before = []
            proposed_baseline_ids = {
                str(info.get("id") or "")
                for info, _parts in before
                if str(info.get("id") or "")
            }
            proposed_user_id = ""
            payload = {
                "model": {
                    "providerID": OPENCODE_PROVIDER_ID,
                    "modelID": model_id,
                },
                "parts": [{"type": "text", "text": str(message or "")}],
            }
            if deterministic_id:
                # 只有全新 session 的第一条消息可以使用固定低 ID。resume
                # 或 steer 必须由 OpenCode 生成递增 ID，否则它会排在已有
                # assistant 之前，被 V1 loop 当成已经回复过的旧消息。
                payload["messageID"] = _opencode_message_id(
                    command_id,
                    env.get("AJ_TASK_ID"),
                )
                proposed_user_id = payload["messageID"]
            previous = (
                set(latest_prompt_baseline_ids),
                latest_prompt_user_id,
                completion_must_follow_seq,
                saw_assistant_after_latest_prompt,
                session_error_seen,
                latest_prompt_accepted_at,
                failed,
            )

            def commit_tracking():
                nonlocal completion_must_follow_seq, failed
                nonlocal latest_prompt_accepted_at
                nonlocal latest_prompt_baseline_ids, latest_prompt_user_id
                nonlocal saw_assistant_after_latest_prompt, session_error_seen
                latest_prompt_baseline_ids = proposed_baseline_ids
                latest_prompt_user_id = proposed_user_id
                # 这里只记录已经由主循环投影完成的 SSE 边界。HTTP 请求
                # 返回期间可能已经收到新 prompt 产生的 assistant/tool 事件，
                # 不能把它们误当成插话前的 backlog。
                completion_must_follow_seq = processed_event_seq
                saw_assistant_after_latest_prompt = False
                session_error_seen = False
                latest_prompt_accepted_at = time.monotonic()
                failed = False

            try:
                _http_request(
                    base_url,
                    f"/session/{quoted_session}/prompt_async",
                    method="POST",
                    payload=payload,
                )
            except urllib.error.HTTPError:
                # 明确拒绝时必须完整保留原轮 tracking；队列里可能已经有
                # 原轮的 final assistant + idle，不能因一次迟到 steer 丢掉。
                raise
            except Exception:
                # 传输错误无法证明服务端是否已接收。暂时按可能已接收发布
                # 新 tracking；若 durable API 显示没有新 user 且已经 idle，
                # reconcile 会恢复 previous tracking。
                commit_tracking()
                previous_prompt_tracking = previous
                raise
            commit_tracking()
            previous_prompt_tracking = None
            return proposed_baseline_ids

        threading.Thread(target=read_sse, daemon=True).start()
        if not event_connected.wait(10):
            raise RuntimeError("OpenCode 事件流连接超时")
        completion_must_follow_seq = received_event_seq["value"]
        failed = False
        interrupted = False
        saw_assistant_after_latest_prompt = False
        session_error_seen = False
        assistant_ids = set()
        projected_part_states = set()
        processed_event_seq = 0
        settled = False
        send_prompt("__start__", prompt, deterministic_id=is_new_session)
        _emit_control("__start__", "accepted")
        start_accepted = True

        def project_v1_event(
                event, *, from_snapshot=False, snapshot_terminal=False):
            nonlocal failed, saw_assistant_after_latest_prompt, session_error_seen, settled
            nonlocal latest_prompt_user_id
            if not isinstance(event, dict):
                return
            event_type = str(event.get("type") or "")
            props = (
                event.get("properties")
                if isinstance(event.get("properties"), dict) else {}
            )
            if str(props.get("sessionID") or "") != session_id:
                return
            if event_type == "message.updated":
                info = props.get("info") if isinstance(props.get("info"), dict) else {}
                if info.get("role") == "assistant":
                    assistant_id = str(info.get("id") or "")
                    if assistant_id:
                        assistant_ids.add(assistant_id)
                    received_seq = int(event.get("_numoj_received_seq") or 0)
                    parent_id = str(
                        info.get("parentID") or info.get("parentId") or ""
                    )
                    belongs_to_latest_prompt = bool(
                        parent_id
                        and (
                            parent_id == latest_prompt_user_id
                            or (
                                not latest_prompt_user_id
                                and parent_id not in latest_prompt_baseline_ids
                            )
                        )
                    )
                    if (
                        from_snapshot
                        or (
                            received_seq > completion_must_follow_seq
                            and belongs_to_latest_prompt
                        )
                    ):
                        if not latest_prompt_user_id and parent_id:
                            latest_prompt_user_id = parent_id
                        saw_assistant_after_latest_prompt = True
                    if (
                        info.get("error")
                        and not interrupted
                        and (from_snapshot or belongs_to_latest_prompt)
                    ):
                        failed = True
                return
            if event_type == "message.part.updated":
                part = props.get("part") if isinstance(props.get("part"), dict) else {}
                if str(part.get("messageID") or "") not in assistant_ids:
                    return
                part_type = str(part.get("type") or "")
                part_id = str(part.get("id") or "")
                if part_type in {"text", "reasoning"}:
                    part_time = part.get("time") if isinstance(part.get("time"), dict) else {}
                    state_key = (part_id, part_type, "ended")
                    if (
                        (part_time.get("end") is None and not snapshot_terminal)
                        or state_key in projected_part_states
                    ):
                        return
                    projected_part_states.add(state_key)
                elif part_type == "tool":
                    state = part.get("state") if isinstance(part.get("state"), dict) else {}
                    status = str(state.get("status") or "")
                    if status not in {"running", "completed", "error"}:
                        return
                    state_key = (part_id, part_type, status)
                    if state_key in projected_part_states:
                        return
                    projected_part_states.add(state_key)
                elif part_type == "step-finish":
                    state_key = (part_id, part_type, "ended")
                    if state_key in projected_part_states:
                        return
                    projected_part_states.add(state_key)
                else:
                    return
                _normalize_stream_event("opencode", event)
                return
            if event_type == "session.error":
                session_error_seen = not interrupted
                if not interrupted:
                    _normalize_stream_event("opencode", event)
                return
            if event_type == "session.status":
                status = props.get("status") if isinstance(props.get("status"), dict) else {}
                if (
                    status.get("type") == "idle"
                    and (
                        saw_assistant_after_latest_prompt
                        or interrupted
                        or failed
                    )
                ):
                    if session_error_seen and not failed and not interrupted:
                        # ContextOverflowError 等错误可由 OpenCode 自动压缩后
                        # 继续；必须由 durable assistant/status 判定最终结果。
                        return
                    settled = True
                    stop_sse.set()

        def reconcile_durable_snapshot():
            nonlocal completion_must_follow_seq, failed
            nonlocal latest_prompt_accepted_at
            nonlocal latest_prompt_baseline_ids, latest_prompt_user_id
            nonlocal previous_prompt_tracking
            nonlocal saw_assistant_after_latest_prompt, session_error_seen, settled
            entries = message_snapshot()
            indexed = []
            for index, (info, parts) in enumerate(entries):
                message_id = str(info.get("id") or "")
                role = str(info.get("role") or "")
                indexed.append((index, message_id, role, info, parts))

            target_index = None
            if latest_prompt_user_id:
                for index, message_id, role, _info, _parts in indexed:
                    if message_id == latest_prompt_user_id and role == "user":
                        target_index = index
                        break
            else:
                new_users = [
                    item for item in indexed
                    if item[2] == "user"
                    and item[1]
                    and item[1] not in latest_prompt_baseline_ids
                ]
                if new_users:
                    target_index, latest_prompt_user_id = (
                        new_users[-1][0], new_users[-1][1]
                    )
            def durable_status_type():
                statuses = _http_request(base_url, "/session/status", timeout=5)
                if not isinstance(statuses, dict):
                    return False, ""
                status = statuses.get(session_id)
                # OpenCode 会从 status map 删除已经 idle 的 session。
                if status is None:
                    return True, "idle"
                if isinstance(status, dict):
                    return True, str(status.get("type") or "")
                return True, ""

            if target_index is None and previous_prompt_tracking is not None:
                try:
                    status_known, status_type = durable_status_type()
                except Exception:
                    status_known, status_type = False, ""
                if status_known and status_type == "idle":
                    (
                        latest_prompt_baseline_ids,
                        latest_prompt_user_id,
                        completion_must_follow_seq,
                        saw_assistant_after_latest_prompt,
                        session_error_seen,
                        latest_prompt_accepted_at,
                        failed,
                    ) = previous_prompt_tracking
                    previous_prompt_tracking = None
                    for index, message_id, role, _info, _parts in indexed:
                        if message_id == latest_prompt_user_id and role == "user":
                            target_index = index
                            break
            if target_index is None:
                if (
                    latest_prompt_accepted_at > 0
                    and time.monotonic() - latest_prompt_accepted_at
                    >= OPENCODE_PROMPT_PERSISTENCE_SECONDS
                ):
                    try:
                        status_known, status_type = durable_status_type()
                    except Exception:
                        status_known, status_type = False, ""
                    if status_known and status_type == "idle":
                        failed = True
                        settled = True
                        stop_sse.set()
                return

            saw_candidate = False
            for index, message_id, role, info, parts in indexed:
                if role != "assistant" or not message_id:
                    continue
                parent_id = str(info.get("parentID") or info.get("parentId") or "")
                if not (
                    parent_id == latest_prompt_user_id
                    or (
                        index > target_index
                        and message_id not in latest_prompt_baseline_ids
                    )
                ):
                    continue
                saw_candidate = True
                error = info.get("error")
                time_info = info.get("time") if isinstance(info.get("time"), dict) else {}
                has_terminal_part = any(
                    isinstance(part, dict)
                    and str(part.get("type") or "") in {"step-finish", "step_finish"}
                    for part in parts
                )
                is_terminal = bool(
                    error
                    or info.get("finish")
                    or info.get("finishReason")
                    or time_info.get("completed")
                    or time_info.get("end")
                    or has_terminal_part
                )
                project_v1_event({
                    "type": "message.updated",
                    "properties": {
                        "sessionID": session_id,
                        "info": info,
                    },
                }, from_snapshot=True, snapshot_terminal=is_terminal)
                for part in parts:
                    if not isinstance(part, dict):
                        continue
                    project_v1_event({
                        "type": "message.part.updated",
                        "properties": {
                            "sessionID": session_id,
                            "part": part,
                        },
                    }, from_snapshot=True, snapshot_terminal=is_terminal)
                if error and not interrupted:
                    project_v1_event({
                        "type": "session.error",
                        "properties": {
                            "sessionID": session_id,
                            "error": error,
                        },
                    }, from_snapshot=True, snapshot_terminal=True)

            if failed and not interrupted:
                try:
                    status_known, status_type = durable_status_type()
                except Exception:
                    status_known, status_type = False, ""
                if status_known and status_type == "idle":
                    settled = True
                    stop_sse.set()
                return
            if interrupted:
                try:
                    status_known, status_type = durable_status_type()
                except Exception:
                    status_known, status_type = False, ""
                if status_known and status_type == "idle":
                    settled = True
                    stop_sse.set()
                return
            if session_error_seen and not saw_candidate:
                try:
                    status_known, status_type = durable_status_type()
                except Exception:
                    status_known, status_type = False, ""
                if status_known and status_type == "idle":
                    failed = True
                    settled = True
                    stop_sse.set()
                return
            if not saw_candidate:
                if (
                    latest_prompt_accepted_at > 0
                    and time.monotonic() - latest_prompt_accepted_at
                    >= OPENCODE_PROMPT_PERSISTENCE_SECONDS
                ):
                    try:
                        status_known, status_type = durable_status_type()
                    except Exception:
                        status_known, status_type = False, ""
                    if status_known and status_type == "idle":
                        failed = True
                        settled = True
                        stop_sse.set()
                return
            status_known = False
            status_type = ""
            try:
                status_known, status_type = durable_status_type()
            except Exception:
                pass
            # `step-finish` 也会出现在工具调用前的中间模型 step；只有
            # durable status 明确 idle（含 status map 已删除该 session）
            # 才能把成功轮次收束；is_terminal 只用于稳定投影对应 part。
            if status_known and status_type == "idle":
                settled = True
                stop_sse.set()

        def consume_v1_event(event, *, reconcile=True):
            nonlocal processed_event_seq
            if event is None:
                if not settled:
                    raise RuntimeError("OpenCode 事件流意外关闭")
                return
            if not isinstance(event, dict):
                return
            if event.get("_numoj_sse_error"):
                raise RuntimeError(str(event.get("_numoj_sse_error")))
            if event.get("_numoj_sse_connected"):
                if reconcile:
                    try:
                        reconcile_durable_snapshot()
                    except Exception:
                        pass
                return
            project_v1_event(event)
            try:
                event_seq = int(event.get("_numoj_received_seq") or 0)
            except (TypeError, ValueError):
                event_seq = 0
            processed_event_seq = max(processed_event_seq, event_seq)

        def replayed_user_id(event, baseline_ids):
            if not isinstance(event, dict) or event.get("type") != "message.updated":
                return ""
            props = (
                event.get("properties")
                if isinstance(event.get("properties"), dict) else {}
            )
            if str(props.get("sessionID") or "") != session_id:
                return ""
            info = props.get("info") if isinstance(props.get("info"), dict) else {}
            message_id = str(info.get("id") or "")
            if info.get("role") != "user" or not message_id:
                return ""
            return "" if message_id in baseline_ids else message_id

        def new_assistant_parent_id(event, baseline_ids):
            if not isinstance(event, dict) or event.get("type") != "message.updated":
                return ""
            props = (
                event.get("properties")
                if isinstance(event.get("properties"), dict) else {}
            )
            if str(props.get("sessionID") or "") != session_id:
                return ""
            info = props.get("info") if isinstance(props.get("info"), dict) else {}
            parent_id = str(info.get("parentID") or info.get("parentId") or "")
            if info.get("role") != "assistant" or not parent_id:
                return ""
            return "" if parent_id in baseline_ids else parent_id

        def durable_prompt_user_id(baseline_ids):
            try:
                snapshot = message_snapshot()
            except Exception:
                return ""
            candidates = [
                str(info.get("id") or "")
                for info, _parts in snapshot
                if str(info.get("role") or "") == "user"
                and str(info.get("id") or "")
                and str(info.get("id") or "") not in baseline_ids
            ]
            return candidates[-1] if candidates else ""

        def wait_for_prompt_acceptance(baseline_ids):
            """等 OpenCode 持久化新 user，再允许宿主写 accepted 锚点。"""

            nonlocal latest_prompt_user_id, completion_must_follow_seq
            deadline = time.monotonic() + OPENCODE_PROMPT_PERSISTENCE_SECONDS
            held_events = []
            while time.monotonic() < deadline:
                try:
                    event = events.get(timeout=0.1)
                except queue.Empty:
                    user_id = durable_prompt_user_id(baseline_ids)
                    if user_id:
                        latest_prompt_user_id = user_id
                        completion_must_follow_seq = processed_event_seq
                        return held_events
                    if settled:
                        raise RuntimeError("OpenCode 当前轮次已结束，未接收插话")
                    if server.poll() is not None:
                        raise RuntimeError("OpenCode serve 意外退出")
                    continue

                if (
                    event is None
                    or not isinstance(event, dict)
                    or event.get("_numoj_sse_error")
                    or event.get("_numoj_sse_connected")
                ):
                    consume_v1_event(event, reconcile=False)
                    continue

                user_id = replayed_user_id(event, baseline_ids)
                if user_id:
                    latest_prompt_user_id = user_id
                    if held_events:
                        held_events.append(event)
                    else:
                        consume_v1_event(event, reconcile=False)
                    completion_must_follow_seq = processed_event_seq
                    return held_events

                if held_events:
                    held_events.append(event)
                    continue

                # 某些版本会漏掉 user replay，却先推送以该 user 为 parent
                # 的 assistant。此时先用 durable API 证实 user 已落盘，
                # 把当前 assistant 留到 accepted 锚点之后再投影。
                parent_id = new_assistant_parent_id(event, baseline_ids)
                if parent_id:
                    durable_id = durable_prompt_user_id(baseline_ids)
                    if durable_id:
                        latest_prompt_user_id = durable_id
                        completion_must_follow_seq = processed_event_seq
                        return [event]
                    held_events.append(event)
                    continue

                consume_v1_event(event, reconcile=False)
                if settled:
                    user_id = durable_prompt_user_id(baseline_ids)
                    if user_id:
                        latest_prompt_user_id = user_id
                        completion_must_follow_seq = processed_event_seq
                        return held_events
                    raise RuntimeError("OpenCode 当前轮次已结束，未接收插话")
            raise RuntimeError("OpenCode 未确认插话消息已经持久化")

        last_reconcile_at = 0.0
        while not settled:
            # prompt_async 与 SSE 是两条连接。先投影已经到达宿主的
            # SSE 事件，避免旧工具/回复因队列积压被画到新插话之后。
            while True:
                try:
                    consume_v1_event(events.get_nowait())
                except queue.Empty:
                    break
            if settled:
                for command in commands.drain():
                    _emit_control(
                        str(command.get("id") or ""),
                        "rejected",
                        "OpenCode 当前轮次已经结束",
                    )
                break
            for command in commands.drain():
                command_id = str(command.get("id") or "")
                try:
                    if settled:
                        _emit_control(
                            command_id,
                            "rejected",
                            "OpenCode 当前轮次已经结束",
                        )
                        continue
                    if command.get("type") == "steer":
                        baseline_ids = send_prompt(
                            command_id,
                            command.get("message"),
                            require_confirmation=True,
                        )
                        deferred_events = wait_for_prompt_acceptance(baseline_ids)
                    else:
                        _http_request(
                            base_url,
                            f"/session/{quoted_session}/abort",
                            method="POST",
                        )
                        interrupted = True
                        deferred_events = ()
                    _emit_control(command_id, "accepted")
                    for deferred_event in deferred_events:
                        consume_v1_event(deferred_event, reconcile=False)
                except urllib.error.HTTPError as exc:
                    detail = exc.read().decode("utf-8", "replace")
                    _emit_control(command_id, "rejected", detail or str(exc))
                except Exception as exc:
                    _emit_control(command_id, "unknown", str(exc))
            if settled:
                break
            now = time.monotonic()
            if (
                now - last_reconcile_at
                >= OPENCODE_DURABLE_RECONCILE_INTERVAL_SECONDS
            ):
                last_reconcile_at = now
                try:
                    reconcile_durable_snapshot()
                except Exception:
                    # 实时 SSE 仍是主路径；durable API 的瞬时失败不应中断
                    # 正在进行的 turn，持续 SSE 失败另有有界截止。
                    pass
                if settled:
                    break
            try:
                event = events.get(timeout=0.1)
            except queue.Empty:
                if server.poll() is not None:
                    raise RuntimeError("OpenCode serve 意外退出")
                continue
            consume_v1_event(event)
        returncode = 130 if interrupted else (2 if failed else 0)
    except Exception as exc:
        if not locals().get("start_accepted", False):
            _emit_control("__start__", "rejected", str(exc))
        print(f"OpenCode interactive adapter failed: {exc}", file=sys.stderr)
        returncode = 2
    finally:
        if "stop_sse" in locals():
            stop_sse.set()
        try:
            server.terminate()
            server.wait(timeout=5)
        except Exception:
            try:
                server.kill()
            except Exception:
                pass
    completed = subprocess.CompletedProcess(server.args, returncode, "", "")
    completed.aj_session_id = session_id
    return completed


def _run_opencode(prompt, commands=None):
    try:
        resume_session_id = _resume_session_id_from_env("opencode")
        _protocol, base_url, api_key, model = _endpoint_settings({"openai"})
        context_window_tokens, max_output_tokens, thinking_compatibility = (
            _endpoint_model_capabilities()
        )
        endpoint_thinking_format = _endpoint_thinking_format_env()
        web_search_mcp = _web_search_mcp_settings()
    except ValueError as exc:
        print(f"invalid endpoint configuration: {exc}", file=sys.stderr)
        return 2
    model_id = model
    skill_files = _validated_skill_files("opencode")
    if skill_files is None:
        return 2
    audit_read_only = _audit_read_only_enabled()
    try:
        runtime_root = _runtime_root()
    except ValueError as exc:
        print(f"invalid Agent runtime: {exc}", file=sys.stderr)
        return 2
    if runtime_root:
        opencode_root = os.path.join(runtime_root, "opencode")
        home = os.path.join(opencode_root, "home")
        xdg_directories = {
            "XDG_CONFIG_HOME": os.path.join(opencode_root, "config"),
            "XDG_DATA_HOME": os.path.join(opencode_root, "data"),
            "XDG_STATE_HOME": os.path.join(opencode_root, "state"),
            "XDG_CACHE_HOME": os.path.join(opencode_root, "cache"),
        }
    else:
        home = "/tmp/aj_opencode_home"
        xdg_directories = {}
    relay = None
    provider_base_url = base_url
    if endpoint_thinking_format is not None:
        relay = _EndpointThinkingRelay(
            base_url,
            "openai",
            endpoint_thinking_format,
            thinking_compatibility,
        )
        try:
            provider_base_url = relay.start()
        except Exception as exc:
            print(f"failed to start OpenCode endpoint relay: {exc}", file=sys.stderr)
            return 2
    try:
        env = os.environ.copy()
        env["HOME"] = home
        env.update(xdg_directories)
        env["OPENCODE_CONFIG_CONTENT"] = _opencode_config_content(
            provider_base_url, "AJ_ENDPOINT_API_KEY", model_id,
            audit_read_only=audit_read_only,
            context_window_tokens=context_window_tokens,
            max_output_tokens=max_output_tokens,
            thinking_compatibility=thinking_compatibility,
            web_search_mcp=web_search_mcp,
        )
        # OpenCode 默认把单次输出再截到 32K；端点池中的管理员配置才是这里的
        # 唯一上限，因此同步覆盖该运行时保护值。
        env["OPENCODE_EXPERIMENTAL_OUTPUT_TOKEN_MAX"] = str(max_output_tokens)
        if audit_read_only:
            env.update({
                "OPENCODE_DISABLE_DEFAULT_PLUGINS": "true",
                "OPENCODE_DISABLE_CLAUDE_CODE": "true",
                "OPENCODE_DISABLE_AUTOUPDATE": "true",
                "OPENCODE_DISABLE_LSP_DOWNLOAD": "true",
                "OPENCODE_DISABLE_MODELS_FETCH": "true",
            })
        for directory in (home, *xdg_directories.values()):
            os.makedirs(directory, exist_ok=True)
        if audit_read_only:
            args = [
                "opencode", "--pure", "run",
                "--format", "json",
                "--model", "%s/%s" % (OPENCODE_PROVIDER_ID, model_id),
            ]
            resume_session_id = ""
        else:
            args = [
                "opencode", "run",
                "--format", "json",
                "--dangerously-skip-permissions",
                "--model", "%s/%s" % (OPENCODE_PROVIDER_ID, model_id),
            ]
        if resume_session_id and not audit_read_only:
            args.extend(["--session", resume_session_id])
        legacy_args = [*args, prompt]
        if commands is not None:
            if audit_read_only:
                _emit_control("__start__", "rejected", "只读审计模式不支持交互控制")
                return 2
            proc = _run_opencode_interactive(
                prompt,
                commands,
                env,
                resume_session_id,
                model_id,
                legacy_args,
            )
            _record_session("opencode", proc, resume_session_id)
            return proc.returncode
        args.append(prompt)
        proc = _run(args, env)
        _record_session("opencode", proc, resume_session_id)
        return proc.returncode
    finally:
        if relay is not None:
            relay.stop()


def _positive_int_env(name, default):
    raw = str(os.environ.get(name) or "").strip()
    if not raw:
        return default
    try:
        value = int(raw)
    except (TypeError, ValueError):
        raise ValueError(f"{name} must be a positive integer")
    if value <= 0:
        raise ValueError(f"{name} must be a positive integer")
    return value


def _bool_env(name, default):
    raw = str(os.environ.get(name) or "").strip().lower()
    if not raw:
        return bool(default)
    if raw in {"1", "true", "yes", "on"}:
        return True
    if raw in {"0", "false", "no", "off"}:
        return False
    raise ValueError(f"{name} must be a boolean")


def _endpoint_thinking_format_env():
    raw = str(os.environ.get("AJ_ENDPOINT_THINKING_FORMAT") or "").strip().lower()
    if not raw:
        return None
    if raw not in ENDPOINT_THINKING_FORMATS:
        raise ValueError("AJ_ENDPOINT_THINKING_FORMAT has an unsupported value")
    return raw


def _endpoint_model_capabilities():
    context_window_tokens = _positive_int_env(
        "AJ_ENDPOINT_CONTEXT_WINDOW_TOKENS", DEFAULT_CONTEXT_WINDOW_TOKENS,
    )
    max_output_tokens = _positive_int_env(
        "AJ_ENDPOINT_MAX_OUTPUT_TOKENS", DEFAULT_MAX_OUTPUT_TOKENS,
    )
    if max_output_tokens > context_window_tokens:
        raise ValueError(
            "AJ_ENDPOINT_MAX_OUTPUT_TOKENS cannot exceed "
            "AJ_ENDPOINT_CONTEXT_WINDOW_TOKENS"
        )
    return (
        context_window_tokens,
        max_output_tokens,
        _bool_env("AJ_ENDPOINT_THINKING_ENABLED", DEFAULT_THINKING_COMPATIBILITY),
    )


def _write_pi_models_config(
        config_dir, base_url, model, context_window_tokens=None,
        max_output_tokens=None, thinking_compatibility=None,
        protocol="openai"):
    os.makedirs(config_dir, exist_ok=True)
    if context_window_tokens is None:
        context_window_tokens = DEFAULT_CONTEXT_WINDOW_TOKENS
    if max_output_tokens is None:
        max_output_tokens = DEFAULT_MAX_OUTPUT_TOKENS
    if thinking_compatibility is None:
        thinking_compatibility = DEFAULT_THINKING_COMPATIBILITY
    model_config = {
        "id": model,
        "name": model,
        "contextWindow": int(context_window_tokens),
        "maxTokens": int(max_output_tokens),
    }
    if thinking_compatibility:
        model_config.update({
            "reasoning": True,
            "input": ["text"],
        })
    protocol = str(protocol or "openai").strip().lower()
    if protocol not in {"openai", "anthropic"}:
        raise ValueError("unsupported Pi endpoint protocol")
    provider = {
        "baseUrl": base_url,
        "api": (
            "anthropic-messages" if protocol == "anthropic"
            else "openai-completions"
        ),
        "apiKey": "$AJ_ENDPOINT_API_KEY",
        "models": [model_config],
    }
    if protocol == "openai":
        provider.update({
            "authHeader": True,
            "compat": {
                "supportsStore": False,
                "supportsDeveloperRole": False,
                "maxTokensField": "max_tokens",
            },
        })
    config = {
        "providers": {
            PI_PROVIDER_NAME: provider,
        },
    }
    with open(os.path.join(config_dir, "models.json"), "w", encoding="utf-8") as f:
        json.dump(config, f, ensure_ascii=False)


def _run_pi_interactive(base_args, env, prompt, commands, resume_session_id):
    args = list(base_args)
    mode_index = args.index("--mode") + 1
    args[mode_index] = "rpc"
    if resume_session_id:
        args.extend(["--session", resume_session_id])
    proc, events = _start_json_process(args, env)
    pending = {
        "__numoj-state__": "get_state",
        "__start__": "prompt",
    }
    session_id = resume_session_id
    failure_status = ""
    settled = False
    try:
        # Pi 的普通事件不携带 session ID。RPC get_state 是固定版本公开的
        # 唯一稳定来源，必须在首条 prompt 前读取并立即落盘，才能在外部
        # stop 或宿主崩溃后继续同一个原生会话。
        _write_json(proc, {"type": "get_state", "id": "__numoj-state__"})
        _write_json(proc, {"type": "prompt", "id": "__start__", "message": prompt})
        done = False
        while not done:
            for command in commands.drain():
                command_id = str(command.get("id") or "")
                upstream_type = "prompt" if command.get("type") == "steer" else "abort"
                payload = {"type": upstream_type, "id": command_id}
                if upstream_type == "prompt":
                    payload["message"] = str(command.get("message") or "")
                    payload["streamingBehavior"] = "steer"
                try:
                    _write_json(proc, payload)
                    pending[command_id] = upstream_type
                except (BrokenPipeError, OSError) as exc:
                    _emit_control(command_id, "unknown", str(exc))
            try:
                event = events.get(timeout=0.1)
            except queue.Empty:
                if proc.poll() is not None:
                    raise RuntimeError("Pi RPC 意外退出")
                continue
            if event is None:
                raise RuntimeError("Pi RPC 意外退出")
            discovered_session_id = _walk_json_session_id(event, "pi")
            if discovered_session_id and discovered_session_id != session_id:
                session_id = discovered_session_id
                _record_live_session(session_id, env=env)
            if event.get("type") == "response":
                response_id = str(event.get("id") or "")
                if not response_id:
                    command_name = str(event.get("command") or "")
                    candidates = [
                        command_id for command_id, name in pending.items()
                        if name == command_name
                    ]
                    response_id = candidates[0] if len(candidates) == 1 else ""
                if response_id == "__numoj-state__":
                    pending.pop(response_id, None)
                    if not bool(event.get("success")):
                        raise RuntimeError(
                            str(event.get("error") or "Pi get_state 失败")
                        )
                    data = event.get("data") if isinstance(event.get("data"), dict) else {}
                    discovered = str(data.get("sessionId") or "").strip()
                    if not discovered:
                        raise RuntimeError("Pi get_state 没有返回 session id")
                    if discovered != session_id:
                        session_id = discovered
                        _record_live_session(session_id, env=env)
                    continue
                if response_id in pending:
                    pending_name = pending.pop(response_id, None)
                    success = bool(event.get("success"))
                    _emit_control(
                        response_id,
                        "accepted" if success else "rejected",
                        str(event.get("error") or event.get("message") or "") if not success else "",
                    )
                    if response_id == "__start__" and not success:
                        raise RuntimeError(
                            str(event.get("error") or "Pi 首轮消息被拒绝")
                        )
                    if pending_name == "prompt" and response_id != "__start__":
                        if success:
                            # prompt(streamingBehavior=steer) 在活动时排入安全
                            # 边界、空闲时直接启动；此前看到的 settled 属于旧 run。
                            settled = False
                        elif settled and not any(
                            name in {"prompt", "abort"}
                            for name in pending.values()
                        ):
                            done = True
                    elif pending_name == "abort" and settled:
                        # Pi abort 会先发 agent_settled，再返回 success response。
                        done = not any(
                            name in {"prompt", "abort"}
                            for name in pending.values()
                        )
                    continue
            event_failure_status = _pi_event_failure_status(event)
            failure_status = event_failure_status or failure_status
            terminal = _normalize_stream_event("pi", event)
            if terminal:
                settled = True
                active_pending = any(
                    name in {"prompt", "abort"}
                    for name in pending.values()
                )
                if not active_pending:
                    done = True
        returncode = (
            2 if failure_status == "failed"
            else 130 if failure_status == "interrupted"
            else 0
        )
    except Exception as exc:
        if "__start__" in pending:
            _emit_control("__start__", "rejected", str(exc))
            pending.pop("__start__", None)
        print(f"Pi interactive adapter failed: {exc}", file=sys.stderr)
        returncode = 2
    finally:
        for command_id in pending:
            if command_id == "__numoj-state__":
                continue
            _emit_control(command_id, "unknown", "Pi 已结束但未返回控制回执")
        try:
            proc.stdin.close()
        except Exception:
            pass
        try:
            proc.terminate()
            proc.wait(timeout=5)
        except Exception:
            try:
                proc.kill()
            except Exception:
                pass
    completed = subprocess.CompletedProcess(args, returncode, "", "")
    completed.aj_session_id = session_id
    return completed


def _run_pi(prompt, commands=None):
    try:
        resume_session_id = _resume_session_id_from_env("pi")
        protocol, base_url, api_key, model = _endpoint_settings(
            {"openai", "anthropic"},
        )
        context_window_tokens, max_output_tokens, thinking_compatibility = (
            _endpoint_model_capabilities()
        )
        endpoint_thinking_format = _endpoint_thinking_format_env()
        web_search_mcp = _web_search_mcp_settings()
    except ValueError as exc:
        print(f"invalid endpoint configuration: {exc}", file=sys.stderr)
        return 2
    skill_files = _validated_skill_files("pi")
    if skill_files is None:
        return 2
    try:
        config_dir = _runtime_path("pi/agent", PI_CONFIG_DIR)
        session_dir = _runtime_path("pi/agent/sessions", PI_SESSION_DIR)
    except ValueError as exc:
        print(f"invalid Agent runtime: {exc}", file=sys.stderr)
        return 2
    relay = None
    provider_base_url = base_url
    if endpoint_thinking_format is not None:
        relay = _EndpointThinkingRelay(
            base_url,
            protocol,
            endpoint_thinking_format,
            thinking_compatibility,
        )
        try:
            provider_base_url = relay.start()
        except Exception as exc:
            print(f"failed to start Pi endpoint relay: {exc}", file=sys.stderr)
            return 2
    try:
        _write_pi_models_config(
            config_dir, provider_base_url, model,
            context_window_tokens=context_window_tokens,
            max_output_tokens=max_output_tokens,
            thinking_compatibility=thinking_compatibility,
            protocol=protocol,
        )
        os.makedirs(session_dir, exist_ok=True)
        env = os.environ.copy()
        env.update({
            "PI_CODING_AGENT_DIR": config_dir,
            "PI_CODING_AGENT_SESSION_DIR": session_dir,
            "PI_OFFLINE": "1",
            "PI_TELEMETRY": "0",
            "PI_SKIP_VERSION_CHECK": "1",
        })
        phase = str(os.environ.get("AJ_PHASE") or "").strip().lower()
        audit_read_only = _audit_read_only_enabled()
        base_args = [
            "pi",
            "--mode", "json",
            "--provider", PI_PROVIDER_NAME,
            "--model", model,
            "--no-approve",
            "--no-extensions",
            "--no-skills",
            "--no-prompt-templates",
            "--no-themes",
        ]
        if web_search_mcp:
            # Pi 没有原生 MCP 配置；只显式加载镜像内受信任的协议适配扩展，
            # 不扫描工作区或用户目录中的其他 extension。
            base_args.extend(["--extension", PI_WEB_SEARCH_MCP_EXTENSION])
        if skill_files:
            # Pi 在 --no-skills 下仍可以用 --skill 显式加载单个受信任
            # skill，避免扫描镜像内或其他目录的隐式 skill。
            base_args.extend(["--skill", skill_files[0]])
        if audit_read_only:
            # Pi 自身不提供沙箱；质量门禁容器另有只读根文件系统、只读 evidence
            # 挂载与无 capabilities 约束，这里再把内建工具缩到纯读取集合。
            base_args.extend(["--tools", "read,grep,find,ls"])
            resume_session_id = ""
        if thinking_compatibility:
            effort = str(os.environ.get("AJ_EFFORT") or "").strip().lower()
            # Reverse Judge 的收尾轮只负责把已有工作形成交付物，显式关闭
            # thinking；普通 Agent 完全遵循本轮原生 CLI 的终止结果。
            if phase == "reverse_finalize":
                base_args.extend(["--thinking", "off"])
            elif effort in PI_THINKING_LEVELS:
                base_args.extend(["--thinking", effort])

        if commands is not None:
            if audit_read_only:
                _emit_control("__start__", "rejected", "只读审计模式不支持交互控制")
                return 2
            proc = _run_pi_interactive(
                base_args, env, prompt, commands, resume_session_id,
            )
            _record_session("pi", proc, resume_session_id)
            return proc.returncode

        args = list(base_args)
        if resume_session_id:
            args.extend(["--session", resume_session_id])
        args.append(prompt)
        proc = _run(
            args,
            env=env,
            stdout_session_only=phase in {"reverse_solve", "reverse_finalize"},
        )
        _record_session("pi", proc, resume_session_id)
        return proc.returncode
    finally:
        if relay is not None:
            relay.stop()


def _stable_control_uuid(command_id, task_id=""):
    digest = hashlib.sha256(
        f"{str(task_id or '').strip()}:{str(command_id or '')}".encode(
            "utf-8", "replace",
        )
    ).hexdigest()[:32]
    return f"{digest[:8]}-{digest[8:12]}-{digest[12:16]}-{digest[16:20]}-{digest[20:]}"


def _claude_user_frame(message, command_id, task_id=""):
    return {
        "type": "user",
        "uuid": _stable_control_uuid(command_id, task_id),
        "message": {
            "role": "user",
            "content": [{"type": "text", "text": str(message or "")}],
        },
        "parent_tool_use_id": None,
        # SDK 协议层的通道 ID，与需要落盘的 Claude 原生
        # session_id 无关；顶层单会话始终使用 default。
        "session_id": "default",
    }


def _claude_replayed_user_uuid(event):
    if (
        not isinstance(event, dict)
        or event.get("type") != "user"
        or not bool(event.get("isReplay"))
    ):
        return ""
    return str(event.get("uuid") or "").strip()


def _run_claude_interactive(args, env, prompt, commands, resume_session_id):
    stream_args = list(args)
    output_index = stream_args.index("--output-format") + 1
    stream_args[output_index] = "stream-json"
    stream_args.extend([
        "--input-format", "stream-json",
        "--replay-user-messages",
        "--verbose",
    ])
    proc, events = _start_json_process(stream_args, env)
    task_id = str(env.get("AJ_TASK_ID") or "").strip()
    start_uuid = _stable_control_uuid("__start__", task_id)
    waiting_user_acks = {start_uuid: "__start__"}
    pending_interrupts = {}
    result_waiting_for_replay = False
    interrupt_accepted = False
    result_sequence = 0
    assistant_usage_since_result = False
    terminal_waiting_for_control = False
    terminal_failed_while_waiting = False
    control_drain_deadline = None
    try:
        _write_json(proc, _claude_user_frame(prompt, "__start__", task_id))
        done = False
        terminal_status = ""
        while not done:
            if (
                control_drain_deadline is not None
                and time.monotonic() >= control_drain_deadline
            ):
                done = True
                continue
            pending_commands = (
                [] if terminal_waiting_for_control else commands.drain()
            )
            for command in pending_commands:
                command_id = str(command.get("id") or "")
                try:
                    if command.get("type") == "steer":
                        frame_uuid = _stable_control_uuid(command_id, task_id)
                        _write_json(
                            proc,
                            _claude_user_frame(
                                command.get("message"), command_id, task_id,
                            ),
                        )
                        waiting_user_acks[frame_uuid] = command_id
                    else:
                        request_id = "numoj-" + command_id
                        _write_json(proc, {
                            "type": "control_request",
                            "request_id": request_id,
                            "request": {"subtype": "interrupt"},
                        })
                        pending_interrupts[request_id] = command_id
                except (BrokenPipeError, OSError) as exc:
                    _emit_control(command_id, "unknown", str(exc))
            try:
                timeout = 0.1
                if control_drain_deadline is not None:
                    timeout = max(
                        0.001,
                        min(timeout, control_drain_deadline - time.monotonic()),
                    )
                event = events.get(timeout=timeout)
            except queue.Empty:
                if control_drain_deadline is not None:
                    continue
                if proc.poll() is not None:
                    raise RuntimeError("Claude Code stream-json 意外退出")
                continue
            if event is None:
                if terminal_waiting_for_control:
                    done = True
                    continue
                raise RuntimeError("Claude Code stream-json 意外退出")
            session_id = _walk_json_session_id(event, "claude_code")
            if session_id:
                _record_live_session(session_id, env=env)
            event_type = str(event.get("type") or "")
            message = (
                event.get("message")
                if isinstance(event.get("message"), dict) else {}
            )
            if (
                event_type == "assistant"
                and isinstance(message.get("usage"), dict)
            ):
                assistant_usage_since_result = True
            if event_type == "result":
                result_sequence += 1
                event = dict(event)
                native_result_id = str(
                    event.get("id") or event.get("uuid") or ""
                ).strip()
                event["_numoj_usage_record_id"] = (
                    native_result_id
                    or f"{session_id or resume_session_id or 'claude'}:result:{result_sequence}"
                )
                event["_numoj_emit_result_usage"] = not assistant_usage_since_result
            replayed_uuid = _claude_replayed_user_uuid(event)
            if replayed_uuid and replayed_uuid in waiting_user_acks:
                command_id = waiting_user_acks.pop(replayed_uuid)
                _emit_control(command_id, "accepted")
                if command_id != "__start__":
                    if terminal_failed_while_waiting:
                        pass
                    elif result_waiting_for_replay:
                        result_waiting_for_replay = False
                        terminal_waiting_for_control = False
                        control_drain_deadline = None
            elif (
                event_type == "system"
                and start_uuid in waiting_user_acks
            ):
                # init 只会在 CLI 已解析首条 streaming input 后出现。
                command_id = waiting_user_acks.pop(start_uuid)
                _emit_control(command_id, "accepted")
            elif event_type == "control_response":
                response = event.get("response") if isinstance(event.get("response"), dict) else event
                request_id = str(response.get("request_id") or event.get("request_id") or "")
                command_id = pending_interrupts.pop(request_id, "")
                if command_id:
                    subtype = str(response.get("subtype") or "").lower()
                    rejected = subtype in {"error", "failure", "rejected"}
                    if not rejected:
                        interrupt_accepted = True
                        terminal_status = "interrupted"
                    _emit_control(
                        command_id,
                        "rejected" if rejected else "accepted",
                        str(response.get("error") or "") if rejected else "",
                    )
            pending_followup_ack = any(
                command_id != "__start__"
                for command_id in waiting_user_acks.values()
            )
            if (
                terminal_waiting_for_control
                and not pending_followup_ack
                and not pending_interrupts
                and not result_waiting_for_replay
            ):
                done = True
                continue
            current_terminal = _stream_terminal_status("claude_code", event)
            if current_terminal and interrupt_accepted:
                current_terminal = "interrupted"
            terminal_status = current_terminal or terminal_status
            normalized_done = _normalize_stream_event("claude_code", event)
            if normalized_done:
                assistant_usage_since_result = False
                pending_followup_ack = any(
                    command_id != "__start__"
                    for command_id in waiting_user_acks.values()
                )
                if current_terminal == "failed":
                    terminal_failed_while_waiting = True
                    if pending_followup_ack or pending_interrupts:
                        terminal_waiting_for_control = True
                        control_drain_deadline = (
                            time.monotonic() + CONTROL_ACK_DRAIN_SECONDS
                        )
                    else:
                        done = True
                elif pending_followup_ack:
                    result_waiting_for_replay = True
                    terminal_waiting_for_control = True
                    control_drain_deadline = (
                        time.monotonic() + CONTROL_ACK_DRAIN_SECONDS
                    )
                elif pending_interrupts:
                    terminal_waiting_for_control = True
                    control_drain_deadline = (
                        time.monotonic() + CONTROL_ACK_DRAIN_SECONDS
                    )
                else:
                    done = True
        returncode = (
            2 if terminal_status == "failed"
            else 130 if terminal_status == "interrupted"
            else 0
        )
    except Exception as exc:
        if start_uuid in waiting_user_acks:
            waiting_user_acks.pop(start_uuid, None)
            _emit_control("__start__", "rejected", str(exc))
        print(f"Claude interactive adapter failed: {exc}", file=sys.stderr)
        returncode = 2
    finally:
        for command_id in waiting_user_acks.values():
            _emit_control(command_id, "unknown", "Claude Code 已结束但未回放用户消息")
        for command_id in pending_interrupts.values():
            _emit_control(command_id, "unknown", "Claude Code 已结束但未返回 interrupt 回执")
        try:
            proc.stdin.close()
        except Exception:
            pass
        try:
            proc.wait(timeout=5)
        except Exception:
            try:
                proc.kill()
            except Exception:
                pass
    completed = subprocess.CompletedProcess(stream_args, returncode, "", "")
    completed.aj_session_id = locals().get("session_id", "") or resume_session_id
    return completed


def _run_claude_code(prompt, commands=None):
    audit_read_only = _audit_read_only_enabled()
    try:
        resume_session_id = _resume_session_id_from_env("claude_code")
        _protocol, base_url, api_key, model = _endpoint_settings({"anthropic"})
        context_window_tokens, max_output_tokens, thinking_compatibility = (
            _endpoint_model_capabilities()
        )
        endpoint_thinking_format = _endpoint_thinking_format_env()
        web_search_mcp = _web_search_mcp_settings()
    except ValueError as exc:
        print(f"invalid endpoint configuration: {exc}", file=sys.stderr)
        return 2
    skill_files = _validated_skill_files("claude_code")
    if skill_files is None:
        return 2
    try:
        runtime_root = _runtime_root()
    except ValueError as exc:
        print(f"invalid Agent runtime: {exc}", file=sys.stderr)
        return 2
    env = os.environ.copy()
    env["ANTHROPIC_AUTH_TOKEN"] = api_key
    env["ANTHROPIC_API_KEY"] = api_key
    if runtime_root:
        home = os.path.join(runtime_root, "home")
        os.makedirs(home, exist_ok=True)
        env["HOME"] = home
    if web_search_mcp:
        mcp_runtime_root = runtime_root or "/workspace/.aj-mcp-runtime"
        try:
            mcp_config_path = _write_claude_mcp_config(
                mcp_runtime_root,
                web_search_mcp,
            )
        except OSError as exc:
            print(f"failed to write Claude MCP config: {exc}", file=sys.stderr)
            return 2
    else:
        mcp_config_path = ""
    env["CLAUDE_CODE_MAX_CONTEXT_TOKENS"] = str(context_window_tokens)
    env["CLAUDE_CODE_MAX_OUTPUT_TOKENS"] = str(max_output_tokens)
    # Claude Code 自身会把 custom model 的请求静默压到 128K，并在 streaming
    # 降级时再压到 64K。主流式请求由本地 relay 精确改写；不允许静默降级。
    env["CLAUDE_CODE_DISABLE_NONSTREAMING_FALLBACK"] = "1"
    if context_window_tokens >= CLAUDE_AUTO_COMPACT_MIN_TOKENS:
        env["CLAUDE_CODE_AUTO_COMPACT_WINDOW"] = str(context_window_tokens)
        env.pop("DISABLE_COMPACT", None)
    else:
        # 官方 auto-compact 窗口下限为 100K；更小的管理员声明通过
        # MAX_CONTEXT + 关闭 compact 精确生效，不能静默回到模型目录值。
        env["DISABLE_COMPACT"] = "1"
        env.pop("CLAUDE_CODE_AUTO_COMPACT_WINDOW", None)
    if thinking_compatibility:
        env.pop("CLAUDE_CODE_DISABLE_THINKING", None)
        env.pop("DISABLE_INTERLEAVED_THINKING", None)
    else:
        env["CLAUDE_CODE_DISABLE_THINKING"] = "1"
        env["DISABLE_INTERLEAVED_THINKING"] = "1"
    if audit_read_only:
        args = [
            "claude",
            "--bare",
            "--safe-mode",
            "--disable-slash-commands",
            "--no-session-persistence",
            "--tools", "Read,Glob,Grep",
            "--allowed-tools", "Read,Glob,Grep",
            "--add-dir", "/evidence",
            "--output-format", "json",
            "-p",
        ]
        resume_session_id = ""
    else:
        args = [
            "claude",
            "--dangerously-skip-permissions",
            "--add-dir", "/workspace",
            "--output-format", "json",
            "-p",
        ]
    if resume_session_id and not audit_read_only:
        args.extend(["--resume", resume_session_id])
        if (os.environ.get("AJ_FORK_SESSION") or "1").strip().lower() not in {"0", "false", "no", "off"}:
            args.append("--fork-session")
    if mcp_config_path:
        args.extend(["--strict-mcp-config", "--mcp-config", mcp_config_path])
    cli_model = model
    if (
        cli_model
        and context_window_tokens == CLAUDE_ONE_MILLION_CONTEXT_WINDOW_TOKENS
        and not cli_model.endswith("[1m]")
    ):
        # Claude Code 官方 1M 标记适用于任意模型名；它只作用于本地 CLI，
        # localhost relay 会把上游请求中的 model 恢复为管理员配置的原值。
        cli_model += "[1m]"
    if cli_model:
        args.extend(["--model", cli_model])
    # AJ_EFFORT 控制努力级别（low/medium/high/xhigh/max）。Anthropic claude CLI
    # 用此标志联动 thinking token 预算；不设则用 CLI 默认。我们主要在 reverse
    # 阶段把它调到 high/max，避免 AI 在 thinking 中途被 abort 而不输出代码。
    effort = (os.environ.get("AJ_EFFORT") or "").strip().lower()
    if thinking_compatibility and effort in CLAUDE_EFFORT_LEVELS:
        args.extend(["--effort", effort])
    if commands is None:
        args.append(prompt)
    relay = None
    if endpoint_thinking_format is None:
        relay = _ClaudeEndpointRelay(
            base_url,
            max_output_tokens,
            upstream_model=model,
        )
    else:
        relay = _ClaudeEndpointRelay(
            base_url,
            max_output_tokens,
            endpoint_thinking_format=endpoint_thinking_format,
            thinking_enabled=thinking_compatibility,
            upstream_model=model,
        )
    try:
        env["ANTHROPIC_BASE_URL"] = relay.start()
    except Exception as exc:
        print(f"failed to start Claude endpoint relay: {exc}", file=sys.stderr)
        return 2
    try:
        if commands is not None:
            if audit_read_only:
                _emit_control("__start__", "rejected", "只读审计模式不支持交互控制")
                return 2
            proc = _run_claude_interactive(
                args, env, prompt, commands, resume_session_id,
            )
            _record_session("claude_code", proc, resume_session_id)
            return proc.returncode
        proc = _run(args, env=env)
        _record_session("claude_code", proc, resume_session_id)
        return proc.returncode
    finally:
        if relay is not None:
            relay.stop()


def main():
    harness = (os.environ.get("AJ_HARNESS") or "claude_code").strip().lower().replace("-", "_")
    if harness == "pi_agent":
        harness = "pi"
    commands = None
    if (os.environ.get("AJ_CONTROL_PROTOCOL") or "").strip() == NUMOJ_CONTROL_PROTOCOL:
        start = _read_numoj_start()
        if start is None:
            return 2
        prompt = str(start.get("message") or "")
        task_id = str(start.get("target_task_id") or "").strip()
        if task_id:
            os.environ["AJ_TASK_ID"] = task_id
        commands = _NumOJCommandQueue()
        commands.start()
        os.environ["AJ_INTERACTIVE_SUPPORTED"] = "1"
        os.environ.pop("AJ_INTERACTIVE_UNSUPPORTED_REASON", None)
    else:
        prompt = _prompt_from_env()
    if commands is None:
        if harness == "codex":
            return _run_codex(prompt)
        if harness == "opencode":
            return _run_opencode(prompt)
        if harness == "pi":
            return _run_pi(prompt)
        return _run_claude_code(prompt)
    if harness == "codex":
        return _run_codex(prompt, commands)
    if harness == "opencode":
        return _run_opencode(prompt, commands)
    if harness == "pi":
        return _run_pi(prompt, commands)
    return _run_claude_code(prompt, commands)


if __name__ == "__main__":
    raise SystemExit(main())
