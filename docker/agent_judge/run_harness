# Claude Code 的后台 subagent / Workflow 可能在父模型先产出一次 result 后继续
# 工作。NumOJ 只接受原生 session_state_changed: idle 作为正常轮次结束信号；
# journal / transcript 仅用于展示，不得推断存活或触发额外模型调用。
_TRACE_EVENT_ID_MAX_CHARS = 512
_TRACE_DETAIL_MAX_CHARS = 1200
_TRACE_ASSISTANT_MAX_CHARS = 2 * 1024 * 1024
_TRACE_METADATA_MAX_CHARS = 512
_EMPTY_ASSISTANT_CONTENT_ERROR = (
    "Provider returned error: empty assistant content; retry the request"
)
