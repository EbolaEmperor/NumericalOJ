PI_SESSION_DIR = "/home/node/.pi/agent/sessions"
PI_WEB_SEARCH_MCP_EXTENSION = "/usr/local/share/numoj/pi_web_search_mcp.ts"
WEB_SEARCH_MCP_NAME = "numoj_web_search"
DEFAULT_CONTEXT_WINDOW_TOKENS = 1_000_000
DEFAULT_MAX_OUTPUT_TOKENS = 384_000
DEFAULT_THINKING_COMPATIBILITY = True
