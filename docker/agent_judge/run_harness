def _emit_numoj(payload):
    with _NUMOJ_OUTPUT_LOCK:
        sys.stdout.write(json.dumps(payload, ensure_ascii=False, separators=(",", ":")) + "\n")
        sys.stdout.flush()


def _emit_control(command_id, status, error=""):
    payload = {
        "type": "numoj_control",
        "version": 1,
        "id": str(command_id or ""),
        "status": str(status or ""),
    }
    if error:
        payload["error"] = str(error)
    _emit_numoj(payload)


def _stable_trace_event_id(*values, suffix=""):
    """Return a bounded native identifier suitable for journal deduplication."""

    for value in values:
        text = str(value or "").strip()
        if not text:
            continue
        suffix = str(suffix or "")
        return text[:max(1, _TRACE_EVENT_ID_MAX_CHARS - len(suffix))] + suffix
    return ""


def _emit_trace(
        kind, text, *, title="", meta="", is_error=False, fmt="",
        event_id=""):
    kind = str(kind or "")
    text = str(text or "").strip()
    if not text:
        return
    text_limit = (
        _TRACE_ASSISTANT_MAX_CHARS
        if kind == "assistant" else _TRACE_DETAIL_MAX_CHARS
    )
    if len(text) > text_limit:
        text = text[:max(0, text_limit - 1)] + "…"
    event = {
        "kind": kind,
        "text": text,
    }
    event_id = _stable_trace_event_id(event_id)
    if event_id:
        event["id"] = event_id
    if title:
        event["title"] = str(title)[:_TRACE_METADATA_MAX_CHARS]
    if meta:
        event["meta"] = str(meta)[:_TRACE_METADATA_MAX_CHARS]
    if is_error:
        event["is_error"] = True
    if fmt:
        event["format"] = str(fmt)
    _emit_numoj({"type": "numoj_trace", "version": 1, "event": event})


def _emit_usage(source, usage, record_id=""):
    if not isinstance(usage, dict):
        return
    _emit_numoj({
        "type": "numoj_usage",
        "version": 1,
        "source": str(source or ""),
        "id": str(record_id or ""),
        "usage": usage,
    })


class _NumOJCommandQueue:
    def __init__(self):
        self.items = queue.Queue()
        self.thread = threading.Thread(target=self._read, daemon=True)

    def start(self):
        self.thread.start()

    def _read(self):
        for raw in sys.stdin:
            try:
                command = json.loads(raw)
            except Exception:
                _emit_control("", "rejected", "控制帧不是合法 JSON")
                continue
            if not isinstance(command, dict):
                _emit_control("", "rejected", "控制帧必须是对象")
                continue
            command_id = str(command.get("id") or "").strip()
            command_type = str(command.get("type") or "").strip().lower()
            if not command_id or command_type not in {"steer", "interrupt"}:
                _emit_control(command_id, "rejected", "控制命令缺少 id 或类型无效")
                continue
            if command_type == "steer" and not str(command.get("message") or "").strip():
                _emit_control(command_id, "rejected", "插话消息不能为空")
                continue
            self.items.put(command)

    def drain(self):
        result = []
        while True:
            try:
                result.append(self.items.get_nowait())
            except queue.Empty:
                return result


def _read_numoj_start():
    raw = sys.stdin.readline()
    if not raw:
        _emit_control("__start__", "rejected", "缺少 start 控制帧")
        return None
    try:
        command = json.loads(raw)
    except Exception:
        _emit_control("__start__", "rejected", "start 控制帧不是合法 JSON")
        return None
    if not isinstance(command, dict) or command.get("type") != "start":
        _emit_control(str((command or {}).get("id") or ""), "rejected", "首帧必须是 start")
        return None
    if not str(command.get("message") or "").strip():
        _emit_control(str(command.get("id") or "__start__"), "rejected", "首轮消息不能为空")
        return None
    return command


def _start_json_process(args, env):
    if shutil.which(args[0], path=env.get("PATH")) is None:
        raise RuntimeError(f"{args[0]} CLI is not installed")
    proc = subprocess.Popen(
        args,
        cwd=env.get("AJ_WORKSPACE") or "/workspace",
        env=env,
        stdin=subprocess.PIPE,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        bufsize=1,
    )
    stdout_events = queue.Queue()

    def read_stdout():
        try:
            for line in proc.stdout:
                try:
                    stdout_events.put(json.loads(line))
                except Exception:
                    if line.strip():
                        _emit_trace("tool_result", line, title="Harness 输出", meta=args[0])
        finally:
            stdout_events.put(None)

    def read_stderr():
        for line in proc.stderr:
            sys.stderr.write(line)
            sys.stderr.flush()

    threading.Thread(target=read_stdout, daemon=True).start()
    threading.Thread(target=read_stderr, daemon=True).start()
    return proc, stdout_events


def _write_json(proc, payload):
    proc.stdin.write(json.dumps(payload, ensure_ascii=False, separators=(",", ":")) + "\n")
    proc.stdin.flush()


def _content_blocks(message):
    if not isinstance(message, dict):
        return []
    content = message.get("content")
    if isinstance(content, str):
        return [{"type": "text", "text": content}]
    return content if isinstance(content, list) else []


def _token_count(value):
    if isinstance(value, bool):
        return 0
    try:
        return max(0, int(value or 0))
    except (TypeError, ValueError):
        return 0


def _joined_text(value):
    if isinstance(value, list):
        return "\n\n".join(str(item) for item in value if str(item or "").strip())
    return str(value or "")


def _stream_terminal_status(source, event):
    """返回上游稳定终态；非终态返回空字符串。"""

    if not isinstance(event, dict):
        return ""
    source = str(source or "").strip().lower()
    typ = str(event.get("type") or event.get("method") or "").strip()
    payload = event.get("params") if isinstance(event.get("params"), dict) else event
    if source == "codex" and typ == "turn/completed":
        turn = payload.get("turn") if isinstance(payload.get("turn"), dict) else {}
        status = str(turn.get("status") or "completed").strip().lower()
        if status in {"failed", "interrupted"}:
            return status
        return "completed"
    if source == "claude_code" and typ == "result":
        return "failed" if bool(event.get("is_error")) else "completed"
    if source == "pi" and typ == "agent_settled":
        return "completed"
    return ""


def _pi_event_failure_status(event):
    """记住 Pi 在 agent_settled 前公布的失败或中止原因。"""

    if not isinstance(event, dict):
        return ""
    message = event.get("message") if isinstance(event.get("message"), dict) else {}
    if str(message.get("role") or "") != "assistant":
        return ""
    reason = str(message.get("stopReason") or "").strip().lower()
    if reason in {"aborted", "cancelled", "canceled"}:
        return "interrupted"
    if reason == "error" or str(message.get("errorMessage") or "").strip():
        return "failed"
    return ""


def _normalize_stream_event(source, event, *, active_turn_id=""):
    """把四套上游流事件投影到稳定 journal；返回是否已经到达终态。"""

    if not isinstance(event, dict):
        return False
    source = str(source or "").strip().lower()
    typ = str(event.get("type") or event.get("method") or "").strip()
    payload = event.get("params") if isinstance(event.get("params"), dict) else event

    if source == "codex":
        if typ == "item/completed":
            item = payload.get("item") if isinstance(payload.get("item"), dict) else {}
            item_type = str(item.get("type") or "")
            item_id = _stable_trace_event_id(
                item.get("id"), item.get("callId"), item.get("call_id"),
            )
            if item_type in {"agentMessage", "message"}:
                _emit_trace(
                    "assistant",
                    item.get("text") or item.get("content"),
                    meta="codex",
                    event_id=item_id,
                )
            elif item_type in {"reasoning", "reasoningSummary"}:
                _emit_trace(
                    "thinking",
                    _joined_text(
                        item.get("summary") or item.get("text") or item.get("content")
                    ),
                    meta="codex",
                    event_id=item_id,
                )
            elif item_type == "commandExecution":
                _emit_trace(
                    "tool",
                    item.get("command"),
                    title="执行命令",
                    meta=item.get("cwd") or "Shell",
                    event_id=_stable_trace_event_id(item_id, suffix=":call"),
                )
                _emit_trace(
                    "tool_result",
                    item.get("aggregatedOutput") or item.get("status"),
                    title="命令结果",
                    meta=(
                        f"exit {item.get('exitCode')}"
                        if item.get("exitCode") is not None else item.get("status")
                    ),
                    is_error=str(item.get("status") or "") in {"failed", "declined"},
                    event_id=_stable_trace_event_id(item_id, suffix=":result"),
                )
            elif item_type in {"fileChange", "mcpToolCall", "dynamicToolCall"}:
                name = item.get("tool") or item.get("server") or item_type
                arguments = item.get("arguments")
                if arguments is None:
                    arguments = item.get("changes") or {}
                _emit_trace(
                    "tool",
                    json.dumps(arguments, ensure_ascii=False),
                    title="调用工具",
                    meta=name,
                    fmt="json",
                    event_id=_stable_trace_event_id(item_id, suffix=":call"),
                )
                result = item.get("result")
                if result is None:
                    result = item.get("contentItems") or item.get("status")
                error = item.get("error")
                if error is not None:
                    result = error
                _emit_trace(
                    "tool_result",
                    json.dumps(result, ensure_ascii=False),
                    title="工具结果",
                    meta=name,
                    is_error=bool(error) or str(item.get("status") or "") == "failed",
                    fmt="json",
                    event_id=_stable_trace_event_id(item_id, suffix=":result"),
                )
            elif item_type in {"collabAgentToolCall", "subAgentActivity"}:
                _emit_trace(
                    "subagent",
                    item.get("prompt") or json.dumps(item, ensure_ascii=False),
                    title="派出 subagent",
                    meta=item.get("tool") or item.get("agentPath") or "subagent",
                    event_id=item_id,
                )
        if typ == "thread/tokenUsage/updated":
            event_turn_id = str(payload.get("turnId") or "")
            if not active_turn_id or event_turn_id != str(active_turn_id):
                # thread/resume 会立即回放整个历史的累计 usage；
                # 只接收当前 turn 的 last，保证 journal 是本轮增量。
                return False
            token_usage = (
                payload.get("tokenUsage")
                if isinstance(payload.get("tokenUsage"), dict) else {}
            )
            usage = token_usage.get("last") if isinstance(token_usage.get("last"), dict) else {}
            total_input = _token_count(usage.get("inputTokens"))
            cached = min(total_input, _token_count(usage.get("cachedInputTokens")))
            # total 是单调增长的累计值，纳入 ID 可去掉重放，
            # 同时不会把同一 turn 内的多次模型调用合并掉。
            digest_payload = json.dumps(
                token_usage.get("total") or usage,
                ensure_ascii=False,
                sort_keys=True,
                separators=(",", ":"),
            )
            record_id = (
                event_turn_id + ":" + hashlib.sha256(
                    digest_payload.encode("utf-8", "replace")
                ).hexdigest()[:20]
            )
            _emit_usage("codex", {
                "input_uncached_tokens": total_input - cached,
                "input_cached_tokens": cached,
                "input_cache_write_tokens": 0,
                "output_tokens": _token_count(usage.get("outputTokens")),
                "reasoning_output_tokens": _token_count(
                    usage.get("reasoningOutputTokens")
                ),
            }, record_id)
        if typ == "turn/completed":
            return True
        return False

    if source in {"pi", "claude_code"}:
        message = event.get("message") if isinstance(event.get("message"), dict) else {}
        is_assistant_message = str(message.get("role") or "") == "assistant"
        if (
            (typ == "message_end" and is_assistant_message)
            or (typ == "assistant" and (is_assistant_message or source == "claude_code"))
            or (typ == "message" and is_assistant_message)
        ):
            message_id = _stable_trace_event_id(
                message.get("id"), message.get("responseId"),
                event.get("uuid"), event.get("id"),
            )
            for block_index, block in enumerate(_content_blocks(message)):
                block_type = str(block.get("type") or "")
                block_id = _stable_trace_event_id(
                    block.get("id"),
                    message_id,
                    suffix=f":{block_type or 'block'}:{block_index}",
                )
                if block_type == "text":
                    _emit_trace(
                        "assistant", block.get("text"), meta=source,
                        event_id=block_id,
                    )
                elif block_type in {"thinking", "reasoning"}:
                    _emit_trace(
                        "thinking",
                        block.get("thinking") or block.get("text"),
                        meta=source,
                        event_id=block_id,
                    )
                elif block_type == "tool_use":
                    _emit_trace(
                        "tool",
                        json.dumps(block.get("input") or {}, ensure_ascii=False),
                        title=f"调用 {block.get('name') or '工具'}",
                        meta=block.get("name"),
                        fmt="json",
                        event_id=_stable_trace_event_id(
                            block.get("id"), block_id, suffix=":call",
                        ),
                    )
            usage = message.get("usage") if isinstance(message.get("usage"), dict) else None
            if usage and source == "pi":
                _emit_usage(source, {
                    "input_uncached_tokens": _token_count(usage.get("input_tokens") or usage.get("input")),
                    "input_cached_tokens": _token_count(usage.get("cache_read_input_tokens") or usage.get("cacheRead")),
                    "input_cache_write_tokens": _token_count(usage.get("cache_creation_input_tokens") or usage.get("cacheWrite")),
                    "output_tokens": _token_count(usage.get("output_tokens") or usage.get("output")),
                    "reasoning_output_tokens": _token_count(usage.get("reasoning")),
                }, str(
                    message.get("id") or message.get("responseId")
                    or event.get("uuid") or event.get("id") or ""
                ))
            elif usage and source == "claude_code":
                # Claude 的一个 CLI turn 可能包含多个 assistant/tool 模型
                # 回合。每条 assistant message 的 usage 才是增量；result 上
                # 的 usage 可能是整轮聚合，不能与这些记录重复相加。
                _emit_usage(source, {
                    "input_uncached_tokens": _token_count(
                        usage.get("input_tokens") or usage.get("input")
                    ),
                    "input_cached_tokens": _token_count(
                        usage.get("cache_read_input_tokens")
                        or usage.get("cacheRead")
                    ),
                    "input_cache_write_tokens": _token_count(
                        usage.get("cache_creation_input_tokens")
                        or usage.get("cacheWrite")
                    ),
                    "output_tokens": _token_count(
                        usage.get("output_tokens") or usage.get("output")
                    ),
                    "reasoning_output_tokens": _token_count(
                        usage.get("reasoning")
                    ),
                }, str(
                    message.get("id") or event.get("uuid")
                    or event.get("id") or ""
                ))
        elif typ in {"tool_execution_start", "tool_use"}:
            _emit_trace(
                "tool",
                json.dumps(
                    event.get("args") or event.get("input") or {},
                    ensure_ascii=False,
                ),
                title=f"调用 {event.get('toolName') or event.get('name') or '工具'}",
                meta=event.get("toolName") or event.get("name"),
                fmt="json",
                event_id=_stable_trace_event_id(
                    event.get("toolCallId"), event.get("tool_use_id"),
                    event.get("id"), suffix=":call",
                ),
            )
        elif typ in {"tool_execution_end", "tool_result"}:
            _emit_trace(
                "tool_result",
                event.get("result") or event.get("content") or event.get("output"),
                title="工具结果",
                meta=event.get("toolName") or event.get("name"),
                is_error=bool(event.get("isError")),
                event_id=_stable_trace_event_id(
                    event.get("toolCallId"), event.get("tool_use_id"),
                    event.get("id"), suffix=":result",
                ),
            )
        elif source == "claude_code" and typ == "user":
            # Claude 把工具结果包装在 user role 事件中；它不是 NumOJ 用户
            # 消息 replay，但仍属于工作详情的稳定工具轨迹。
            for block in _content_blocks(message):
                if not isinstance(block, dict) or block.get("type") != "tool_result":
                    continue
                content = block.get("content")
                if not isinstance(content, str):
                    content = json.dumps(content or {}, ensure_ascii=False)
                _emit_trace(
                    "tool_result",
                    content,
                    title="工具结果",
                    meta=block.get("tool_use_id") or "claude_code",
                    is_error=bool(block.get("is_error")),
                    fmt="json" if not isinstance(block.get("content"), str) else "",
                    event_id=_stable_trace_event_id(
                        block.get("tool_use_id"), event.get("uuid"),
                        event.get("id"), suffix=":result",
                    ),
                )
        if source == "pi" and typ == "agent_settled":
            return True
        if source == "claude_code" and typ == "result":
            usage = event.get("usage") if isinstance(event.get("usage"), dict) else None
            if usage and bool(event.get("_numoj_emit_result_usage", True)):
                _emit_usage("claude_code", {
                    "input_uncached_tokens": _token_count(usage.get("input_tokens")),
                    "input_cached_tokens": _token_count(usage.get("cache_read_input_tokens")),
                    "input_cache_write_tokens": _token_count(usage.get("cache_creation_input_tokens")),
                    "output_tokens": _token_count(usage.get("output_tokens")),
                    "reasoning_output_tokens": 0,
                }, str(
                    event.get("id")
                    or event.get("uuid")
                    or event.get("_numoj_usage_record_id")
                    or event.get("session_id")
                    or ""
                ))
            return True
        return False

    if source == "opencode":
        data = event.get("data") if isinstance(event.get("data"), dict) else None
        if data is None and isinstance(event.get("properties"), dict):
            data = event["properties"]
        if data is None:
            data = event
        event_type = str(event.get("type") or "")
        native_event_id = _stable_trace_event_id(
            data.get("id"), event.get("id"), data.get("callID"),
        )
        if event_type == "session.next.text.ended":
            _emit_trace(
                "assistant", data.get("text"), meta="opencode",
                event_id=native_event_id,
            )
        elif event_type == "session.next.reasoning.ended":
            _emit_trace(
                "thinking", data.get("text"), meta="opencode",
                event_id=native_event_id,
            )
        elif event_type == "session.next.tool.called":
            _emit_trace(
                "tool",
                json.dumps(data.get("input") or {}, ensure_ascii=False),
                title=f"调用 {data.get('tool') or '工具'}",
                meta=data.get("tool"),
                fmt="json",
                event_id=_stable_trace_event_id(
                    native_event_id, suffix=":call",
                ),
            )
        elif event_type in {"session.next.tool.success", "session.next.tool.failed"}:
            _emit_trace(
                "tool_result",
                json.dumps(
                    data.get("content") or data.get("error")
                    or data.get("result") or {},
                    ensure_ascii=False,
                ),
                title="工具结果",
                meta=data.get("callID"),
                is_error=event_type.endswith("failed"),
                fmt="json",
                event_id=_stable_trace_event_id(
                    native_event_id, suffix=":result",
                ),
            )
        elif event_type == "session.next.step.failed":
            _emit_trace(
                "tool_result",
                json.dumps(data.get("error") or {}, ensure_ascii=False),
                title="模型调用失败",
                meta="opencode",
                is_error=True,
                fmt="json",
                event_id=native_event_id,
            )
        elif event_type == "session.next.step.ended":
            tokens = data.get("tokens") if isinstance(data.get("tokens"), dict) else {}
            cache = tokens.get("cache") if isinstance(tokens.get("cache"), dict) else {}
            reasoning = _token_count(tokens.get("reasoning"))
            _emit_usage("opencode", {
                "input_uncached_tokens": _token_count(tokens.get("input")),
                "input_cached_tokens": _token_count(cache.get("read")),
                "input_cache_write_tokens": _token_count(cache.get("write")),
                "output_tokens": _token_count(tokens.get("output")) + reasoning,
                "reasoning_output_tokens": reasoning,
            }, str(data.get("assistantMessageID") or event.get("id") or ""))
        # OpenCode 1.18.3 的稳定 V1 Session API 事件。只接收由 adapter
        # 过滤后的当前 assistant part；delta/control/user replay 不进入
        # 规范 journal。
        elif event_type == "message.part.updated":
            part = data.get("part") if isinstance(data.get("part"), dict) else {}
            part_type = str(part.get("type") or "")
            part_id = _stable_trace_event_id(
                part.get("id"), event.get("id"),
            )
            if part_type == "text":
                _emit_trace(
                    "assistant", part.get("text"), meta="opencode",
                    event_id=_stable_trace_event_id(
                        part_id, suffix=":text",
                    ),
                )
            elif part_type == "reasoning":
                _emit_trace(
                    "thinking", part.get("text"), meta="opencode",
                    event_id=_stable_trace_event_id(
                        part_id, suffix=":reasoning",
                    ),
                )
            elif part_type == "tool":
                state = part.get("state") if isinstance(part.get("state"), dict) else {}
                status = str(state.get("status") or "")
                if status == "running":
                    _emit_trace(
                        "tool",
                        json.dumps(state.get("input") or {}, ensure_ascii=False),
                        title=f"调用 {part.get('tool') or '工具'}",
                        meta=part.get("tool"),
                        fmt="json",
                        event_id=_stable_trace_event_id(
                            part_id, part.get("callID"), suffix=":call",
                        ),
                    )
                elif status in {"completed", "error"}:
                    result = state.get("output")
                    if result is None:
                        result = state.get("error") or state.get("metadata") or {}
                    if not isinstance(result, str):
                        result = json.dumps(result, ensure_ascii=False)
                    _emit_trace(
                        "tool_result",
                        result,
                        title=str(state.get("title") or "工具结果"),
                        meta=part.get("callID") or part.get("tool"),
                        is_error=status == "error",
                        fmt="" if isinstance(state.get("output"), str) else "json",
                        event_id=_stable_trace_event_id(
                            part_id, part.get("callID"), suffix=":result",
                        ),
                    )
            elif part_type == "step-finish":
                tokens = part.get("tokens") if isinstance(part.get("tokens"), dict) else {}
                cache = tokens.get("cache") if isinstance(tokens.get("cache"), dict) else {}
                reasoning = _token_count(tokens.get("reasoning"))
                _emit_usage("opencode", {
                    "input_uncached_tokens": _token_count(tokens.get("input")),
                    "input_cached_tokens": _token_count(cache.get("read")),
                    "input_cache_write_tokens": _token_count(cache.get("write")),
                    "output_tokens": _token_count(tokens.get("output")) + reasoning,
                    "reasoning_output_tokens": reasoning,
                }, str(part.get("id") or event.get("id") or ""))
        elif event_type == "session.error":
            error = data.get("error")
            if isinstance(error, dict):
                error_data = error.get("data") if isinstance(error.get("data"), dict) else {}
                text = error_data.get("message") or error.get("message") or error.get("name")
            else:
                text = error
            _emit_trace(
                "tool_result",
                text or "OpenCode 会话失败",
                title="模型调用失败",
                meta="opencode",
                is_error=True,
                event_id=_stable_trace_event_id(
                    data.get("id"), event.get("id"), suffix=":error",
                ),
            )
        # v1 `opencode run --format json` fallback，旧会话只保留 resume，
        # 但仍投影为同一规范 journal。
        elif event_type in {"text", "message"}:
            part = event.get("part") if isinstance(event.get("part"), dict) else event
            _emit_trace(
                "assistant",
                part.get("text") or part.get("content"),
                meta="opencode",
                event_id=_stable_trace_event_id(
                    part.get("id"), event.get("id"), suffix=":text",
                ),
            )
        elif event_type in {"tool_use", "tool"}:
            part = event.get("part") if isinstance(event.get("part"), dict) else event
            _emit_trace(
                "tool",
                json.dumps(part, ensure_ascii=False),
                title=f"调用 {part.get('tool') or part.get('name') or '工具'}",
                meta=part.get("tool") or part.get("name"),
                fmt="json",
                event_id=_stable_trace_event_id(
                    part.get("id"), event.get("id"), suffix=":call",
                ),
            )
        elif event_type == "step_finish":
            part = event.get("part") if isinstance(event.get("part"), dict) else event
            tokens = part.get("tokens") if isinstance(part.get("tokens"), dict) else {}
            cache = tokens.get("cache") if isinstance(tokens.get("cache"), dict) else {}
            reasoning = _token_count(tokens.get("reasoning"))
            _emit_usage("opencode", {
                "input_uncached_tokens": _token_count(tokens.get("input")),
                "input_cached_tokens": _token_count(cache.get("read")),
                "input_cache_write_tokens": _token_count(cache.get("write")),
                "output_tokens": _token_count(tokens.get("output")) + reasoning,
                "reasoning_output_tokens": reasoning,
            }, str(part.get("id") or event.get("id") or ""))
        return False
    return False


def _web_search_mcp_settings():
    url = (os.environ.get("AJ_WEB_SEARCH_MCP_URL") or "").strip()
    authorization = (
        os.environ.get("AJ_WEB_SEARCH_MCP_AUTHORIZATION") or ""
    ).strip()
    if not url and not authorization:
        return None
    if not url or not authorization:
        raise ValueError("Web Search MCP URL and Authorization must be configured together")
    try:
        parsed = urllib.parse.urlsplit(url)
    except ValueError as exc:
        raise ValueError("Web Search MCP URL is invalid") from exc
    if parsed.scheme not in {"http", "https"} or not parsed.netloc:
        raise ValueError("Web Search MCP URL must be an absolute HTTP URL")
    try:
        timeout_seconds = int(
            os.environ.get("AJ_WEB_SEARCH_MCP_TIMEOUT_SECONDS") or 90
        )
    except ValueError as exc:
        raise ValueError("Web Search MCP timeout is invalid") from exc
    timeout_seconds = max(10, min(240, timeout_seconds))
    return {
        "url": url,
        "timeout_seconds": timeout_seconds,
        "timeout_ms": timeout_seconds * 1000,
    }


def _write_claude_mcp_config(runtime_root, settings):
    config_dir = os.path.join(runtime_root, "mcp")
    os.makedirs(config_dir, exist_ok=True)
    config_path = os.path.join(config_dir, "claude-web-search.json")
    config = {
        "mcpServers": {
            WEB_SEARCH_MCP_NAME: {
                "type": "http",
                "url": settings["url"],
                "headers": {
                    "Authorization": "${AJ_WEB_SEARCH_MCP_AUTHORIZATION}",
                },
                "timeout": settings["timeout_ms"],
            },
        },
    }
    with open(config_path, "w", encoding="utf-8") as f:
        json.dump(config, f, ensure_ascii=False)
    return config_path


def _pi_session_header_line(text):
    for raw_line in str(text or "").splitlines(keepends=True):
        try:
            event = json.loads(raw_line.strip())
        except Exception:
            continue
        if not isinstance(event, dict) or event.get("type") != "session":
            continue
        session_id = str(event.get("id") or "").strip()
        if not UUID_RE.fullmatch(session_id):
            continue
        return raw_line if raw_line.endswith(("\n", "\r")) else raw_line + "\n"
    return ""


def _prompt_from_env():
    prompt_file = (os.environ.get("AJ_PROMPT_FILE") or "").strip()
    if prompt_file:
        try:
            with open(prompt_file, "r", encoding="utf-8") as f:
                return f.read()
        except Exception as exc:
            print(f"failed to read AJ_PROMPT_FILE: {exc}", file=sys.stderr)
            return ""
    if _bool_env("AJ_PROMPT_STDIN", False):
        return sys.stdin.read()
    return os.environ.get("AJ_PROMPT") or ""


def _runtime_root():
    raw = (os.environ.get("AJ_RUNTIME_ROOT") or "").strip()
    if not raw:
        return ""
    if not os.path.isabs(raw):
        raise ValueError("AJ_RUNTIME_ROOT must be an absolute path")
    root = os.path.normpath(raw)
    workspace_raw = (os.environ.get("AJ_WORKSPACE") or "").strip()
    if workspace_raw:
        if not os.path.isabs(workspace_raw):
            raise ValueError("AJ_WORKSPACE must be an absolute path")
        workspace = os.path.normpath(workspace_raw)
        if root != workspace and not root.startswith(workspace + os.sep):
            raise ValueError("AJ_RUNTIME_ROOT must stay inside AJ_WORKSPACE")
    return root


def _runtime_path(relative_path, legacy_path):
    root = _runtime_root()
    return os.path.join(root, relative_path) if root else legacy_path


def _enabled_skill_files(harness):
    if not _bool_env("AJ_ENABLE_SKILLS", False):
        return ()
    runtime_root = _runtime_root()
    if not runtime_root:
        raise ValueError("AJ_ENABLE_SKILLS requires AJ_RUNTIME_ROOT")
    relative_roots = {
        "claude_code": os.path.join("home", ".claude", "skills"),
        "codex": os.path.join("home", ".agents", "skills"),
        "opencode": os.path.join("opencode", "config", "opencode", "skills"),
        "pi": os.path.join("pi", "skills"),
    }
    skill_root = os.path.join(runtime_root, relative_roots[harness])
    try:
        names = sorted(os.listdir(skill_root))
    except OSError as exc:
        raise ValueError(f"materialized skill directory is unavailable: {exc}") from exc
    skill_files = []
    canonical_root = os.path.realpath(skill_root)
    for name in names:
        if name in {"", ".", ".."}:
            continue
        skill_dir = os.path.join(skill_root, name)
        skill_file = os.path.join(skill_dir, "SKILL.md")
        if os.path.islink(skill_dir) or os.path.islink(skill_file):
            raise ValueError("materialized skill cannot be a symlink")
        if not os.path.isdir(skill_dir) or not os.path.isfile(skill_file):
            continue
        canonical_file = os.path.realpath(skill_file)
        if not canonical_file.startswith(canonical_root + os.sep):
            raise ValueError("materialized skill escapes its runtime directory")
        skill_files.append(skill_file)
    if len(skill_files) != 1:
        raise ValueError("exactly one materialized skill is required")
    return tuple(skill_files)


def _validated_skill_files(harness):
    try:
        return _enabled_skill_files(harness)
    except ValueError as exc:
        print(f"invalid Agent skill runtime: {exc}", file=sys.stderr)
        return None


def _run(args, env=None, input_text=None, stdout_session_only=False):
    run_env = env or os.environ.copy()
    if shutil.which(args[0], path=run_env.get("PATH")) is None:
        print(f"{args[0]} CLI is not installed in this Agent-as-Judge image", file=sys.stderr)
        return subprocess.CompletedProcess(args, 127, "", "")
    proc = subprocess.Popen(
        args, cwd=run_env.get("AJ_WORKSPACE") or "/workspace", env=run_env,
        stdin=subprocess.PIPE if input_text is not None else None,
        stdout=subprocess.PIPE, stderr=subprocess.PIPE,
        text=True, bufsize=1,
    )
    try:
        capture_limit = max(1024, int(run_env.get("AJ_CAPTURE_MAX_CHARS") or 8 * 1024 * 1024))
    except Exception:
        capture_limit = 8 * 1024 * 1024
    stdout_chunks = deque()
    stderr_chunks = deque()
    captured_sizes = {"stdout": 0, "stderr": 0}
    discovered_session = {"id": ""}
    forwarded_session = {"done": False}

    def _remember(chunks, key, chunk):
        chunks.append(chunk)
        captured_sizes[key] += len(chunk)
        while chunks and captured_sizes[key] > capture_limit:
            overflow = captured_sizes[key] - capture_limit
            if len(chunks[0]) <= overflow:
                captured_sizes[key] -= len(chunks.popleft())
            else:
                chunks[0] = chunks[0][overflow:]
                captured_sizes[key] -= overflow

    def _relay(source, target, chunks, key):
        try:
            for chunk in iter(lambda: source.readline(65536), ""):
                session_header = ""
                if key == "stdout":
                    session_header = _pi_session_header_line(chunk)
                    if not discovered_session["id"]:
                        discovered_session["id"] = (
                            _extract_session_id(session_header or chunk) or ""
                        )
                        if discovered_session["id"]:
                            _record_live_session(
                                discovered_session["id"],
                                env=run_env,
                            )
                _remember(chunks, key, chunk)
                if key == "stdout" and stdout_session_only:
                    if not session_header or forwarded_session["done"]:
                        continue
                    forwarded_session["done"] = True
                    target.write(session_header)
                else:
                    target.write(chunk)
                target.flush()
        finally:
            source.close()

    stdout_thread = threading.Thread(
        target=_relay, args=(proc.stdout, sys.stdout, stdout_chunks, "stdout"), daemon=True,
    )
    stderr_thread = threading.Thread(
        target=_relay, args=(proc.stderr, sys.stderr, stderr_chunks, "stderr"), daemon=True,
    )
    stdout_thread.start()
    stderr_thread.start()
    if input_text is not None:
        try:
            proc.stdin.write(input_text)
            proc.stdin.flush()
        except BrokenPipeError:
            pass
        finally:
            try:
                proc.stdin.close()
            except BrokenPipeError:
                pass
    returncode = proc.wait()
    stdout_thread.join()
    stderr_thread.join()
    completed = subprocess.CompletedProcess(
        args, returncode, "".join(stdout_chunks), "".join(stderr_chunks),
    )
    completed.aj_session_id = discovered_session["id"]
    return completed


def _session_id_from_text(value, harness=None):
    raw = str(value or "")
    normalized_harness = str(harness or "").strip().lower().replace("-", "_")
    if normalized_harness in {"", "opencode"}:
        candidate = raw.strip()
        if OPENCODE_SESSION_ID_RE.fullmatch(candidate):
            return candidate
        match = OPENCODE_SESSION_ID_SEARCH_RE.search(raw)
        if match:
            return match.group(1)
    if normalized_harness != "opencode":
        match = UUID_RE.search(raw)
        if match:
            return match.group(0)
    return None


def _walk_json_session_id(obj, harness=None):
    if isinstance(obj, dict):
        if (
            str(obj.get("type") or "").strip().lower() == "session"
            and isinstance(obj.get("id"), str)
        ):
            found = _session_id_from_text(obj["id"], harness)
            if found:
                return found
        for key, value in obj.items():
            if key in SESSION_KEYS and isinstance(value, str):
                found = _session_id_from_text(value, harness)
                if found:
                    return found
        for value in obj.values():
            found = _walk_json_session_id(value, harness)
            if found:
                return found
    elif isinstance(obj, list):
        for item in obj:
            found = _walk_json_session_id(item, harness)
            if found:
                return found
    return None


def _extract_session_id(text, harness=None):
    text = text or ""
    candidates = []
    stripped = text.strip()
    if stripped:
        candidates.append(stripped)
        candidates.extend(line.strip() for line in stripped.splitlines() if line.strip())
    for candidate in candidates:
        try:
            found = _walk_json_session_id(json.loads(candidate), harness)
            if found:
                return found
        except Exception:
            pass
    normalized_harness = str(harness or "").strip().lower().replace("-", "_")
    if normalized_harness != "opencode":
        labeled = re.search(
            r"(?:session[_ -]?id|thread[_ -]?id|conversation[_ -]?id)[^0-9a-fA-F]{0,16}("
            + UUID_RE.pattern[2:-2] + r")",
            text,
            re.I,
        )
        if labeled:
            return labeled.group(1)
    if normalized_harness in {"", "opencode"}:
        labeled = re.search(
            r"(?:session[_ -]?id|thread[_ -]?id|conversation[_ -]?id)"
            r"[^A-Za-z0-9_-]{0,16}"
            r"(ses_[A-Za-z0-9_-]{1,120})(?![A-Za-z0-9_-])",
            text,
            re.I,
        )
        if labeled:
            return labeled.group(1)
    return None


def _normalize_session_id(value, harness):
    normalized = str(value or "").strip()
    if not normalized:
        return ""
    normalized_harness = str(harness or "").strip().lower().replace("-", "_")
    if normalized_harness == "opencode":
        if not OPENCODE_SESSION_ID_RE.fullmatch(normalized):
            raise ValueError("native OpenCode session id is invalid")
        return normalized
    if not UUID_RE.fullmatch(normalized):
        raise ValueError("native session id must be a UUID")
    return normalized.lower()


def _resume_session_id_from_env(harness):
    return _normalize_session_id(os.environ.get("AJ_RESUME_SESSION_ID"), harness)


def _write_session_event(state_path, event):
    payload = json.dumps(event, ensure_ascii=False).encode("utf-8")

    destination_mode = None
    try:
        destination_stat = os.stat(state_path, follow_symlinks=False)
    except FileNotFoundError:
        pass
    else:
        if stat.S_ISREG(destination_stat.st_mode):
            destination_mode = stat.S_IMODE(destination_stat.st_mode)

    def write_all(fd, data):
        offset = 0
        while offset < len(data):
            offset += os.write(fd, data[offset:])

    temporary_path = (
        f"{state_path}.tmp.{os.getpid()}.{os.urandom(8).hex()}"
    )
    flags = (
        os.O_WRONLY | os.O_CREAT | os.O_EXCL
        | getattr(os, "O_CLOEXEC", 0)
        | getattr(os, "O_NOFOLLOW", 0)
    )
    fd = os.open(temporary_path, flags, 0o600)
    try:
        write_all(fd, payload)
        # bind mount 两端可能使用不同 UID；调用方预先放开的状态文件在
        # 原子替换后仍须保持原权限。首次创建则继续使用私有的 0600。
        if destination_mode is not None:
            os.fchmod(fd, destination_mode)
    finally:
        os.close(fd)
    try:
        os.replace(temporary_path, state_path)
    finally:
        try:
            os.unlink(temporary_path)
        except FileNotFoundError:
            pass

    history_flags = (
        os.O_WRONLY | os.O_CREAT | os.O_APPEND
        | getattr(os, "O_CLOEXEC", 0)
        | getattr(os, "O_NOFOLLOW", 0)
    )
    history_fd = os.open(state_path + "l", history_flags, 0o600)
    try:
        history_stat = os.fstat(history_fd)
        if not stat.S_ISREG(history_stat.st_mode):
            raise OSError("session history is not a regular file")
        write_all(history_fd, payload + b"\n")
    finally:
        os.close(history_fd)


def _record_live_session(session_id, *, env=None):
    """CLI 一公布原生 ID 就落盘，让外部停止仍可恢复已建立的会话。"""

    runtime_env = env or os.environ
    harness = (runtime_env.get("AJ_HARNESS") or "").strip().lower().replace("-", "_")
    if harness == "pi_agent":
        harness = "pi"
    try:
        normalized_session_id = _normalize_session_id(session_id, harness)
        resume_session_id = _normalize_session_id(
            runtime_env.get("AJ_RESUME_SESSION_ID"),
            harness,
        )
        if not normalized_session_id:
            return
        state_path = (
            runtime_env.get("AJ_SESSION_STATE")
            or "/workspace/.aj_session_state.json"
        )
        event = {
            "harness": harness,
            "phase": runtime_env.get("AJ_PHASE") or "",
            "session_id": normalized_session_id,
            "resume_session_id": resume_session_id or "",
            "returncode": None,
            "running": True,
        }
        if runtime_env.get("AJ_CONTROL_PROTOCOL") == NUMOJ_CONTROL_PROTOCOL:
            event["interactive_supported"] = (
                str(runtime_env.get("AJ_INTERACTIVE_SUPPORTED") or "1") == "1"
            )
            reason = str(runtime_env.get("AJ_INTERACTIVE_UNSUPPORTED_REASON") or "").strip()
            if reason:
                event["interactive_unsupported_reason"] = reason
        _write_session_event(state_path, event)
    except Exception as exc:
        # 状态旁路不能阻塞 stdout drain；正常结束时 _record_session 会重试。
        print(f"failed to persist live AJ session state: {exc}", file=sys.stderr)


def _record_session(harness, proc, resume_session_id=None):
    text = (getattr(proc, "stdout", "") or "") + "\n" + (getattr(proc, "stderr", "") or "")
    try:
        session_id = _normalize_session_id(
            _extract_session_id(text, harness)
            or getattr(proc, "aj_session_id", "")
            or (resume_session_id or ""),
            harness,
        )
        resume_session_id = _normalize_session_id(resume_session_id, harness)
    except ValueError as exc:
        print(f"failed to record AJ session state: {exc}", file=sys.stderr)
        return ""
    if not session_id:
        return ""
    state_path = os.environ.get("AJ_SESSION_STATE") or "/workspace/.aj_session_state.json"
    event = {
        "harness": harness,
        "phase": os.environ.get("AJ_PHASE") or "",
        "session_id": session_id,
        "resume_session_id": resume_session_id or "",
        "returncode": int(getattr(proc, "returncode", 0) or 0),
    }
    if os.environ.get("AJ_CONTROL_PROTOCOL") == NUMOJ_CONTROL_PROTOCOL:
        event["interactive_supported"] = (
            str(os.environ.get("AJ_INTERACTIVE_SUPPORTED") or "1") == "1"
        )
        reason = str(os.environ.get("AJ_INTERACTIVE_UNSUPPORTED_REASON") or "").strip()
        if reason:
            event["interactive_unsupported_reason"] = reason
    try:
        _write_session_event(state_path, event)
    except Exception as exc:
        print(f"failed to write AJ session state: {exc}", file=sys.stderr)
    return session_id


def _write_codex_config(
        home, base_url, model, context_window_tokens=None,
        max_output_tokens=None, thinking_compatibility=None,
        web_search_mcp=None):
    os.makedirs(home, exist_ok=True)
    if context_window_tokens is None:
        context_window_tokens = DEFAULT_CONTEXT_WINDOW_TOKENS
    if max_output_tokens is None:
        max_output_tokens = DEFAULT_MAX_OUTPUT_TOKENS
    if thinking_compatibility is None:
        thinking_compatibility = DEFAULT_THINKING_COMPATIBILITY
    # Codex 没有可用的 model_max_output_tokens 配置项。这里的 compact 阈值
    # 为模型输出预留空间；真正的请求输出上限由下方 localhost relay 注入。
    auto_compact_token_limit = max(
        1, int(context_window_tokens) - int(max_output_tokens),
    )
    lines = [
        'model_provider = "aj_openai"',
        f"model_context_window = {int(context_window_tokens)}",
        f"model_auto_compact_token_limit = {auto_compact_token_limit}",
        (
            "model_supports_reasoning_summaries = "
            + ("true" if thinking_compatibility else "false")
        ),
        (
            'model_reasoning_summary = "auto"'
            if thinking_compatibility else 'model_reasoning_summary = "none"'
        ),
        "",
        "[model_providers.aj_openai]",
        'name = "Agent Judge OpenAI Compatible"',
        "base_url = " + json.dumps(base_url),
        'env_key = "AJ_ENDPOINT_API_KEY"',
        # Codex 0.144.5 已删除 chat wire API；自定义 OpenAI-compatible
        # endpoint 统一由下方 localhost relay 把 Responses 请求转换为
        # Chat Completions，不能再把旧 wire_api 配置交给 CLI。
        'wire_api = "responses"',
    ]
    if model:
        lines.insert(0, "model = " + json.dumps(model))
    if web_search_mcp:
        lines.extend([
            "",
            f"[mcp_servers.{WEB_SEARCH_MCP_NAME}]",
            "url = " + json.dumps(web_search_mcp["url"]),
            (
                'env_http_headers = { Authorization = '
                '"AJ_WEB_SEARCH_MCP_AUTHORIZATION" }'
            ),
            f"startup_timeout_sec = {web_search_mcp['timeout_seconds']}",
            f"tool_timeout_sec = {web_search_mcp['timeout_seconds']}",
        ])
    with open(os.path.join(home, "config.toml"), "w", encoding="utf-8") as f:
        f.write("\n".join(lines) + "\n")


def _downgrade_openai_developer_roles(items):
    """兼容端点统一只接收传统的 system/user/assistant/tool 角色。"""
    if not isinstance(items, list):
        return
    for item in items:
        if (
            isinstance(item, dict)
            and str(item.get("role") or "").strip().lower() == "developer"
        ):
            item["role"] = "system"


def _rewrite_codex_request_body(
        path, raw_body, max_output_tokens, thinking_compatibility,
        upstream_model=None, endpoint_thinking_format=None):
    try:
        payload = json.loads(raw_body.decode("utf-8"))
    except Exception:
        return raw_body
    if not isinstance(payload, dict):
        return raw_body
    normalized_path = str(path or "").split("?", 1)[0].rstrip("/")
    if normalized_path.endswith("/responses"):
        _downgrade_openai_developer_roles(payload.get("input"))
        payload["max_output_tokens"] = int(max_output_tokens)
        if upstream_model:
            payload["model"] = str(upstream_model)
        if not thinking_compatibility:
            payload.pop("reasoning", None)
            if isinstance(payload.get("input"), list):
                payload["input"] = [
                    item for item in payload["input"]
                    if not (
                        isinstance(item, dict)
                        and str(item.get("type") or "").lower() == "reasoning"
                    )
                ]
        _apply_endpoint_thinking_fields(
            payload,
            protocol="openai",
            thinking_format=endpoint_thinking_format,
            thinking_enabled=thinking_compatibility,
        )
    elif normalized_path.endswith("/chat/completions"):
        _downgrade_openai_developer_roles(payload.get("messages"))
        payload["max_tokens"] = int(max_output_tokens)
        if upstream_model:
            payload["model"] = str(upstream_model)
        if not thinking_compatibility:
            payload.pop("reasoning_effort", None)
            for message in payload.get("messages") or []:
                if isinstance(message, dict) and message.get("role") == "assistant":
                    message.pop("reasoning_content", None)
                    message.pop("reasoning", None)
        _apply_endpoint_thinking_fields(
            payload,
            protocol="openai",
            thinking_format=endpoint_thinking_format,
            thinking_enabled=thinking_compatibility,
        )
    return json.dumps(payload, ensure_ascii=False, separators=(",", ":")).encode("utf-8")


def _rewrite_claude_request_body(
        path, raw_body, max_output_tokens, endpoint_thinking_format=None,
        thinking_enabled=True, upstream_model=None):
    """只改写 Claude Code 主流式 messages 请求，不抬高内部小请求额度。"""
    try:
        payload = json.loads(raw_body.decode("utf-8"))
    except Exception:
        return raw_body
    if not isinstance(payload, dict):
        return raw_body
    normalized_path = str(path or "").split("?", 1)[0].rstrip("/")
    if normalized_path.endswith("/messages") and payload.get("stream") is True:
        payload["max_tokens"] = int(max_output_tokens)
    if normalized_path.endswith("/messages"):
        if upstream_model:
            payload["model"] = str(upstream_model)
        _apply_endpoint_thinking_fields(
            payload,
            protocol="anthropic",
            thinking_format=endpoint_thinking_format,
            thinking_enabled=thinking_enabled,
        )
    return json.dumps(payload, ensure_ascii=False, separators=(",", ":")).encode("utf-8")


def _apply_endpoint_thinking_fields(
        payload, *, protocol, thinking_format, thinking_enabled):
    """按独立端点冻结的格式改写请求；NULL 时完全保持旧请求行为。"""
    if thinking_format is None:
        return
    if thinking_format not in ENDPOINT_THINKING_FORMATS:
        raise ValueError("unsupported endpoint thinking format")
    payload.pop("enable_thinking", None)
    payload.pop("thinking", None)
    if thinking_format == "none" or not thinking_enabled:
        return
    if thinking_format == "enable_thinking":
        if protocol != "openai":
            raise ValueError("enable_thinking is only valid for OpenAI-compatible endpoints")
        payload["enable_thinking"] = True
        return
    if protocol == "anthropic":
        payload["thinking"] = {"type": "adaptive"}
        return
    # 旧副本可能把 thinking_type 与 OpenAI 协议组合；按当前通用协议契约
    # 收敛成 enable_thinking，而不是继续发送厂商私有的 thinking.type。
    payload["enable_thinking"] = True


def _open_endpoint_request(opener, request):
    task_scope = str(os.environ.get("AJ_TASK_SCOPE") or "").strip().lower()
    if task_scope == PROBLEM_AGENT_TASK_SCOPE:
        return opener.open(request)
    return opener.open(request, timeout=300)


def _codex_response_content_to_chat(content):
    """把 Responses message content 收敛为 Chat Completions content。"""

    if isinstance(content, str):
        return content
    if not isinstance(content, list):
        return ""
    converted = []
    for part in content:
        if not isinstance(part, dict):
            continue
        part_type = str(part.get("type") or "").strip().lower()
        if part_type in {"input_text", "output_text", "text"}:
            converted.append({"type": "text", "text": str(part.get("text") or "")})
        elif part_type in {"input_image", "image_url"}:
            image_url = part.get("image_url") or part.get("url")
            if isinstance(image_url, dict):
                image_url = image_url.get("url")
            if image_url:
                converted.append({"type": "image_url", "image_url": {"url": str(image_url)}})
    if not converted:
        return ""
    if all(item.get("type") == "text" for item in converted):
        return "".join(str(item.get("text") or "") for item in converted)
    return converted


def _codex_responses_request_to_chat(raw_body):
    """把 Codex 0.144.5 的 Responses 请求转换到通用 Chat 接口。"""

    payload = json.loads(raw_body.decode("utf-8"))
    if not isinstance(payload, dict):
        raise ValueError("Codex Responses 请求必须是对象")
    messages = []
    instructions = payload.get("instructions")
    if instructions:
        messages.append({"role": "system", "content": str(instructions)})
    for item in payload.get("input") or []:
        if not isinstance(item, dict):
            continue
        item_type = str(item.get("type") or "").strip().lower()
        role = str(item.get("role") or "").strip().lower()
        if item_type in {"message", ""} and role:
            if role == "developer":
                role = "system"
            if role not in {"system", "user", "assistant", "tool"}:
                continue
            messages.append({
                "role": role,
                "content": _codex_response_content_to_chat(item.get("content")),
            })
        elif item_type == "function_call":
            call = {
                "id": str(item.get("call_id") or item.get("id") or ""),
                "type": "function",
                "function": {
                    "name": str(item.get("name") or ""),
                    "arguments": str(item.get("arguments") or "{}"),
                },
            }
            if messages and messages[-1].get("role") == "assistant":
                messages[-1].setdefault("tool_calls", []).append(call)
            else:
                messages.append({"role": "assistant", "content": None, "tool_calls": [call]})
        elif item_type == "function_call_output":
            output = item.get("output")
            if not isinstance(output, str):
                output = json.dumps(
                    output if output is not None else "",
                    ensure_ascii=False,
                    separators=(",", ":"),
                )
            messages.append({
                "role": "tool",
                "tool_call_id": str(item.get("call_id") or ""),
                "content": output,
            })
        elif item_type in {"custom_tool_call", "custom_tool_call_output"}:
            # Chat Completions 没有 freeform custom tool 的等价历史格式。
            # 不能把已经发生的 apply_patch 调用静默删除后继续生成。
            raise ValueError(
                f"Chat 兼容节点不能恢复 Codex {item_type} 历史；"
                "请在支持 Responses API 的节点继续该原生会话"
            )
        # reasoning 和客户端内部引用不属于兼容端点的可见消息。

    chat = {
        "model": str(payload.get("model") or ""),
        "messages": messages,
        "stream": True,
        "stream_options": {"include_usage": True},
        "max_tokens": int(payload.get("max_output_tokens") or DEFAULT_MAX_OUTPUT_TOKENS),
    }
    tools = []
    for tool in payload.get("tools") or []:
        if not isinstance(tool, dict):
            continue
        tool_type = str(tool.get("type") or "").strip().lower()
        if tool_type == "custom" and str(tool.get("name") or "") == "apply_patch":
            # Chat Completions 无法无损表达 freeform grammar tool；能力列表
            # 已经足以告诉模型该工具不可用，不额外改写原生 system prompt。
            continue
        if tool_type == "namespace":
            # Chat Completions 没有 Responses namespace tool 的返回类型；
            # 若直接展平，function_call 名称又无法无损映射回 namespace。
            # 保留普通 function tools 的单 Agent 能力，不追加隐藏提示词。
            continue
        if tool_type in {"web_search", "web_search_preview"}:
            continue
        if tool_type != "function":
            raise ValueError(
                f"Chat 兼容节点不支持 Codex Responses tool type: "
                f"{tool_type or 'unknown'}"
                f" (name={str(tool.get('name') or '')[:80]}, "
                f"keys={','.join(sorted(str(key) for key in tool))[:240]})"
            )
        function = {
            "name": str(tool.get("name") or ""),
            "description": str(tool.get("description") or ""),
            "parameters": tool.get("parameters") if isinstance(tool.get("parameters"), dict) else {},
        }
        if tool.get("strict") is not None:
            function["strict"] = bool(tool.get("strict"))
        tools.append({"type": "function", "function": function})
    if tools:
        chat["tools"] = tools
        tool_choice = payload.get("tool_choice")
        if isinstance(tool_choice, dict) and tool_choice.get("type") == "function":
            chat["tool_choice"] = {
                "type": "function",
                "function": {"name": str(tool_choice.get("name") or "")},
            }
        elif tool_choice is not None:
            chat["tool_choice"] = tool_choice
        if payload.get("parallel_tool_calls") is not None:
            chat["parallel_tool_calls"] = bool(payload.get("parallel_tool_calls"))
    reasoning = payload.get("reasoning") if isinstance(payload.get("reasoning"), dict) else {}
    if reasoning.get("effort"):
        chat["reasoning_effort"] = str(reasoning["effort"])
    for field in (
        "enable_thinking", "thinking", "temperature", "top_p",
        "service_tier", "user",
    ):
        if payload.get(field) is not None:
            chat[field] = payload[field]
    return json.dumps(chat, ensure_ascii=False, separators=(",", ":")).encode("utf-8")


def _codex_response_sse_event(event):
    event_type = str(event.get("type") or "")
    data = json.dumps(event, ensure_ascii=False, separators=(",", ":"))
    return f"event: {event_type}\ndata: {data}\n\n".encode("utf-8")


def _relay_upstream_url(base_url, request_target):
    """将 relay 请求路径追加到端点，同时保留两侧 query。"""

    base = urllib.parse.urlsplit(str(base_url or "").strip())
    target = urllib.parse.urlsplit(str(request_target or ""))
    base_path = (base.path or "").rstrip("/")
    target_path = "/" + str(target.path or "").lstrip("/")
    if target_path.startswith("/v1/") and base_path.lower().endswith("/v1"):
        target_path = target_path[len("/v1"):]
    query = "&".join(
        part for part in (base.query, target.query) if str(part or "")
    )
    return urllib.parse.urlunsplit((
        base.scheme,
        base.netloc,
        base_path + target_path,
        query,
        "",
    ))


class _CodexEndpointRelay:
    """为 Codex 补齐上游未暴露的输出上限与 thinking 兼容开关。"""

    _MAX_REQUEST_BYTES = 64 * 1024 * 1024

    class _RejectRedirects(urllib.request.HTTPRedirectHandler):
        """端点凭证只允许发送给管理员配置的原始 origin。"""

        def redirect_request(self, req, fp, code, msg, headers, newurl):
            return None

    def __init__(
            self, base_url, max_output_tokens, thinking_compatibility,
            upstream_model=None, endpoint_thinking_format=None):
        self.base_url = str(base_url or "").strip()
        self.max_output_tokens = int(max_output_tokens)
        self.thinking_compatibility = bool(thinking_compatibility)
        self.upstream_model = str(upstream_model or "").strip()
        self.endpoint_thinking_format = endpoint_thinking_format
        self.server = None
        self.thread = None

    def _rewrite_request_body(self, path, body):
        return _rewrite_codex_request_body(
            path, body, self.max_output_tokens,
            self.thinking_compatibility, self.upstream_model,
            self.endpoint_thinking_format,
        )

    def start(self):
        relay = self

        class Handler(http.server.BaseHTTPRequestHandler):
            protocol_version = "HTTP/1.0"

            def log_message(self, _format, *_args):
                return

            def do_GET(self):
                self._forward()

            def do_POST(self):
                self._forward()

            def _send_json_error(self, status, message):
                error = json.dumps(
                    {"error": str(message or "upstream request failed")},
                    ensure_ascii=False,
                ).encode("utf-8")
                self.send_response(int(status))
                self.send_header("Content-Type", "application/json")
                self.send_header("Content-Length", str(len(error)))
                self.end_headers()
                self.wfile.write(error)

            def _forward(self):
                try:
                    content_length = int(self.headers.get("Content-Length") or 0)
                except (TypeError, ValueError):
                    content_length = 0
                if content_length < 0 or content_length > relay._MAX_REQUEST_BYTES:
                    self.send_error(413)
                    return
                body = self.rfile.read(content_length) if content_length else b""
                if body:
                    body = relay._rewrite_request_body(self.path, body)
                normalized_path = self.path.split("?", 1)[0].rstrip("/")
                translate_codex = (
                    self.command == "POST"
                    and normalized_path.endswith("/responses")
                    and type(relay) is _CodexEndpointRelay
                )
                upstream_path = self.path
                if translate_codex:
                    try:
                        body = _codex_responses_request_to_chat(body)
                    except Exception as exc:
                        print(
                            f"Codex Responses bridge rejected request: {exc}",
                            file=sys.stderr,
                        )
                        self._send_json_error(400, str(exc))
                        return
                    suffix = self.path[len(normalized_path):]
                    upstream_path = normalized_path[:-len("/responses")] + "/chat/completions" + suffix
                headers = {
                    key: value
                    for key, value in self.headers.items()
                    if key.lower() not in {
                        "connection", "content-length", "host", "transfer-encoding",
                    }
                }
                request = urllib.request.Request(
                    _relay_upstream_url(relay.base_url, upstream_path),
                    data=body if self.command != "GET" else None,
                    headers=headers,
                    method=self.command,
                )
                try:
                    opener = urllib.request.build_opener(relay._RejectRedirects())
                    response = _open_endpoint_request(opener, request)
                except urllib.error.HTTPError as exc:
                    if 300 <= int(exc.code) < 400:
                        exc.close()
                        self._send_json_error(
                            502, "upstream redirects are refused",
                        )
                        return
                    response = exc
                except Exception as exc:
                    self._send_json_error(502, str(exc))
                    return
                with response:
                    if translate_codex and int(response.status) < 300:
                        content_type = str(
                            response.headers.get("Content-Type") or ""
                        ).split(";", 1)[0].strip().lower()
                        content_encoding = str(
                            response.headers.get("Content-Encoding") or ""
                        ).strip().lower()
                        if content_encoding not in {"", "identity"}:
                            self._send_json_error(
                                502,
                                "Chat 兼容节点返回了不支持的压缩 SSE",
                            )
                            return
                        if content_type != "text/event-stream":
                            preview = response.read(64 * 1024)
                            detail = "Chat 兼容节点没有返回 SSE"
                            try:
                                upstream_error = json.loads(
                                    preview.decode("utf-8", "replace")
                                )
                                if isinstance(upstream_error, dict):
                                    raw_error = upstream_error.get("error")
                                    if isinstance(raw_error, dict):
                                        raw_error = raw_error.get("message")
                                    if raw_error:
                                        detail += f"：{raw_error}"
                            except Exception:
                                pass
                            self._send_json_error(502, detail)
                            return
                        self._forward_chat_as_responses(response)
                        return
                    self.send_response(int(response.status))
                    for key, value in response.headers.items():
                        if key.lower() not in {
                            "connection", "content-length", "transfer-encoding",
                        }:
                            self.send_header(key, value)
                    self.end_headers()
                    while True:
                        chunk = response.read(64 * 1024)
                        if not chunk:
                            break
                        self.wfile.write(chunk)
                        self.wfile.flush()

            def _forward_chat_as_responses(self, response):
                self.send_response(200)
                self.send_header("Content-Type", "text/event-stream")
                self.send_header("Cache-Control", "no-cache")
                self.end_headers()
                response_id = "resp_numoj_" + uuid.uuid4().hex
                message_id = "msg_numoj_" + uuid.uuid4().hex
                created = False
                message_started = False
                text_parts = []
                reasoning_parts = []
                tool_calls = {}
                usage = {}
                sequence_number = 0
                saw_chat_chunk = False
                saw_done = False
                saw_success_finish = False
                incomplete_finish_reason = ""

                def emit(event):
                    nonlocal sequence_number
                    event = dict(event)
                    event.setdefault("sequence_number", sequence_number)
                    sequence_number += 1
                    self.wfile.write(_codex_response_sse_event(event))
                    self.wfile.flush()

                def emit_failure(message, code="upstream_error"):
                    nonlocal created
                    message = str(message or "Chat 兼容节点返回流式错误")
                    if not created:
                        emit({
                            "type": "response.created",
                            "response": {
                                "id": response_id,
                                "status": "in_progress",
                            },
                        })
                        created = True
                    emit({
                        "type": "error",
                        "code": str(code or "upstream_error"),
                        "message": message,
                        "param": None,
                    })
                    emit({
                        "type": "response.failed",
                        "response": {
                            "id": response_id,
                            "status": "failed",
                            "error": {
                                "code": str(code or "upstream_error"),
                                "message": message,
                            },
                        },
                    })

                def start_message():
                    nonlocal message_started
                    if message_started:
                        return
                    message_started = True
                    emit({
                        "type": "response.output_item.added",
                        "output_index": 0,
                        "item": {
                            "type": "message",
                            "role": "assistant",
                            "id": message_id,
                            "status": "in_progress",
                            "content": [],
                        },
                    })
                    emit({
                        "type": "response.content_part.added",
                        "output_index": 0,
                        "item_id": message_id,
                        "content_index": 0,
                        "part": {"type": "output_text", "text": ""},
                    })

                for raw_line in response:
                    line = raw_line.strip()
                    if not line.startswith(b"data:"):
                        continue
                    raw_data = line[5:].strip()
                    if raw_data == b"[DONE]":
                        saw_done = True
                        break
                    try:
                        chunk = json.loads(raw_data.decode("utf-8"))
                    except Exception:
                        continue
                    if not isinstance(chunk, dict):
                        continue
                    upstream_error = chunk.get("error")
                    if upstream_error:
                        if isinstance(upstream_error, dict):
                            error_message = (
                                upstream_error.get("message")
                                or upstream_error.get("code")
                                or json.dumps(upstream_error, ensure_ascii=False)
                            )
                            error_code = upstream_error.get("code")
                        else:
                            error_message = upstream_error
                            error_code = "upstream_error"
                        emit_failure(error_message, error_code)
                        return
                    saw_chat_chunk = True
                    upstream_id = str(chunk.get("id") or "").strip()
                    if upstream_id and not created:
                        response_id = upstream_id
                    if not created:
                        emit({"type": "response.created", "response": {"id": response_id}})
                        created = True
                    if isinstance(chunk.get("usage"), dict):
                        usage = chunk["usage"]
                    choices = chunk.get("choices") if isinstance(chunk.get("choices"), list) else []
                    if not choices or not isinstance(choices[0], dict):
                        continue
                    finish_reason = str(
                        choices[0].get("finish_reason") or ""
                    ).strip().lower()
                    if finish_reason in {"stop", "tool_calls", "function_call"}:
                        saw_success_finish = True
                    elif finish_reason:
                        incomplete_finish_reason = finish_reason
                    delta = choices[0].get("delta") if isinstance(choices[0].get("delta"), dict) else {}
                    content = delta.get("content")
                    if content:
                        content = str(content)
                        text_parts.append(content)
                        start_message()
                        emit({
                            "type": "response.output_text.delta",
                            "output_index": 0,
                            "item_id": message_id,
                            "content_index": 0,
                            "delta": content,
                        })
                    reasoning = delta.get("reasoning_content") or delta.get("reasoning")
                    if reasoning:
                        reasoning_parts.append(str(reasoning))
                    for partial in delta.get("tool_calls") or []:
                        if not isinstance(partial, dict):
                            continue
                        index = int(partial.get("index") or 0)
                        stored = tool_calls.setdefault(index, {
                            "id": "",
                            "name": "",
                            "arguments": "",
                        })
                        if partial.get("id"):
                            stored["id"] = str(partial["id"])
                        function = partial.get("function") if isinstance(partial.get("function"), dict) else {}
                        if function.get("name"):
                            stored["name"] += str(function["name"])
                        if function.get("arguments"):
                            stored["arguments"] += str(function["arguments"])

                if not saw_chat_chunk:
                    emit_failure(
                        "Chat 兼容节点返回了空的或无法解析的 SSE",
                        "invalid_upstream_stream",
                    )
                    return
                if incomplete_finish_reason:
                    emit_failure(
                        "Chat 兼容节点未正常完成"
                        f"（finish_reason={incomplete_finish_reason}）",
                        "incomplete_upstream_stream",
                    )
                    return
                if not saw_done and not saw_success_finish:
                    emit_failure(
                        "Chat 兼容节点在稳定终态前中断了 SSE",
                        "incomplete_upstream_stream",
                    )
                    return
                if not created:
                    emit({"type": "response.created", "response": {"id": response_id}})
                if reasoning_parts:
                    emit({
                        "type": "response.output_item.done",
                        "item": {
                            "type": "reasoning",
                            "id": "rs_numoj_" + uuid.uuid4().hex,
                            "summary": [{
                                "type": "summary_text",
                                "text": "".join(reasoning_parts),
                            }],
                        },
                    })
                if text_parts:
                    text = "".join(text_parts)
                    emit({
                        "type": "response.output_text.done",
                        "output_index": 0,
                        "item_id": message_id,
                        "content_index": 0,
                        "text": text,
                    })
                    emit({
                        "type": "response.content_part.done",
                        "output_index": 0,
                        "item_id": message_id,
                        "content_index": 0,
                        "part": {"type": "output_text", "text": text},
                    })
                    emit({
                        "type": "response.output_item.done",
                        "output_index": 0,
                        "item": {
                            "type": "message",
                            "role": "assistant",
                            "id": message_id,
                            "status": "completed",
                            "content": [{
                                "type": "output_text",
                                "text": text,
                            }],
                        },
                    })
                for index in sorted(tool_calls):
                    call = tool_calls[index]
                    call_id = call["id"] or "call_numoj_" + uuid.uuid4().hex
                    emit({
                        "type": "response.output_item.done",
                        "item": {
                            "type": "function_call",
                            "id": "fc_numoj_" + uuid.uuid4().hex,
                            "call_id": call_id,
                            "name": call["name"],
                            "arguments": call["arguments"] or "{}",
                        },
                    })
                input_tokens = _token_count(
                    usage.get("prompt_tokens", usage.get("input_tokens"))
                )
                output_tokens = _token_count(
                    usage.get("completion_tokens", usage.get("output_tokens"))
                )
                details = usage.get("prompt_tokens_details")
                if not isinstance(details, dict):
                    details = usage.get("input_tokens_details")
                cached_tokens = _token_count(
                    (details or {}).get("cached_tokens")
                    if isinstance(details, dict) else 0
                )
                output_details = usage.get("completion_tokens_details")
                if not isinstance(output_details, dict):
                    output_details = usage.get("output_tokens_details")
                reasoning_tokens = _token_count(
                    (output_details or {}).get("reasoning_tokens")
                    if isinstance(output_details, dict) else 0
                )
                emit({
                    "type": "response.completed",
                    "response": {
                        "id": response_id,
                        "usage": {
                            "input_tokens": input_tokens,
                            "input_tokens_details": {"cached_tokens": cached_tokens},
                            "output_tokens": output_tokens,
                            "output_tokens_details": {
                                "reasoning_tokens": reasoning_tokens,
                            },
                            "total_tokens": input_tokens + output_tokens,
                        },
                    },
                })

        self.server = http.server.ThreadingHTTPServer(("127.0.0.1", 0), Handler)
        self.server.daemon_threads = True
        self.thread = threading.Thread(target=self.server.serve_forever, daemon=True)
        self.thread.start()
        return f"http://127.0.0.1:{self.server.server_port}"

    def stop(self):
        if self.server is not None:
            self.server.shutdown()
            self.server.server_close()
        if self.thread is not None:
            self.thread.join(timeout=2)


class _ClaudeEndpointRelay(_CodexEndpointRelay):
    """让 Claude Code 的主流式请求精确使用管理员声明的输出上限。"""

    def __init__(
            self, base_url, max_output_tokens, endpoint_thinking_format=None,
            thinking_enabled=True, upstream_model=None):
        super().__init__(
            base_url,
            max_output_tokens=max_output_tokens,
            thinking_compatibility=thinking_enabled,
            upstream_model=upstream_model,
            endpoint_thinking_format=endpoint_thinking_format,
        )

    def _rewrite_request_body(self, path, body):
        return _rewrite_claude_request_body(
            path, body, self.max_output_tokens,
            self.endpoint_thinking_format,
            self.thinking_compatibility,
            self.upstream_model,
        )


class _EndpointThinkingRelay(_CodexEndpointRelay):
    """为任意 harness 注入统一端点契约中的协议级思考字段。"""

    def __init__(self, base_url, protocol, endpoint_thinking_format, thinking_enabled):
        super().__init__(
            base_url,
            max_output_tokens=DEFAULT_MAX_OUTPUT_TOKENS,
            thinking_compatibility=thinking_enabled,
            endpoint_thinking_format=endpoint_thinking_format,
        )
        self.protocol = protocol

    def _rewrite_request_body(self, path, body):
        try:
            payload = json.loads(body.decode("utf-8"))
        except Exception:
            return body
        if not isinstance(payload, dict):
            return body
        normalized_path = str(path or "").split("?", 1)[0].rstrip("/")
        expected_suffix = "/messages" if self.protocol == "anthropic" else "/chat/completions"
        if not normalized_path.endswith(expected_suffix):
            return body
        _apply_endpoint_thinking_fields(
            payload,
            protocol=self.protocol,
            thinking_format=self.endpoint_thinking_format,
            thinking_enabled=self.thinking_compatibility,
        )
        return json.dumps(payload, ensure_ascii=False, separators=(",", ":")).encode("utf-8")


def _audit_read_only_enabled():
    return (os.environ.get("AJ_AUDIT_READ_ONLY") or "").strip().lower() in {
        "1", "true", "yes", "on",
    }


def _endpoint_settings(allowed_protocols):
    """读取四套 harness 共用的唯一端点接口。"""

    protocol = (os.environ.get("AJ_ENDPOINT_PROTOCOL") or "").strip().lower()
    base_url = (os.environ.get("AJ_ENDPOINT_BASE_URL") or "").strip()
    api_key = (os.environ.get("AJ_ENDPOINT_API_KEY") or "").strip()
    model = (os.environ.get("AJ_ENDPOINT_MODEL") or "").strip()
    if protocol not in allowed_protocols:
        raise ValueError("endpoint protocol is not supported by the selected harness")
    if not base_url or not api_key or not model:
        raise ValueError("endpoint Base URL, API Key, and model are required")
    return protocol, base_url, api_key, model


def _codex_rpc_call(
        proc, events, request_id, method, params, *, deferred_events=None):
    _write_json(proc, {"method": method, "id": request_id, "params": params})
    while True:
        event = events.get(timeout=30)
        if event is None:
            raise RuntimeError(f"Codex app-server 在 {method} 响应前退出")
        if event.get("id") == request_id:
            if isinstance(event.get("error"), dict):
                raise RuntimeError(str(event["error"].get("message") or event["error"]))
            return event.get("result") if isinstance(event.get("result"), dict) else {}
        if isinstance(deferred_events, list):
            deferred_events.append(event)
        else:
            _normalize_stream_event("codex", event)


def _run_codex_interactive(prompt, commands, env, resume_session_id, model):
    proc, events = _start_json_process(
        ["codex", "app-server", "--listen", "stdio://"], env,
    )
    pending = {}
    start_accepted = False
    try:
        _codex_rpc_call(proc, events, "numoj-init", "initialize", {
            "clientInfo": {
                "name": "numoj",
                "title": "NumericalOJ Agent",
                "version": "1",
            },
            "capabilities": None,
        })
        _write_json(proc, {"method": "initialized", "params": {}})
        thread_method = "thread/resume" if resume_session_id else "thread/start"
        thread_params = {
            "cwd": "/workspace",
            "model": model,
            "approvalPolicy": "never",
            "sandbox": "danger-full-access",
        }
        if resume_session_id:
            thread_params["threadId"] = resume_session_id
        thread_result = _codex_rpc_call(
            proc, events, "numoj-thread", thread_method, thread_params,
        )
        thread = thread_result.get("thread") if isinstance(thread_result.get("thread"), dict) else {}
        thread_id = str(thread.get("id") or resume_session_id or "")
        if not thread_id:
            raise RuntimeError("Codex app-server 没有返回 thread id")
        _record_live_session(thread_id, env=env)
        deferred_turn_events = []
        turn_result = _codex_rpc_call(
            proc,
            events,
            "numoj-turn",
            "turn/start",
            {
                "threadId": thread_id,
                "clientUserMessageId": "__start__",
                "input": [{"type": "text", "text": prompt, "text_elements": []}],
            },
            deferred_events=deferred_turn_events,
        )
        turn = turn_result.get("turn") if isinstance(turn_result.get("turn"), dict) else {}
        turn_id = str(turn.get("id") or "")
        if not turn_id:
            raise RuntimeError("Codex app-server 没有返回 active turn id")
        _emit_control("__start__", "accepted")
        start_accepted = True

        done = False
        terminal_status = ""
        for event in deferred_turn_events:
            terminal_status = (
                _stream_terminal_status("codex", event) or terminal_status
            )
            done = (
                _normalize_stream_event(
                    "codex", event, active_turn_id=turn_id,
                ) or done
            )
        control_drain_deadline = None
        while True:
            if done:
                if not pending:
                    break
                if (
                    control_drain_deadline is not None
                    and time.monotonic() >= control_drain_deadline
                ):
                    break
            else:
                pending_commands = commands.drain()
            for command in ([] if done else pending_commands):
                command_id = str(command.get("id") or "")
                rpc_id = "numoj-command-" + command_id
                if command.get("type") == "steer":
                    method = "turn/steer"
                    params = {
                        "threadId": thread_id,
                        "expectedTurnId": turn_id,
                        "clientUserMessageId": command_id,
                        "input": [{
                            "type": "text",
                            "text": str(command.get("message") or ""),
                            "text_elements": [],
                        }],
                    }
                else:
                    method = "turn/interrupt"
                    params = {"threadId": thread_id, "turnId": turn_id}
                pending[rpc_id] = command_id
                try:
                    _write_json(proc, {"method": method, "id": rpc_id, "params": params})
                except (BrokenPipeError, OSError) as exc:
                    pending.pop(rpc_id, None)
                    _emit_control(command_id, "unknown", str(exc))
            try:
                timeout = 0.1
                if done and control_drain_deadline is not None:
                    timeout = max(
                        0.001,
                        min(timeout, control_drain_deadline - time.monotonic()),
                    )
                event = events.get(timeout=timeout)
            except queue.Empty:
                if done:
                    continue
                if proc.poll() is not None:
                    raise RuntimeError("Codex app-server 意外退出")
                continue
            if event is None:
                if done:
                    break
                raise RuntimeError("Codex app-server 意外退出")
            response_id = str(event.get("id") or "")
            if response_id in pending:
                command_id = pending.pop(response_id)
                error = event.get("error") if isinstance(event.get("error"), dict) else None
                _emit_control(
                    command_id,
                    "rejected" if error else "accepted",
                    str((error or {}).get("message") or ""),
                )
                continue
            terminal_status = (
                _stream_terminal_status("codex", event) or terminal_status
            )
            done = _normalize_stream_event(
                "codex", event, active_turn_id=turn_id,
            ) or done
            if done and pending and control_drain_deadline is None:
                # app-server 的 turn/completed 与同一 turn 的控制 RPC 响应
                # 来自不同通知通道，终态可能先到。给已发送命令一个短暂、
                # 有界的回执排空窗口，避免把成功 steer/interrupt 误标 unknown。
                control_drain_deadline = (
                    time.monotonic() + CONTROL_ACK_DRAIN_SECONDS
                )
        returncode = (
            2 if terminal_status == "failed"
            else 130 if terminal_status == "interrupted"
            else 0
        )
    except Exception as exc:
        if not start_accepted:
            _emit_control("__start__", "rejected", str(exc))
        print(f"Codex interactive adapter failed: {exc}", file=sys.stderr)
        returncode = 2
    finally:
        for command_id in pending.values():
            _emit_control(command_id, "unknown", "Codex turn 已结束但未返回控制回执")
        try:
            proc.stdin.close()
        except Exception:
            pass
        try:
            proc.terminate()
            proc.wait(timeout=5)
        except Exception:
            try:
                proc.kill()
            except Exception:
                pass
    completed = subprocess.CompletedProcess(proc.args, returncode, "", "")
    completed.aj_session_id = locals().get("thread_id", "")
    return completed


def _run_codex(prompt, commands=None):
    try:
        resume_session_id = _resume_session_id_from_env("codex")
        _protocol, base_url, api_key, model = _endpoint_settings({"openai"})
        context_window_tokens, max_output_tokens, thinking_compatibility = (
            _endpoint_model_capabilities()
        )
        endpoint_thinking_format = _endpoint_thinking_format_env()
        web_search_mcp = _web_search_mcp_settings()
    except ValueError as exc:
        print(f"invalid endpoint configuration: {exc}", file=sys.stderr)
        return 2
    skill_files = _validated_skill_files("codex")
    if skill_files is None:
        return 2
    try:
        home = _runtime_path("codex", "/workspace/.codex")
    except ValueError as exc:
        print(f"invalid Agent runtime: {exc}", file=sys.stderr)
        return 2
    if endpoint_thinking_format is None:
        relay = _CodexEndpointRelay(
            base_url, max_output_tokens, thinking_compatibility,
            upstream_model=model,
        )
    else:
        relay = _CodexEndpointRelay(
            base_url, max_output_tokens, thinking_compatibility,
            upstream_model=model,
            endpoint_thinking_format=endpoint_thinking_format,
        )
    try:
        relay_base_url = relay.start()
        _write_codex_config(
            home, relay_base_url, model,
            context_window_tokens=context_window_tokens,
            max_output_tokens=max_output_tokens,
            thinking_compatibility=thinking_compatibility,
            web_search_mcp=web_search_mcp,
        )
        env = os.environ.copy()
        env["CODEX_HOME"] = home
        audit_read_only = _audit_read_only_enabled()
        if commands is not None and audit_read_only:
            _emit_control("__start__", "rejected", "只读审计模式不支持交互控制")
            return 2
        if commands is not None:
            proc = _run_codex_interactive(
                prompt, commands, env, resume_session_id, model,
            )
            _record_session("codex", proc, resume_session_id)
            return proc.returncode
        if resume_session_id and not audit_read_only:
            args = [
                "codex", "exec", "resume",
                "--json",
                "--skip-git-repo-check",
                "--dangerously-bypass-approvals-and-sandbox",
                resume_session_id,
                "-",
            ]
        elif audit_read_only:
            args = [
                "codex", "exec",
                "--json",
                "--skip-git-repo-check",
                "--sandbox", "read-only",
                "--cd", "/workspace",
                "-",
            ]
            resume_session_id = ""
        else:
            args = [
                "codex", "exec",
                "--json",
                "--skip-git-repo-check",
                "--dangerously-bypass-approvals-and-sandbox",
                "--cd", "/workspace",
                "-",
            ]
        proc = _run(args, env, input_text=prompt)
        _record_session("codex", proc, resume_session_id)
        return proc.returncode
    finally:
        # Codex 会在 CODEX_HOME/tmp/arg0 创建指向镜像内 helper 的绝对
        # symlink。这些文件只服务当前进程，不能进入可恢复 checkpoint；
        # sessions、sqlite 和配置等持久原生状态仍完整保留。
        try:
            shutil.rmtree(os.path.join(home, "tmp"))
        except FileNotFoundError:
            pass
        except OSError as exc:
            print(f"failed to clean Codex ephemeral runtime: {exc}", file=sys.stderr)
        relay.stop()


def _opencode_config_content(
        base_url, api_key_env, model_id, audit_read_only=False,
        context_window_tokens=None, max_output_tokens=None,
        thinking_compatibility=None, web_search_mcp=None):
