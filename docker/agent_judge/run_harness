def _web_search_mcp_settings():
    url = (os.environ.get("AJ_WEB_SEARCH_MCP_URL") or "").strip()
    authorization = (
        os.environ.get("AJ_WEB_SEARCH_MCP_AUTHORIZATION") or ""
    ).strip()
    if not url and not authorization:
        return None
    if not url or not authorization:
        raise ValueError("Web Search MCP URL and Authorization must be configured together")
    try:
        parsed = urllib.parse.urlsplit(url)
    except ValueError as exc:
        raise ValueError("Web Search MCP URL is invalid") from exc
    if parsed.scheme not in {"http", "https"} or not parsed.netloc:
        raise ValueError("Web Search MCP URL must be an absolute HTTP URL")
    try:
        timeout_seconds = int(
            os.environ.get("AJ_WEB_SEARCH_MCP_TIMEOUT_SECONDS") or 90
        )
    except ValueError as exc:
        raise ValueError("Web Search MCP timeout is invalid") from exc
    timeout_seconds = max(10, min(240, timeout_seconds))
    return {
        "url": url,
        "timeout_seconds": timeout_seconds,
        "timeout_ms": timeout_seconds * 1000,
    }


def _write_claude_mcp_config(runtime_root, settings):
    config_dir = os.path.join(runtime_root, "mcp")
    os.makedirs(config_dir, exist_ok=True)
    config_path = os.path.join(config_dir, "claude-web-search.json")
    config = {
        "mcpServers": {
            WEB_SEARCH_MCP_NAME: {
                "type": "http",
                "url": settings["url"],
                "headers": {
                    "Authorization": "${AJ_WEB_SEARCH_MCP_AUTHORIZATION}",
                },
                "timeout": settings["timeout_ms"],
            },
        },
    }
    with open(config_path, "w", encoding="utf-8") as f:
        json.dump(config, f, ensure_ascii=False)
    return config_path


def _pi_session_header_line(text):
    for raw_line in str(text or "").splitlines(keepends=True):
        try:
            event = json.loads(raw_line.strip())
        except Exception:
            continue
        if not isinstance(event, dict) or event.get("type") != "session":
            continue
        session_id = str(event.get("id") or "").strip()
        if not UUID_RE.fullmatch(session_id):
            continue
        return raw_line if raw_line.endswith(("\n", "\r")) else raw_line + "\n"
    return ""


def _prompt_from_env():
    prompt_file = (os.environ.get("AJ_PROMPT_FILE") or "").strip()
    if prompt_file:
        try:
            with open(prompt_file, "r", encoding="utf-8") as f:
                return f.read()
        except Exception as exc:
            print(f"failed to read AJ_PROMPT_FILE: {exc}", file=sys.stderr)
            return ""
    if _bool_env("AJ_PROMPT_STDIN", False):
        return sys.stdin.read()
    return os.environ.get("AJ_PROMPT") or ""


def _runtime_root():
    raw = (os.environ.get("AJ_RUNTIME_ROOT") or "").strip()
    if not raw:
        return ""
    if not os.path.isabs(raw):
        raise ValueError("AJ_RUNTIME_ROOT must be an absolute path")
    root = os.path.normpath(raw)
    workspace_raw = (os.environ.get("AJ_WORKSPACE") or "").strip()
    if workspace_raw:
        if not os.path.isabs(workspace_raw):
            raise ValueError("AJ_WORKSPACE must be an absolute path")
        workspace = os.path.normpath(workspace_raw)
        if root != workspace and not root.startswith(workspace + os.sep):
            raise ValueError("AJ_RUNTIME_ROOT must stay inside AJ_WORKSPACE")
    return root


def _runtime_path(relative_path, legacy_path):
    root = _runtime_root()
    return os.path.join(root, relative_path) if root else legacy_path


def _enabled_skill_files(harness):
    if not _bool_env("AJ_ENABLE_SKILLS", False):
        return ()
    runtime_root = _runtime_root()
    if not runtime_root:
        raise ValueError("AJ_ENABLE_SKILLS requires AJ_RUNTIME_ROOT")
    relative_roots = {
        "claude_code": os.path.join("home", ".claude", "skills"),
        "codex": os.path.join("home", ".agents", "skills"),
        "opencode": os.path.join("opencode", "config", "opencode", "skills"),
        "pi": os.path.join("pi", "skills"),
    }
    skill_root = os.path.join(runtime_root, relative_roots[harness])
    try:
        names = sorted(os.listdir(skill_root))
    except OSError as exc:
        raise ValueError(f"materialized skill directory is unavailable: {exc}") from exc
    skill_files = []
    canonical_root = os.path.realpath(skill_root)
    for name in names:
        if name in {"", ".", ".."}:
            continue
        skill_dir = os.path.join(skill_root, name)
        skill_file = os.path.join(skill_dir, "SKILL.md")
        if os.path.islink(skill_dir) or os.path.islink(skill_file):
            raise ValueError("materialized skill cannot be a symlink")
        if not os.path.isdir(skill_dir) or not os.path.isfile(skill_file):
            continue
        canonical_file = os.path.realpath(skill_file)
        if not canonical_file.startswith(canonical_root + os.sep):
            raise ValueError("materialized skill escapes its runtime directory")
        skill_files.append(skill_file)
    if len(skill_files) != 1:
        raise ValueError("exactly one materialized skill is required")
    return tuple(skill_files)


def _validated_skill_files(harness):
    try:
        return _enabled_skill_files(harness)
    except ValueError as exc:
        print(f"invalid Agent skill runtime: {exc}", file=sys.stderr)
        return None


def _run(args, env=None, input_text=None, stdout_session_only=False):
    run_env = env or os.environ.copy()
    if shutil.which(args[0], path=run_env.get("PATH")) is None:
        print(f"{args[0]} CLI is not installed in this Agent-as-Judge image", file=sys.stderr)
        return subprocess.CompletedProcess(args, 127, "", "")
    proc = subprocess.Popen(
        args, cwd=run_env.get("AJ_WORKSPACE") or "/workspace", env=run_env,
        stdin=subprocess.PIPE if input_text is not None else None,
        stdout=subprocess.PIPE, stderr=subprocess.PIPE,
        text=True, bufsize=1,
    )
    try:
        capture_limit = max(1024, int(run_env.get("AJ_CAPTURE_MAX_CHARS") or 8 * 1024 * 1024))
    except Exception:
        capture_limit = 8 * 1024 * 1024
    stdout_chunks = deque()
    stderr_chunks = deque()
    captured_sizes = {"stdout": 0, "stderr": 0}
    discovered_session = {"id": ""}
    forwarded_session = {"done": False}

    def _remember(chunks, key, chunk):
        chunks.append(chunk)
        captured_sizes[key] += len(chunk)
        while chunks and captured_sizes[key] > capture_limit:
            overflow = captured_sizes[key] - capture_limit
            if len(chunks[0]) <= overflow:
                captured_sizes[key] -= len(chunks.popleft())
            else:
                chunks[0] = chunks[0][overflow:]
                captured_sizes[key] -= overflow

    def _relay(source, target, chunks, key):
        try:
            for chunk in iter(lambda: source.readline(65536), ""):
                session_header = ""
                if key == "stdout":
                    session_header = _pi_session_header_line(chunk)
                    if not discovered_session["id"]:
                        discovered_session["id"] = (
                            _extract_session_id(session_header or chunk) or ""
                        )
                        if discovered_session["id"]:
                            _record_live_session(
                                discovered_session["id"],
                                env=run_env,
                            )
                _remember(chunks, key, chunk)
                if key == "stdout" and stdout_session_only:
                    if not session_header or forwarded_session["done"]:
                        continue
                    forwarded_session["done"] = True
                    target.write(session_header)
                else:
                    target.write(chunk)
                target.flush()
        finally:
            source.close()

    stdout_thread = threading.Thread(
        target=_relay, args=(proc.stdout, sys.stdout, stdout_chunks, "stdout"), daemon=True,
    )
    stderr_thread = threading.Thread(
        target=_relay, args=(proc.stderr, sys.stderr, stderr_chunks, "stderr"), daemon=True,
    )
    stdout_thread.start()
    stderr_thread.start()
    if input_text is not None:
        try:
            proc.stdin.write(input_text)
            proc.stdin.flush()
        except BrokenPipeError:
            pass
        finally:
            try:
                proc.stdin.close()
            except BrokenPipeError:
                pass
    returncode = proc.wait()
    stdout_thread.join()
    stderr_thread.join()
    completed = subprocess.CompletedProcess(
        args, returncode, "".join(stdout_chunks), "".join(stderr_chunks),
    )
    completed.aj_session_id = discovered_session["id"]
    return completed


def _session_id_from_text(value, harness=None):
    raw = str(value or "")
    normalized_harness = str(harness or "").strip().lower().replace("-", "_")
    if normalized_harness in {"", "opencode"}:
        candidate = raw.strip()
        if OPENCODE_SESSION_ID_RE.fullmatch(candidate):
            return candidate
        match = OPENCODE_SESSION_ID_SEARCH_RE.search(raw)
        if match:
            return match.group(1)
    if normalized_harness != "opencode":
        match = UUID_RE.search(raw)
        if match:
            return match.group(0)
    return None


def _walk_json_session_id(obj, harness=None):
    if isinstance(obj, dict):
        if (
            str(obj.get("type") or "").strip().lower() == "session"
            and isinstance(obj.get("id"), str)
        ):
            found = _session_id_from_text(obj["id"], harness)
            if found:
                return found
        for key, value in obj.items():
            if key in SESSION_KEYS and isinstance(value, str):
                found = _session_id_from_text(value, harness)
                if found:
                    return found
        for value in obj.values():
            found = _walk_json_session_id(value, harness)
            if found:
                return found
    elif isinstance(obj, list):
        for item in obj:
            found = _walk_json_session_id(item, harness)
            if found:
                return found
    return None


def _extract_session_id(text, harness=None):
    text = text or ""
    candidates = []
    stripped = text.strip()
    if stripped:
        candidates.append(stripped)
        candidates.extend(line.strip() for line in stripped.splitlines() if line.strip())
    for candidate in candidates:
        try:
            found = _walk_json_session_id(json.loads(candidate), harness)
            if found:
                return found
        except Exception:
            pass
    normalized_harness = str(harness or "").strip().lower().replace("-", "_")
    if normalized_harness != "opencode":
        labeled = re.search(
            r"(?:session[_ -]?id|thread[_ -]?id|conversation[_ -]?id)[^0-9a-fA-F]{0,16}("
            + UUID_RE.pattern[2:-2] + r")",
            text,
            re.I,
        )
        if labeled:
            return labeled.group(1)
    if normalized_harness in {"", "opencode"}:
        labeled = re.search(
            r"(?:session[_ -]?id|thread[_ -]?id|conversation[_ -]?id)"
            r"[^A-Za-z0-9_-]{0,16}"
            r"(ses_[A-Za-z0-9_-]{1,120})(?![A-Za-z0-9_-])",
            text,
            re.I,
        )
        if labeled:
            return labeled.group(1)
    return None


def _normalize_session_id(value, harness):
    normalized = str(value or "").strip()
    if not normalized:
        return ""
    normalized_harness = str(harness or "").strip().lower().replace("-", "_")
    if normalized_harness == "opencode":
        if not OPENCODE_SESSION_ID_RE.fullmatch(normalized):
            raise ValueError("native OpenCode session id is invalid")
        return normalized
    if not UUID_RE.fullmatch(normalized):
        raise ValueError("native session id must be a UUID")
    return normalized.lower()


def _resume_session_id_from_env(harness):
    return _normalize_session_id(os.environ.get("AJ_RESUME_SESSION_ID"), harness)


def _write_session_event(state_path, event):
    payload = json.dumps(event, ensure_ascii=False).encode("utf-8")

    destination_mode = None
    try:
        destination_stat = os.stat(state_path, follow_symlinks=False)
    except FileNotFoundError:
        pass
    else:
        if stat.S_ISREG(destination_stat.st_mode):
            destination_mode = stat.S_IMODE(destination_stat.st_mode)

    def write_all(fd, data):
        offset = 0
        while offset < len(data):
            offset += os.write(fd, data[offset:])

    temporary_path = (
        f"{state_path}.tmp.{os.getpid()}.{os.urandom(8).hex()}"
    )
    flags = (
        os.O_WRONLY | os.O_CREAT | os.O_EXCL
        | getattr(os, "O_CLOEXEC", 0)
        | getattr(os, "O_NOFOLLOW", 0)
    )
    fd = os.open(temporary_path, flags, 0o600)
    try:
        write_all(fd, payload)
        # bind mount 两端可能使用不同 UID；调用方预先放开的状态文件在
        # 原子替换后仍须保持原权限。首次创建则继续使用私有的 0600。
        if destination_mode is not None:
            os.fchmod(fd, destination_mode)
    finally:
        os.close(fd)
    try:
        os.replace(temporary_path, state_path)
    finally:
        try:
            os.unlink(temporary_path)
        except FileNotFoundError:
            pass

    history_flags = (
        os.O_WRONLY | os.O_CREAT | os.O_APPEND
        | getattr(os, "O_CLOEXEC", 0)
        | getattr(os, "O_NOFOLLOW", 0)
    )
    history_fd = os.open(state_path + "l", history_flags, 0o600)
    try:
        history_stat = os.fstat(history_fd)
        if not stat.S_ISREG(history_stat.st_mode):
            raise OSError("session history is not a regular file")
        write_all(history_fd, payload + b"\n")
    finally:
        os.close(history_fd)


def _record_live_session(session_id, *, env=None):
    """CLI 一公布原生 ID 就落盘，让外部停止仍可恢复已建立的会话。"""

    runtime_env = env or os.environ
    harness = (runtime_env.get("AJ_HARNESS") or "").strip().lower().replace("-", "_")
    if harness == "pi_agent":
        harness = "pi"
    try:
        normalized_session_id = _normalize_session_id(session_id, harness)
        resume_session_id = _normalize_session_id(
            runtime_env.get("AJ_RESUME_SESSION_ID"),
            harness,
        )
        if not normalized_session_id:
            return
        state_path = (
            runtime_env.get("AJ_SESSION_STATE")
            or "/workspace/.aj_session_state.json"
        )
        _write_session_event(state_path, {
            "harness": harness,
            "phase": runtime_env.get("AJ_PHASE") or "",
            "session_id": normalized_session_id,
            "resume_session_id": resume_session_id or "",
            "returncode": None,
            "running": True,
        })
    except Exception as exc:
        # 状态旁路不能阻塞 stdout drain；正常结束时 _record_session 会重试。
        print(f"failed to persist live AJ session state: {exc}", file=sys.stderr)


def _record_session(harness, proc, resume_session_id=None):
    text = (getattr(proc, "stdout", "") or "") + "\n" + (getattr(proc, "stderr", "") or "")
    try:
        session_id = _normalize_session_id(
            _extract_session_id(text, harness)
            or getattr(proc, "aj_session_id", "")
            or (resume_session_id or ""),
            harness,
        )
        resume_session_id = _normalize_session_id(resume_session_id, harness)
    except ValueError as exc:
        print(f"failed to record AJ session state: {exc}", file=sys.stderr)
        return ""
    if not session_id:
        return ""
    state_path = os.environ.get("AJ_SESSION_STATE") or "/workspace/.aj_session_state.json"
    event = {
        "harness": harness,
        "phase": os.environ.get("AJ_PHASE") or "",
        "session_id": session_id,
        "resume_session_id": resume_session_id or "",
        "returncode": int(getattr(proc, "returncode", 0) or 0),
    }
    try:
        _write_session_event(state_path, event)
    except Exception as exc:
        print(f"failed to write AJ session state: {exc}", file=sys.stderr)
    return session_id


def _normalize_pi_session_id(value):
    normalized = str(value or "").strip().lower()
    return normalized if UUID_RE.fullmatch(normalized) else ""


def _pi_session_candidates(session_root, expected_session_id):
    """在 Pi 的受限 session 树内查找与当前 UUID 对应的原生 JSONL。"""

    expected_session_id = _normalize_pi_session_id(expected_session_id)
    if not expected_session_id:
        return []
    pending = [(session_root, 0)]
    candidates = []
    scanned = 0
    while pending and scanned < PI_SESSION_SCAN_ENTRY_LIMIT:
        current, depth = pending.pop()
        try:
            entries = os.scandir(current)
        except OSError:
            continue
        with entries:
            for entry in entries:
                scanned += 1
                if scanned > PI_SESSION_SCAN_ENTRY_LIMIT:
                    break
                try:
                    if entry.is_dir(follow_symlinks=False):
                        if depth < 2:
                            pending.append((entry.path, depth + 1))
                        continue
                    if (
                        not entry.name.endswith(".jsonl")
                        or expected_session_id not in entry.name.lower()
                        or not entry.is_file(follow_symlinks=False)
                    ):
                        continue
                    candidates.append((
                        entry.stat(follow_symlinks=False).st_mtime_ns,
                        entry.path,
                    ))
                except OSError:
                    continue
    return [path for _mtime, path in sorted(candidates, reverse=True)]


def _latest_pi_terminal_state(session_root, expected_session_id):
    """读取指定 Pi 会话最末 assistant 的两种原生终止原因。"""

    expected_session_id = _normalize_pi_session_id(expected_session_id)
    if not expected_session_id or not os.path.isdir(session_root):
        return None
    for path in _pi_session_candidates(session_root, expected_session_id):
        try:
            with open(path, "rb") as stream:
                header_line = stream.readline(PI_SESSION_HEADER_MAX_BYTES + 1)
                if len(header_line) > PI_SESSION_HEADER_MAX_BYTES:
                    continue
                try:
                    header = json.loads(header_line.decode("utf-8", "replace"))
                except Exception:
                    continue
                if (
                    not isinstance(header, dict)
                    or header.get("type") != "session"
                    or _normalize_pi_session_id(header.get("id"))
                    != expected_session_id
                ):
                    continue

                file_size = os.fstat(stream.fileno()).st_size
                tail_start = max(0, file_size - PI_SESSION_TAIL_MAX_BYTES)
                stream.seek(tail_start)
                payload = stream.read(PI_SESSION_TAIL_MAX_BYTES)
                if tail_start:
                    first_newline = payload.find(b"\n")
                    if first_newline < 0:
                        continue
                    payload = payload[first_newline + 1:]

                for raw_line in reversed(payload.splitlines()):
                    if not raw_line or len(raw_line) > PI_SESSION_EVENT_MAX_BYTES:
                        continue
                    try:
                        event = json.loads(raw_line.decode("utf-8", "replace"))
                    except Exception:
                        continue
                    if not isinstance(event, dict) or event.get("type") != "message":
                        continue
                    message = event.get("message")
                    if not isinstance(message, dict):
                        continue
                    if str(message.get("role") or "").strip().lower() != "assistant":
                        continue
                    return {
                        "stop_reason": str(
                            message.get("stopReason") or ""
                        ).strip().lower(),
                        "raw_stop_reason": str(
                            message.get("rawStopReason") or ""
                        ).strip().lower(),
                        "event_digest": hashlib.sha256(raw_line).hexdigest(),
                    }
        except OSError:
            continue
    return None


def _pi_hit_output_limit(terminal_state):
    state = terminal_state if isinstance(terminal_state, dict) else {}
    return (
        state.get("stop_reason") == "length"
        or state.get("raw_stop_reason") == "max_tokens"
    )


def _pi_terminal_advanced(previous, current):
    if not isinstance(current, dict):
        return False
    if not isinstance(previous, dict):
        return True
    previous_digest = str(previous.get("event_digest") or "")
    current_digest = str(current.get("event_digest") or "")
    return bool(current_digest and current_digest != previous_digest)


def _write_codex_config(
        home, base_url, model, context_window_tokens=None,
        max_output_tokens=None, thinking_compatibility=None,
        web_search_mcp=None):
    os.makedirs(home, exist_ok=True)
    if context_window_tokens is None:
        context_window_tokens = DEFAULT_CONTEXT_WINDOW_TOKENS
    if max_output_tokens is None:
        max_output_tokens = DEFAULT_MAX_OUTPUT_TOKENS
    if thinking_compatibility is None:
        thinking_compatibility = DEFAULT_THINKING_COMPATIBILITY
    # Codex 没有可用的 model_max_output_tokens 配置项。这里的 compact 阈值
    # 为模型输出预留空间；真正的请求输出上限由下方 localhost relay 注入。
    auto_compact_token_limit = max(
        1, int(context_window_tokens) - int(max_output_tokens),
    )
    lines = [
        'model_provider = "aj_openai"',
        f"model_context_window = {int(context_window_tokens)}",
        f"model_auto_compact_token_limit = {auto_compact_token_limit}",
        (
            "model_supports_reasoning_summaries = "
            + ("true" if thinking_compatibility else "false")
        ),
        (
            'model_reasoning_summary = "auto"'
            if thinking_compatibility else 'model_reasoning_summary = "none"'
        ),
        "",
        "[model_providers.aj_openai]",
        'name = "Agent Judge OpenAI Compatible"',
        "base_url = " + json.dumps(base_url),
        'env_key = "AJ_ENDPOINT_API_KEY"',
        'wire_api = "chat"',
    ]
    if model:
        lines.insert(0, "model = " + json.dumps(model))
    if web_search_mcp:
        lines.extend([
            "",
            f"[mcp_servers.{WEB_SEARCH_MCP_NAME}]",
            "url = " + json.dumps(web_search_mcp["url"]),
            (
                'env_http_headers = { Authorization = '
                '"AJ_WEB_SEARCH_MCP_AUTHORIZATION" }'
            ),
            f"startup_timeout_sec = {web_search_mcp['timeout_seconds']}",
            f"tool_timeout_sec = {web_search_mcp['timeout_seconds']}",
        ])
    with open(os.path.join(home, "config.toml"), "w", encoding="utf-8") as f:
        f.write("\n".join(lines) + "\n")


def _downgrade_openai_developer_roles(items):
    """兼容端点统一只接收传统的 system/user/assistant/tool 角色。"""
    if not isinstance(items, list):
        return
    for item in items:
        if (
            isinstance(item, dict)
            and str(item.get("role") or "").strip().lower() == "developer"
        ):
            item["role"] = "system"


def _rewrite_codex_request_body(
        path, raw_body, max_output_tokens, thinking_compatibility,
        upstream_model=None, endpoint_thinking_format=None):
    try:
        payload = json.loads(raw_body.decode("utf-8"))
    except Exception:
        return raw_body
    if not isinstance(payload, dict):
        return raw_body
    normalized_path = str(path or "").split("?", 1)[0].rstrip("/")
    if normalized_path.endswith("/responses"):
        _downgrade_openai_developer_roles(payload.get("input"))
        payload["max_output_tokens"] = int(max_output_tokens)
        if upstream_model:
            payload["model"] = str(upstream_model)
        if not thinking_compatibility:
            payload.pop("reasoning", None)
            if isinstance(payload.get("input"), list):
                payload["input"] = [
                    item for item in payload["input"]
                    if not (
                        isinstance(item, dict)
                        and str(item.get("type") or "").lower() == "reasoning"
                    )
                ]
        _apply_endpoint_thinking_fields(
            payload,
            protocol="openai",
            thinking_format=endpoint_thinking_format,
            thinking_enabled=thinking_compatibility,
        )
    elif normalized_path.endswith("/chat/completions"):
        _downgrade_openai_developer_roles(payload.get("messages"))
        payload["max_tokens"] = int(max_output_tokens)
        if upstream_model:
            payload["model"] = str(upstream_model)
        if not thinking_compatibility:
            payload.pop("reasoning_effort", None)
            for message in payload.get("messages") or []:
                if isinstance(message, dict) and message.get("role") == "assistant":
                    message.pop("reasoning_content", None)
                    message.pop("reasoning", None)
        _apply_endpoint_thinking_fields(
            payload,
            protocol="openai",
            thinking_format=endpoint_thinking_format,
            thinking_enabled=thinking_compatibility,
        )
    return json.dumps(payload, ensure_ascii=False, separators=(",", ":")).encode("utf-8")


def _rewrite_claude_request_body(
        path, raw_body, max_output_tokens, endpoint_thinking_format=None,
        thinking_enabled=True, upstream_model=None):
    """只改写 Claude Code 主流式 messages 请求，不抬高内部小请求额度。"""
    try:
        payload = json.loads(raw_body.decode("utf-8"))
    except Exception:
        return raw_body
    if not isinstance(payload, dict):
        return raw_body
    normalized_path = str(path or "").split("?", 1)[0].rstrip("/")
    if normalized_path.endswith("/messages") and payload.get("stream") is True:
        payload["max_tokens"] = int(max_output_tokens)
    if normalized_path.endswith("/messages"):
        if upstream_model:
            payload["model"] = str(upstream_model)
        _apply_endpoint_thinking_fields(
            payload,
            protocol="anthropic",
            thinking_format=endpoint_thinking_format,
            thinking_enabled=thinking_enabled,
        )
    return json.dumps(payload, ensure_ascii=False, separators=(",", ":")).encode("utf-8")


def _apply_endpoint_thinking_fields(
        payload, *, protocol, thinking_format, thinking_enabled):
    """按独立端点冻结的格式改写请求；NULL 时完全保持旧请求行为。"""
    if thinking_format is None:
        return
    if thinking_format not in ENDPOINT_THINKING_FORMATS:
        raise ValueError("unsupported endpoint thinking format")
    payload.pop("enable_thinking", None)
    payload.pop("thinking", None)
    if thinking_format == "none" or not thinking_enabled:
        return
    if thinking_format == "enable_thinking":
        if protocol != "openai":
            raise ValueError("enable_thinking is only valid for OpenAI-compatible endpoints")
        payload["enable_thinking"] = True
        return
    if protocol == "anthropic":
        payload["thinking"] = {"type": "adaptive"}
        return
    # 旧副本可能把 thinking_type 与 OpenAI 协议组合；按当前通用协议契约
    # 收敛成 enable_thinking，而不是继续发送厂商私有的 thinking.type。
    payload["enable_thinking"] = True


def _open_endpoint_request(opener, request):
    task_scope = str(os.environ.get("AJ_TASK_SCOPE") or "").strip().lower()
    if task_scope == PROBLEM_AGENT_TASK_SCOPE:
        return opener.open(request)
    return opener.open(request, timeout=300)


class _CodexEndpointRelay:
    """为 Codex 补齐上游未暴露的输出上限与 thinking 兼容开关。"""

    _MAX_REQUEST_BYTES = 64 * 1024 * 1024

    class _RejectRedirects(urllib.request.HTTPRedirectHandler):
        """端点凭证只允许发送给管理员配置的原始 origin。"""

        def redirect_request(self, req, fp, code, msg, headers, newurl):
            return None

    def __init__(
            self, base_url, max_output_tokens, thinking_compatibility,
            upstream_model=None, endpoint_thinking_format=None):
        self.base_url = str(base_url or "").rstrip("/")
        self.max_output_tokens = int(max_output_tokens)
        self.thinking_compatibility = bool(thinking_compatibility)
        self.upstream_model = str(upstream_model or "").strip()
        self.endpoint_thinking_format = endpoint_thinking_format
        self.server = None
        self.thread = None

    def _rewrite_request_body(self, path, body):
        return _rewrite_codex_request_body(
            path, body, self.max_output_tokens,
            self.thinking_compatibility, self.upstream_model,
            self.endpoint_thinking_format,
        )

    def start(self):
        relay = self

        class Handler(http.server.BaseHTTPRequestHandler):
            protocol_version = "HTTP/1.0"

            def log_message(self, _format, *_args):
                return

            def do_GET(self):
                self._forward()

            def do_POST(self):
                self._forward()

            def _forward(self):
                try:
                    content_length = int(self.headers.get("Content-Length") or 0)
                except (TypeError, ValueError):
                    content_length = 0
                if content_length < 0 or content_length > relay._MAX_REQUEST_BYTES:
                    self.send_error(413)
                    return
                body = self.rfile.read(content_length) if content_length else b""
                if body:
                    body = relay._rewrite_request_body(self.path, body)
                headers = {
                    key: value
                    for key, value in self.headers.items()
                    if key.lower() not in {
                        "connection", "content-length", "host", "transfer-encoding",
                    }
                }
                request = urllib.request.Request(
                    relay.base_url + (self.path if self.path.startswith("/") else "/" + self.path),
                    data=body if self.command != "GET" else None,
                    headers=headers,
                    method=self.command,
                )
                try:
                    opener = urllib.request.build_opener(relay._RejectRedirects())
                    response = _open_endpoint_request(opener, request)
                except urllib.error.HTTPError as exc:
                    if 300 <= int(exc.code) < 400:
                        exc.close()
                        error = json.dumps({
                            "error": "upstream redirects are refused",
                        }).encode("utf-8")
                        self.send_response(502)
                        self.send_header("Content-Type", "application/json")
                        self.send_header("Content-Length", str(len(error)))
                        self.end_headers()
                        self.wfile.write(error)
                        return
                    response = exc
                except Exception as exc:
                    error = json.dumps({"error": str(exc)}).encode("utf-8")
                    self.send_response(502)
                    self.send_header("Content-Type", "application/json")
                    self.send_header("Content-Length", str(len(error)))
                    self.end_headers()
                    self.wfile.write(error)
                    return
                with response:
                    self.send_response(int(response.status))
                    for key, value in response.headers.items():
                        if key.lower() not in {
                            "connection", "content-length", "transfer-encoding",
                        }:
                            self.send_header(key, value)
                    self.end_headers()
                    while True:
                        chunk = response.read(64 * 1024)
                        if not chunk:
                            break
                        self.wfile.write(chunk)
                        self.wfile.flush()

        self.server = http.server.ThreadingHTTPServer(("127.0.0.1", 0), Handler)
        self.server.daemon_threads = True
        self.thread = threading.Thread(target=self.server.serve_forever, daemon=True)
        self.thread.start()
        return f"http://127.0.0.1:{self.server.server_port}"

    def stop(self):
        if self.server is not None:
            self.server.shutdown()
            self.server.server_close()
        if self.thread is not None:
            self.thread.join(timeout=2)


class _ClaudeEndpointRelay(_CodexEndpointRelay):
    """让 Claude Code 的主流式请求精确使用管理员声明的输出上限。"""

    def __init__(
            self, base_url, max_output_tokens, endpoint_thinking_format=None,
            thinking_enabled=True, upstream_model=None):
        super().__init__(
            base_url,
            max_output_tokens=max_output_tokens,
            thinking_compatibility=thinking_enabled,
            upstream_model=upstream_model,
            endpoint_thinking_format=endpoint_thinking_format,
        )

    def _rewrite_request_body(self, path, body):
        return _rewrite_claude_request_body(
            path, body, self.max_output_tokens,
            self.endpoint_thinking_format,
            self.thinking_compatibility,
            self.upstream_model,
        )


class _EndpointThinkingRelay(_CodexEndpointRelay):
    """为任意 harness 注入统一端点契约中的协议级思考字段。"""

    def __init__(self, base_url, protocol, endpoint_thinking_format, thinking_enabled):
        super().__init__(
            base_url,
            max_output_tokens=DEFAULT_MAX_OUTPUT_TOKENS,
            thinking_compatibility=thinking_enabled,
            endpoint_thinking_format=endpoint_thinking_format,
        )
        self.protocol = protocol

    def _rewrite_request_body(self, path, body):
        try:
            payload = json.loads(body.decode("utf-8"))
        except Exception:
            return body
        if not isinstance(payload, dict):
            return body
        normalized_path = str(path or "").split("?", 1)[0].rstrip("/")
        expected_suffix = "/messages" if self.protocol == "anthropic" else "/chat/completions"
        if not normalized_path.endswith(expected_suffix):
            return body
        _apply_endpoint_thinking_fields(
            payload,
            protocol=self.protocol,
            thinking_format=self.endpoint_thinking_format,
            thinking_enabled=self.thinking_compatibility,
        )
        return json.dumps(payload, ensure_ascii=False, separators=(",", ":")).encode("utf-8")


def _audit_read_only_enabled():
    return (os.environ.get("AJ_AUDIT_READ_ONLY") or "").strip().lower() in {
        "1", "true", "yes", "on",
    }


def _endpoint_settings(allowed_protocols):
    """读取四套 harness 共用的唯一端点接口。"""

    protocol = (os.environ.get("AJ_ENDPOINT_PROTOCOL") or "").strip().lower()
    base_url = (os.environ.get("AJ_ENDPOINT_BASE_URL") or "").strip()
    api_key = (os.environ.get("AJ_ENDPOINT_API_KEY") or "").strip()
    model = (os.environ.get("AJ_ENDPOINT_MODEL") or "").strip()
    if protocol not in allowed_protocols:
        raise ValueError("endpoint protocol is not supported by the selected harness")
    if not base_url or not api_key or not model:
        raise ValueError("endpoint Base URL, API Key, and model are required")
    return protocol, base_url, api_key, model


def _run_codex(prompt):
    try:
        resume_session_id = _resume_session_id_from_env("codex")
        _protocol, base_url, api_key, model = _endpoint_settings({"openai"})
        context_window_tokens, max_output_tokens, thinking_compatibility = (
            _endpoint_model_capabilities()
        )
        endpoint_thinking_format = _endpoint_thinking_format_env()
        web_search_mcp = _web_search_mcp_settings()
    except ValueError as exc:
        print(f"invalid endpoint configuration: {exc}", file=sys.stderr)
        return 2
    skill_files = _validated_skill_files("codex")
    if skill_files is None:
        return 2
    try:
        home = _runtime_path("codex", "/workspace/.codex")
    except ValueError as exc:
        print(f"invalid Agent runtime: {exc}", file=sys.stderr)
        return 2
    if endpoint_thinking_format is None:
        relay = _CodexEndpointRelay(
            base_url, max_output_tokens, thinking_compatibility,
            upstream_model=model,
        )
    else:
        relay = _CodexEndpointRelay(
            base_url, max_output_tokens, thinking_compatibility,
            upstream_model=model,
            endpoint_thinking_format=endpoint_thinking_format,
        )
    try:
        relay_base_url = relay.start()
        _write_codex_config(
            home, relay_base_url, model,
            context_window_tokens=context_window_tokens,
            max_output_tokens=max_output_tokens,
            thinking_compatibility=thinking_compatibility,
            web_search_mcp=web_search_mcp,
        )
        env = os.environ.copy()
        env["CODEX_HOME"] = home
        audit_read_only = _audit_read_only_enabled()
        if resume_session_id and not audit_read_only:
            args = [
                "codex", "exec", "resume",
                "--json",
                "--skip-git-repo-check",
                "--dangerously-bypass-approvals-and-sandbox",
                resume_session_id,
                "-",
            ]
        elif audit_read_only:
            args = [
                "codex", "exec",
                "--json",
                "--skip-git-repo-check",
                "--sandbox", "read-only",
                "--cd", "/workspace",
                "-",
            ]
            resume_session_id = ""
        else:
            args = [
                "codex", "exec",
                "--json",
                "--skip-git-repo-check",
                "--dangerously-bypass-approvals-and-sandbox",
                "--cd", "/workspace",
                "-",
            ]
        proc = _run(args, env, input_text=prompt)
        _record_session("codex", proc, resume_session_id)
        return proc.returncode
    finally:
        relay.stop()


def _opencode_config_content(
        base_url, api_key_env, model_id, audit_read_only=False,
        context_window_tokens=None, max_output_tokens=None,
        thinking_compatibility=None, web_search_mcp=None):
    if context_window_tokens is None:
        context_window_tokens = DEFAULT_CONTEXT_WINDOW_TOKENS
    if max_output_tokens is None:
        max_output_tokens = DEFAULT_MAX_OUTPUT_TOKENS
    if thinking_compatibility is None:
        thinking_compatibility = DEFAULT_THINKING_COMPATIBILITY
    cfg = {
        "$schema": "https://opencode.ai/config.json",
        "provider": {
            OPENCODE_PROVIDER_ID: {
                "npm": "@ai-sdk/openai-compatible",
                "name": "Agent endpoint",
                "options": {
                    "baseURL": base_url,
                    "apiKey": "{env:%s}" % api_key_env,
                },
                "models": {
                    model_id: {
                        "name": model_id,
                        "reasoning": bool(thinking_compatibility),
                        "limit": {
                            "context": int(context_window_tokens),
                            "output": int(max_output_tokens),
                        },
                    },
                },
            },
        },
    }
    if audit_read_only:
        cfg["permission"] = {
            "*": "deny",
            "read": "allow",
            "glob": "allow",
            "grep": "allow",
            "external_directory": {"/evidence/**": "allow"},
        }
    if web_search_mcp:
        cfg["mcp"] = {
            WEB_SEARCH_MCP_NAME: {
                "type": "remote",
                "url": web_search_mcp["url"],
                "headers": {
                    "Authorization": "{env:AJ_WEB_SEARCH_MCP_AUTHORIZATION}",
                },
                "oauth": False,
                "timeout": web_search_mcp["timeout_ms"],
            },
        }
    return json.dumps(cfg, ensure_ascii=False)


def _run_opencode(prompt):
    try:
        resume_session_id = _resume_session_id_from_env("opencode")
        _protocol, base_url, api_key, model = _endpoint_settings({"openai"})
        context_window_tokens, max_output_tokens, thinking_compatibility = (
            _endpoint_model_capabilities()
        )
        endpoint_thinking_format = _endpoint_thinking_format_env()
        web_search_mcp = _web_search_mcp_settings()
    except ValueError as exc:
        print(f"invalid endpoint configuration: {exc}", file=sys.stderr)
        return 2
    model_id = model
    skill_files = _validated_skill_files("opencode")
    if skill_files is None:
        return 2
    audit_read_only = _audit_read_only_enabled()
    try:
        runtime_root = _runtime_root()
    except ValueError as exc:
        print(f"invalid Agent runtime: {exc}", file=sys.stderr)
        return 2
    if runtime_root:
        opencode_root = os.path.join(runtime_root, "opencode")
        home = os.path.join(opencode_root, "home")
        xdg_directories = {
            "XDG_CONFIG_HOME": os.path.join(opencode_root, "config"),
            "XDG_DATA_HOME": os.path.join(opencode_root, "data"),
            "XDG_STATE_HOME": os.path.join(opencode_root, "state"),
            "XDG_CACHE_HOME": os.path.join(opencode_root, "cache"),
        }
    else:
        home = "/tmp/aj_opencode_home"
        xdg_directories = {}
    relay = None
    provider_base_url = base_url
    if endpoint_thinking_format is not None:
        relay = _EndpointThinkingRelay(
            base_url,
            "openai",
            endpoint_thinking_format,
            thinking_compatibility,
        )
        try:
            provider_base_url = relay.start()
        except Exception as exc:
            print(f"failed to start OpenCode endpoint relay: {exc}", file=sys.stderr)
            return 2
    try:
        env = os.environ.copy()
        env["HOME"] = home
        env.update(xdg_directories)
        env["OPENCODE_CONFIG_CONTENT"] = _opencode_config_content(
            provider_base_url, "AJ_ENDPOINT_API_KEY", model_id,
            audit_read_only=audit_read_only,
            context_window_tokens=context_window_tokens,
            max_output_tokens=max_output_tokens,
            thinking_compatibility=thinking_compatibility,
            web_search_mcp=web_search_mcp,
        )
        # OpenCode 默认把单次输出再截到 32K；端点池中的管理员配置才是这里的
        # 唯一上限，因此同步覆盖该运行时保护值。
        env["OPENCODE_EXPERIMENTAL_OUTPUT_TOKEN_MAX"] = str(max_output_tokens)
        if audit_read_only:
            env.update({
                "OPENCODE_DISABLE_DEFAULT_PLUGINS": "true",
                "OPENCODE_DISABLE_CLAUDE_CODE": "true",
                "OPENCODE_DISABLE_AUTOUPDATE": "true",
                "OPENCODE_DISABLE_LSP_DOWNLOAD": "true",
                "OPENCODE_DISABLE_MODELS_FETCH": "true",
            })
        for directory in (home, *xdg_directories.values()):
            os.makedirs(directory, exist_ok=True)
        if audit_read_only:
            args = [
                "opencode", "--pure", "run",
                "--format", "json",
                "--model", "%s/%s" % (OPENCODE_PROVIDER_ID, model_id),
            ]
            resume_session_id = ""
        else:
            args = [
                "opencode", "run",
                "--format", "json",
                "--dangerously-skip-permissions",
                "--model", "%s/%s" % (OPENCODE_PROVIDER_ID, model_id),
            ]
        if resume_session_id and not audit_read_only:
            args.extend(["--session", resume_session_id])
        args.append(prompt)
        proc = _run(args, env)
        _record_session("opencode", proc, resume_session_id)
        return proc.returncode
    finally:
        if relay is not None:
            relay.stop()


def _positive_int_env(name, default):
    raw = str(os.environ.get(name) or "").strip()
    if not raw:
        return default
    try:
        value = int(raw)
    except (TypeError, ValueError):
        raise ValueError(f"{name} must be a positive integer")
    if value <= 0:
        raise ValueError(f"{name} must be a positive integer")
    return value


def _bool_env(name, default):
    raw = str(os.environ.get(name) or "").strip().lower()
    if not raw:
        return bool(default)
    if raw in {"1", "true", "yes", "on"}:
        return True
    if raw in {"0", "false", "no", "off"}:
        return False
    raise ValueError(f"{name} must be a boolean")


def _endpoint_thinking_format_env():
    raw = str(os.environ.get("AJ_ENDPOINT_THINKING_FORMAT") or "").strip().lower()
    if not raw:
        return None
    if raw not in ENDPOINT_THINKING_FORMATS:
        raise ValueError("AJ_ENDPOINT_THINKING_FORMAT has an unsupported value")
    return raw


def _endpoint_model_capabilities():
    context_window_tokens = _positive_int_env(
        "AJ_ENDPOINT_CONTEXT_WINDOW_TOKENS", DEFAULT_CONTEXT_WINDOW_TOKENS,
    )
    max_output_tokens = _positive_int_env(
        "AJ_ENDPOINT_MAX_OUTPUT_TOKENS", DEFAULT_MAX_OUTPUT_TOKENS,
    )
    if context_window_tokens > MAX_CONTEXT_WINDOW_TOKENS:
        raise ValueError(
            "AJ_ENDPOINT_CONTEXT_WINDOW_TOKENS cannot exceed "
            f"{MAX_CONTEXT_WINDOW_TOKENS}"
        )
    if max_output_tokens > context_window_tokens:
        raise ValueError(
            "AJ_ENDPOINT_MAX_OUTPUT_TOKENS cannot exceed "
            "AJ_ENDPOINT_CONTEXT_WINDOW_TOKENS"
        )
    return (
        context_window_tokens,
        max_output_tokens,
        _bool_env("AJ_ENDPOINT_THINKING_ENABLED", DEFAULT_THINKING_COMPATIBILITY),
    )


def _write_pi_models_config(
        config_dir, base_url, model, context_window_tokens=None,
        max_output_tokens=None, thinking_compatibility=None,
        protocol="openai"):
    os.makedirs(config_dir, exist_ok=True)
    if context_window_tokens is None:
        context_window_tokens = DEFAULT_CONTEXT_WINDOW_TOKENS
    if max_output_tokens is None:
        max_output_tokens = DEFAULT_MAX_OUTPUT_TOKENS
    if thinking_compatibility is None:
        thinking_compatibility = DEFAULT_THINKING_COMPATIBILITY
    model_config = {
        "id": model,
        "name": model,
        "contextWindow": int(context_window_tokens),
        "maxTokens": int(max_output_tokens),
    }
    if thinking_compatibility:
        model_config.update({
            "reasoning": True,
            "input": ["text"],
        })
    protocol = str(protocol or "openai").strip().lower()
    if protocol not in {"openai", "anthropic"}:
        raise ValueError("unsupported Pi endpoint protocol")
    provider = {
        "baseUrl": base_url,
        "api": (
            "anthropic-messages" if protocol == "anthropic"
            else "openai-completions"
        ),
        "apiKey": "$AJ_ENDPOINT_API_KEY",
        "models": [model_config],
    }
    if protocol == "openai":
        provider.update({
            "authHeader": True,
            "compat": {
                "supportsStore": False,
                "supportsDeveloperRole": False,
                "maxTokensField": "max_tokens",
            },
        })
    config = {
        "providers": {
            PI_PROVIDER_NAME: provider,
        },
    }
    with open(os.path.join(config_dir, "models.json"), "w", encoding="utf-8") as f:
        json.dump(config, f, ensure_ascii=False)


