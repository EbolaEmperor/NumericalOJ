{
  "name": "numericaloj-frontend",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.23.2"
  },
  "volta": {
    "node": "22.23.2"
  },
  "scripts": {
    "build": "tsc -b && vite build",
    "build:frontend": "npm run build:legacy-assets && npm run build",
    "build:legacy-assets": "npm run build:monaco && npm run build:markdown-highlighter && npm run build:mermaid",
    "build:markdown-highlighter": "node scripts/build_markdown_code_highlighter.mjs",
    "build:mermaid": "node scripts/build_mermaid.mjs",
    "build:monaco": "node scripts/build_monaco.mjs",
    "build:precompress": "node scripts/precompress_static.mjs",
    "dev": "vite",
    "test": "vitest run && node --test tests/*.test.cjs",
    "test:frontend": "npm run test",
    "typecheck": "tsc -b --pretty false"
  },
  "devDependencies": {
    "@leanprover/unicode-input": "0.1.12",
    "@shikijs/monaco": "4.3.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "esbuild": "0.28.2",
    "jsdom": "29.1.1",
    "mermaid": "11.16.0",
    "monaco-editor": "0.56.0",
    "shiki": "4.3.1",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  },
  "overrides": {
    "dompurify": "3.4.12"
  },
  "dependencies": {
    "@tanstack/react-query": "5.102.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.3"
  }
}
