__pycache__/
*.pyc
*.pyo
.pytest_cache/
.cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.venv/
.deploy/

# ===== Superpowers 产物（设计/计划/参考文档，非交付物，不入库）=====
docs/superpowers/

# ===== 生成式 Wiki 产物（源配置保留在 .wiki/）=====
deepwiki/

# ===== CI 测试运行产物 =====
test-results/

# ===== 本地配置 / 运行时目录 =====
.env
# 旧版生产覆盖文件已不再加载；继续忽略，避免迁移期间遗留密钥被误提交。
config_local.py
backups/
user_libraries/
# 用户与课程共享头文件仓库；生产内容独立持久化，不随代码发布覆盖。
library/
tmp/
uploads/
# 统一结构化日志、轮转文件、采集器 socket 与状态文件均为运行时数据。
/logs/
# 判题运行目录（JUDGER_RUN_ROOT 默认 <OJ_ROOT>/judger）：每次评测的 eoj-* 子目录是
# 临时产物，不入库；judger/ 下手动维护的文件（如 baltaTest.md）照常跟踪。
judger/*
ranking_uploads/*
