# 字符串使用 JSON 双引号，布尔值使用 true/false，列表使用 JSON 数组。

# Web / 会话 / 邮件
SECRET_KEY=""
FLASK_DEBUG=false
SESSION_COOKIE_SECURE=false
CONTENT_SECURITY_POLICY=""
CSRF_TRUSTED_ORIGINS=[]
MAIL_SERVER="YOUR SMTP SERVER ADDRESS"
